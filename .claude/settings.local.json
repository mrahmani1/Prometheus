{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(python:*)",
      "Bash(for file in *.py)",
      "Bash(do echo \"Checking $file:\")",
      "Bash(echo:*)",
      "Bash(done)",
      "Bash(grep:*)",
      "Bash(pip install black isort flake8)",
      "Bash(black:*)",
      "Bash(isort:*)",
      "Bash(flake8:*)",
      "Bash(pip install:*)",
      "Bash(set PYTHONIOENCODING=utf-8)",
      "Bash(find:*)",
      "Bash(ls:*)",
      "Bash(az:*)",
      "Bash(powershell:*)",
      "Bash(winget install:*)",
      "Bash(choco install:*)"
    ],
    "deny": []
  }
}