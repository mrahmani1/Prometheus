# Development Environment Configuration
# Points to local development servers with real data connections

# Main API Configuration
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_DATABASE_API_URL=http://localhost:8000/api/v1/database

# WebSocket Endpoints
VITE_WS_URL=ws://localhost:8000
VITE_IRIS_WS_URL=ws://localhost:8000/ws/iris
VITE_GEOLOGICAL_WS_URL=ws://localhost:8000/ws/geological
VITE_PROCESS_WS_URL=ws://localhost:8000/ws/process
VITE_MONITORING_WS_URL=ws://localhost:8000/ws/monitoring

# Real Geological Data Sources (same as production)
VITE_IRIS_API_URL=https://service.iris.edu
VITE_USGS_API_URL=https://earthquake.usgs.gov
VITE_NASA_API_URL=https://firms.modaps.eosdis.nasa.gov
VITE_COPERNICUS_API_URL=https://scihub.copernicus.eu
VITE_ASF_HYP3_API_URL=https://hyp3-api.asf.alaska.edu
VITE_EARTHCHEM_API_URL=https://www.earthchem.org

# Academic API Sources (same as production)
VITE_SEMANTIC_SCHOLAR_API_URL=https://api.semanticscholar.org/graph/v1
VITE_CONNECTED_PAPERS_API_URL=https://api.connectedpapers.com/v2
VITE_WILEY_API_URL=https://api.wiley.com/onlinelibrary/tdm/v1
VITE_GEOSCIENCE_WORLD_API_URL=https://api.geoscienceworld.org/v1

# Local Database Configuration
VITE_POSTGRESQL_HOST=localhost
VITE_POSTGRESQL_PORT=5432
VITE_POSTGRESQL_DATABASE=prometheus_geological_dev
VITE_POSTGRESQL_SSL=false

VITE_INFLUXDB_HOST=localhost
VITE_INFLUXDB_PORT=8086
VITE_INFLUXDB_DATABASE=geological_timeseries_dev
VITE_INFLUXDB_SSL=false

VITE_REDIS_HOST=localhost
VITE_REDIS_PORT=6379
VITE_REDIS_SSL=false

VITE_NEO4J_HOST=localhost
VITE_NEO4J_PORT=7687
VITE_NEO4J_DATABASE=causal_relationships_dev
VITE_NEO4J_SSL=false

VITE_TIMESCALEDB_HOST=localhost
VITE_TIMESCALEDB_PORT=5433
VITE_TIMESCALEDB_DATABASE=geological_timeseries_dev
VITE_TIMESCALEDB_SSL=false

# Mapbox Configuration (development token)
VITE_MAPBOX_ACCESS_TOKEN=pk.eyJ1IjoicHJvbWV0aGV1cy1haSIsImEiOiJjbHNkZjEyM3MwMDFhMmxwYzNkZjEyM3MifQ.development

# Authentication (development)
VITE_AUTH_DOMAIN=dev-auth.prometheus-ai.platform
VITE_AUTH_CLIENT_ID=prometheus_ai_frontend_dev
VITE_AUTH_AUDIENCE=http://localhost:8000

# Feature Flags (all enabled for development)
VITE_ENABLE_REAL_TIME_MONITORING=true
VITE_ENABLE_ACADEMIC_INTEGRATION=true
VITE_ENABLE_CAUSAL_ANALYSIS=true
VITE_ENABLE_MT_SAR_PROCESSING=true
VITE_ENABLE_LITERATURE_VALIDATION=true
VITE_ENABLE_DEBUG_MODE=true

# Performance Configuration (more lenient for development)
VITE_API_TIMEOUT=60000
VITE_WS_RECONNECT_INTERVAL=3000
VITE_CACHE_TTL=1800
VITE_MAX_CONCURRENT_REQUESTS=5

# Development Tools
VITE_ENABLE_REDUX_DEVTOOLS=true
VITE_ENABLE_REACT_QUERY_DEVTOOLS=true
VITE_LOG_LEVEL=debug