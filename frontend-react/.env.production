# Production Environment Configuration
# Real API endpoints and database connections

# Main API Configuration
VITE_API_BASE_URL=https://api.prometheus-ai.platform/api/v1
VITE_DATABASE_API_URL=https://api.prometheus-ai.platform/api/v1/database

# WebSocket Endpoints
VITE_WS_URL=wss://api.prometheus-ai.platform
VITE_IRIS_WS_URL=wss://api.prometheus-ai.platform/ws/iris
VITE_GEOLOGICAL_WS_URL=wss://api.prometheus-ai.platform/ws/geological
VITE_PROCESS_WS_URL=wss://api.prometheus-ai.platform/ws/process
VITE_MONITORING_WS_URL=wss://api.prometheus-ai.platform/ws/monitoring

# Real Geological Data Sources
VITE_IRIS_API_URL=https://service.iris.edu
VITE_USGS_API_URL=https://earthquake.usgs.gov
VITE_NASA_API_URL=https://firms.modaps.eosdis.nasa.gov
VITE_COPERNICUS_API_URL=https://scihub.copernicus.eu
VITE_ASF_HYP3_API_URL=https://hyp3-api.asf.alaska.edu
VITE_EARTHCHEM_API_URL=https://www.earthchem.org

# Academic API Sources
VITE_SEMANTIC_SCHOLAR_API_URL=https://api.semanticscholar.org/graph/v1
VITE_CONNECTED_PAPERS_API_URL=https://api.connectedpapers.com/v2
VITE_WILEY_API_URL=https://api.wiley.com/onlinelibrary/tdm/v1
VITE_GEOSCIENCE_WORLD_API_URL=https://api.geoscienceworld.org/v1

# Database Configuration
VITE_POSTGRESQL_HOST=postgresql.prometheus-ai.platform
VITE_POSTGRESQL_PORT=5432
VITE_POSTGRESQL_DATABASE=prometheus_geological
VITE_POSTGRESQL_SSL=true

VITE_INFLUXDB_HOST=influxdb.prometheus-ai.platform
VITE_INFLUXDB_PORT=8086
VITE_INFLUXDB_DATABASE=geological_timeseries
VITE_INFLUXDB_SSL=true

VITE_REDIS_HOST=redis.prometheus-ai.platform
VITE_REDIS_PORT=6379
VITE_REDIS_SSL=true

VITE_NEO4J_HOST=neo4j.prometheus-ai.platform
VITE_NEO4J_PORT=7687
VITE_NEO4J_DATABASE=causal_relationships
VITE_NEO4J_SSL=true

VITE_TIMESCALEDB_HOST=timescaledb.prometheus-ai.platform
VITE_TIMESCALEDB_PORT=5432
VITE_TIMESCALEDB_DATABASE=geological_timeseries
VITE_TIMESCALEDB_SSL=true

# Google Maps Configuration (production)
VITE_GOOGLE_MAPS_API_KEY=AIzaSyProductionKeyForPrometheusAI
VITE_GOOGLE_MAPS_MAP_ID=prometheus-ai-prod-map

# Mapbox Configuration - Legacy support
VITE_MAPBOX_ACCESS_TOKEN=pk.eyJ1IjoicHJvbWV0aGV1cy1haSIsImEiOiJjbHNkZjEyM3MwMDFhMmxwYzNkZjEyM3MifQ.example

# Authentication
VITE_AUTH_DOMAIN=auth.prometheus-ai.platform
VITE_AUTH_CLIENT_ID=prometheus_ai_frontend
VITE_AUTH_AUDIENCE=https://api.prometheus-ai.platform

# Feature Flags
VITE_ENABLE_REAL_TIME_MONITORING=true
VITE_ENABLE_ACADEMIC_INTEGRATION=true
VITE_ENABLE_CAUSAL_ANALYSIS=true
VITE_ENABLE_MT_SAR_PROCESSING=true
VITE_ENABLE_LITERATURE_VALIDATION=true

# Performance Configuration
VITE_API_TIMEOUT=30000
VITE_WS_RECONNECT_INTERVAL=5000
VITE_CACHE_TTL=3600
VITE_MAX_CONCURRENT_REQUESTS=10

# Monitoring and Analytics
VITE_SENTRY_DSN=https://example@sentry.io/prometheus-ai
VITE_GOOGLE_ANALYTICS_ID=GA-PROMETHEUS-AI
VITE_HOTJAR_ID=prometheus-ai-hotjar

# Development Overrides (commented out for production)
# VITE_API_BASE_URL=http://localhost:8000/api/v1
# VITE_WS_URL=ws://localhost:8000