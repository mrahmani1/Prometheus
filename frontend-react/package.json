{
  "name": "prometheus-ai-frontend",
  "version": "1.0.0",
  "description": "Modern React/TypeScript frontend for Prometheus AI Platform",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest --run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:accessibility": "playwright test tests/e2e/accessibility.spec.ts",
    "test:performance": "playwright test tests/e2e/performance.spec.ts",
    "test:visual": "playwright test --grep 'Visual Regression'",
    "test:all": "npm run test && npm run test:e2e",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint . --ext ts,tsx --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "type-check": "tsc --noEmit",
    "analyze": "vite-bundle-analyzer",
    "lighthouse": "lighthouse http://localhost:5173 --output=json --output-path=./test-results/lighthouse-results/lighthouse-report.json",
    "test:setup": "playwright install",
    "test:report": "playwright show-report"
  },
  "dependencies": {
    "@emotion/cache": "^11.11.0",
    "@emotion/react": "^11.11.1",
    "@emotion/styled": "^11.11.0",
    "@hookform/resolvers": "^3.3.2",
    "@mui/icons-material": "^5.14.18",
    "@mui/lab": "^5.0.0-alpha.170",
    "@mui/material": "^5.14.18",
    "@mui/x-data-grid": "^6.18.1",
    "@mui/x-date-pickers": "^6.18.1",
    "@pixi/react": "^7.1.2",
    "@react-three/drei": "^9.88.13",
    "@react-three/fiber": "^8.15.11",
    "@react-three/xr": "^6.6.26",
    "@reduxjs/toolkit": "^1.9.7",
    "@turf/turf": "^6.5.0",
    "@types/react-grid-layout": "^1.3.5",
    "axios": "^1.6.2",
    "cytoscape": "^3.26.0",
    "cytoscape-cola": "^2.5.1",
    "cytoscape-cose-bilkent": "^4.1.0",
    "cytoscape-dagre": "^2.5.0",
    "d3": "^7.8.5",
    "d3-drag": "^3.0.0",
    "d3-force": "^3.0.0",
    "d3-hierarchy": "^3.1.2",
    "d3-scale": "^4.0.2",
    "d3-selection": "^3.0.0",
    "d3-zoom": "^3.0.0",
    "date-fns": "^2.30.0",
    "geojson": "^0.5.0",
    "i18next": "^23.7.6",
    "i18next-browser-languagedetector": "^7.2.0",
    "lodash-es": "^4.17.21",
    "lucide-react": "^0.544.0",
    "mapbox-gl": "^2.15.0",
    "pixi.js": "^7.3.2",
    "plotly.js": "^2.27.0",
    "proj4": "^2.9.2",
    "react": "^18.2.0",
    "react-cytoscapejs": "^2.0.0",
    "react-dom": "^18.2.0",
    "react-error-boundary": "^4.0.11",
    "react-grid-layout": "^1.4.4",
    "react-helmet-async": "^1.3.0",
    "react-hook-form": "^7.48.2",
    "react-i18next": "^13.5.0",
    "react-map-gl": "^7.1.6",
    "react-plotly.js": "^2.6.0",
    "react-query": "^3.39.3",
    "react-redux": "^8.1.3",
    "react-router-dom": "^6.20.1",
    "recharts": "^3.2.0",
    "redux-persist": "^6.0.0",
    "socket.io-client": "^4.7.4",
    "three": "^0.158.0",
    "workbox-precaching": "^7.0.0",
    "workbox-routing": "^7.0.0",
    "workbox-strategies": "^7.0.0",
    "yup": "^1.3.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.8.2",
    "@playwright/test": "^1.40.0",
    "@storybook/addon-essentials": "^7.6.3",
    "@storybook/addon-interactions": "^7.6.3",
    "@storybook/addon-links": "^7.6.3",
    "@storybook/addon-onboarding": "^1.0.8",
    "@storybook/blocks": "^7.6.3",
    "@storybook/react": "^7.6.3",
    "@storybook/react-vite": "^7.6.3",
    "@storybook/testing-library": "^0.2.2",
    "@testing-library/jest-dom": "^6.1.5",
    "@testing-library/react": "^13.4.0",
    "@testing-library/user-event": "^14.5.1",
    "@types/cytoscape": "^3.19.16",
    "@types/d3": "^7.4.3",
    "@types/geojson": "^7946.0.13",
    "@types/lodash-es": "^4.17.12",
    "@types/plotly.js": "^2.12.29",
    "@types/proj4": "^2.5.5",
    "@types/react": "^18.2.37",
    "@types/react-dom": "^18.2.15",
    "@types/react-plotly.js": "^2.6.3",
    "@types/three": "^0.158.3",
    "@typescript-eslint/eslint-plugin": "^6.13.1",
    "@typescript-eslint/parser": "^6.13.1",
    "@vitejs/plugin-react": "^4.2.0",
    "@vitest/coverage-v8": "^1.0.0",
    "@vitest/ui": "^1.0.0",
    "eslint": "^8.54.0",
    "eslint-plugin-import": "^2.29.0",
    "eslint-plugin-jsx-a11y": "^6.8.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.4",
    "jsdom": "^23.0.1",
    "lighthouse": "^11.4.0",
    "prettier": "^3.1.0",
    "storybook": "^7.6.3",
    "typescript": "^5.2.2",
    "vite": "^5.0.0",
    "vite-bundle-analyzer": "^0.7.0",
    "vite-plugin-pwa": "^0.17.4",
    "vitest": "^1.0.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
