        z = torch.linspace(0, 1, self.domain_size[2])
        t = torch.linspace(0, 1, 100)
        
        X, Y, Z, T = torch.meshgrid(x, y, z, t, indexing='ij')
        coords = torch.stack([X.flatten(), Y.flatten(), Z.flatten(), T.flatten()], dim=1)
        coords = coords.to(self.device)
        
        # Training loop
