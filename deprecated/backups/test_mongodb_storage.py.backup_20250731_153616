        }
        
        total_density = 0
        total_weight = 0
        for oxide, weight in composition.items():
            if oxide in density_components:
                total_density += weight * density_components[oxide]
                total_weight += weight
        
        properties['density_g_cm3'] = total_density / (total_weight + 1e-8)
        
        # Estimate liquidus temperature
