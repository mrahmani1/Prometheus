    async def search_asf_data(self, query: ASFQuery) -> List[Dict[str, Any]]:
        """Search ASF for InSAR data"""
        search_params = {
            "platform": ",".join(query.platform),
            "start": query.start_date.strftime("%Y-%m-%dT%H:%M:%S"),
            "end": query.end_date.strftime("%Y-%m-%dT%H:%M:%S"),
            "bbox": f"{query.bbox[0]},{query.bbox[1]},{query.bbox[2]},{query.bbox[3]}",
            "processingLevel": ",".join(query.processing_level),
            "maxResults": query.max_results,
            "output": "json"
        }
        
        if query.beam_mode:
            search_params["beamMode"] = ",".join(query.beam_mode)
        
        if query.flight_direction:
            search_params["flightDirection"] = query.flight_direction
        
        try:
            async with aiohttp.ClientSession() as session:
                async with session.get(self.asf_search_url, params=search_params) as response:
                    if response.status == 200:
                        data = await response.json()
                        return data.get("results", [])
                    else:
                        logger.error(f"ASF search failed with status {response.status}")
                        return []
        
        except Exception as e:
            logger.error(f"Error searching ASF data: {e}")
            return []
    
    async def download_asf_data(self, granule_urls: List[str], download_dir: str) -> List[str]:
        """Download ASF data granules"""
        downloaded_files = []
        
        if not self.asf_username or not self.asf_password:
            logger.error("ASF credentials not configured")
            return downloaded_files
        
        auth = aiohttp.BasicAuth(self.asf_username, self.asf_password)
        
        async with aiohttp.ClientSession(auth=auth) as session:
            for url in granule_urls:
                try:
                    filename = os.path.basename(url)
                    filepath = os.path.join(download_dir, filename)
                    
                    if os.path.exists(filepath):
                        logger.info(f"File already exists: {filename}")
                        downloaded_files.append(filepath)
                        continue
                    
                    async with session.get(url) as response:
                        if response.status == 200:
                            os.makedirs(download_dir, exist_ok=True)
                            with open(filepath, 'wb') as f:
                                async for chunk in response.content.iter_chunked(8192):
                                    f.write(chunk)
                            
                            downloaded_files.append(filepath)
                            logger.info(f"Downloaded: {filename}")
                        else:
                            logger.error(f"Failed to download {filename}: {response.status}")
                
                except Exception as e:
                    logger.error(f"Error downloading {url}: {e}")
        
        return downloaded_files
    
