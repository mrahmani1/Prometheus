        boundary_mask = (coords[:, 0] == 0) | (coords[:, 0] == 1) | \\
                       (coords[:, 1] == 0) | (coords[:, 1] == 1) | \\
                       (coords[:, 2] == 0) | (coords[:, 2] == 1)
        
        boundary_values = torch.zeros_like(u_pred[boundary_mask, 0])
        return torch.mean((u_pred[boundary_mask, 0] - boundary_values)**2)
