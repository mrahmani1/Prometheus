            total_loss = physics_loss + boundary_loss
            total_loss.backward()
            self.optimizer.step()
            
            if epoch % 100 == 0:
                logger.info(f"Epoch {epoch}, Loss: {total_loss.item():.6f}")
        
        # Generate solution
        with torch.no_grad():
            solution = self.pinn_model(coords).cpu().numpy()
            
        return {
