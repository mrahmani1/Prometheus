class SeismicCNN(nn.Module):
    """
    Convolutional Neural Network for seismic event detection and classification.
    
    Architecture designed for 1D seismic waveform analysis with multiple
    convolutional layers, attention mechanisms, and multi-task outputs.
    """
    
    def __init__(
        self,
        input_length: int = 3000,  # 30 seconds at 100 Hz
        num_channels: int = 3,     # Z, N, E components
        num_classes: int = len(SeismicEventType),
        dropout_rate: float = 0.3,
        use_attention: bool = True
    ):
        super(SeismicCNN, self).__init__()
        
        self.input_length = input_length
        self.num_channels = num_channels
        self.num_classes = num_classes
        self.use_attention = use_attention
        
        # Convolutional layers for feature extraction
        self.conv_layers = nn.ModuleList([
            # First conv block - capture high-frequency details
            nn.Conv1d(num_channels, 32, kernel_size=7, stride=1, padding=3),
            nn.BatchNorm1d(32),
            nn.ReLU(),
            nn.MaxPool1d(kernel_size=2, stride=2),
            
            # Second conv block - intermediate features
            nn.Conv1d(32, 64, kernel_size=5, stride=1, padding=2),
            nn.BatchNorm1d(64),
            nn.ReLU(),
            nn.MaxPool1d(kernel_size=2, stride=2),
            
            # Third conv block - broader patterns
            nn.Conv1d(64, 128, kernel_size=3, stride=1, padding=1),
            nn.BatchNorm1d(128),
            nn.ReLU(),
            nn.MaxPool1d(kernel_size=2, stride=2),
            
            # Fourth conv block - high-level features
            nn.Conv1d(128, 256, kernel_size=3, stride=1, padding=1),
            nn.BatchNorm1d(256),
            nn.ReLU(),
            nn.MaxPool1d(kernel_size=2, stride=2),
        ])
        
        # Attention mechanism
        if self.use_attention:
            self.attention = nn.MultiheadAttention(
                embed_dim=256,
                num_heads=8,
                dropout=dropout_rate,
                batch_first=True
            )
        
        # Calculate the size after convolutions
        self.feature_size = self._calculate_conv_output_size()
        
        # Fully connected layers
        self.fc_layers = nn.Sequential(
            nn.Dropout(dropout_rate),
            nn.Linear(self.feature_size, 512),
            nn.ReLU(),
            nn.Dropout(dropout_rate),
            nn.Linear(512, 256),
            nn.ReLU(),
        )
        
        # Multi-task outputs
        self.event_classifier = nn.Linear(256, num_classes)  # Event type classification
        self.detection_head = nn.Linear(256, 1)              # Binary detection
        self.magnitude_head = nn.Linear(256, 1)              # Magnitude estimation
        self.confidence_head = nn.Linear(256, 1)             # Confidence estimation
        
        # Initialize weights
        self._initialize_weights()
    
    def _calculate_conv_output_size(self) -> int:
        """Calculate the output size after convolutional layers"""
        # Simulate forward pass to get output size
        x = torch.randn(1, self.num_channels, self.input_length)
        
        # Apply conv layers (every 4th layer is pooling)
        for i in range(0, len(self.conv_layers), 4):
            x = self.conv_layers[i](x)      # Conv
            x = self.conv_layers[i+1](x)    # BatchNorm
            x = self.conv_layers[i+2](x)    # ReLU
            x = self.conv_layers[i+3](x)    # MaxPool
        
        return x.shape[1] * x.shape[2]
    
    def _initialize_weights(self):
        """Initialize network weights using Xavier initialization"""
        for module in self.modules():
            if isinstance(module, nn.Conv1d):
                nn.init.xavier_uniform_(module.weight)
                if module.bias is not None:
                    nn.init.zeros_(module.bias)
            elif isinstance(module, nn.Linear):
                nn.init.xavier_uniform_(module.weight)
                nn.init.zeros_(module.bias)
    
    def forward(self, x: torch.Tensor) -> Dict[str, torch.Tensor]:
        """
        Forward pass through the network.
        
        Args:
            x: Input tensor of shape (batch_size, num_channels, sequence_length)
            
        Returns:
            Dictionary containing all model outputs
        """
        batch_size = x.shape[0]
        
        # Apply convolutional layers
        for i in range(0, len(self.conv_layers), 4):
            x = self.conv_layers[i](x)      # Conv
            x = self.conv_layers[i+1](x)    # BatchNorm
            x = self.conv_layers[i+2](x)    # ReLU
            x = self.conv_layers[i+3](x)    # MaxPool
        
        # Apply attention if enabled
        if self.use_attention:
            # Reshape for attention: (batch, seq_len, features)
            x = x.transpose(1, 2)
            x, _ = self.attention(x, x, x)
            x = x.transpose(1, 2)
        
        # Flatten for fully connected layers
        x = x.reshape(batch_size, -1)
        
        # Apply fully connected layers
        features = self.fc_layers(x)
        
        # Multi-task outputs
        outputs = {
            'event_type': self.event_classifier(features),
            'detection': torch.sigmoid(self.detection_head(features)),
            'magnitude': self.magnitude_head(features),
            'confidence': torch.sigmoid(self.confidence_head(features))
        }
        
        return outputs


class SeismicFeatureExtractor:
    """
    Extracts features from seismic waveforms for CNN input and analysis.
    """
    
    def __init__(self, sampling_rate: float = 100.0):
        self.sampling_rate = sampling_rate
    
    def extract_time_domain_features(self, waveform: np.ndarray) -> Dict[str, float]:
        """Extract time-domain features from waveform"""
        features = {}
        
        # Basic statistical features
        features['mean'] = float(np.mean(waveform))
        features['std'] = float(np.std(waveform))
        features['variance'] = float(np.var(waveform))
        features['skewness'] = float(self._calculate_skewness(waveform))
        features['kurtosis'] = float(self._calculate_kurtosis(waveform))
        
        # Amplitude features
        features['max_amplitude'] = float(np.max(np.abs(waveform)))
        features['rms'] = float(np.sqrt(np.mean(waveform**2)))
        features['peak_to_peak'] = float(np.ptp(waveform))
        
        # Energy features
        features['total_energy'] = float(np.sum(waveform**2))
        features['signal_energy'] = float(np.sum(waveform**2) / len(waveform))
        
        # Zero crossing rate
        features['zero_crossing_rate'] = self._calculate_zero_crossing_rate(waveform)
        
        return features
    
    def extract_frequency_domain_features(self, waveform: np.ndarray) -> Dict[str, float]:
        """Extract frequency-domain features using FFT"""
        features = {}
        
        # Compute FFT
        fft = np.fft.fft(waveform)
        freqs = np.fft.fftfreq(len(waveform), 1/self.sampling_rate)
        power_spectrum = np.abs(fft)**2
        
        # Only use positive frequencies
        positive_freqs = freqs[:len(freqs)//2]
        positive_power = power_spectrum[:len(power_spectrum)//2]
        
        # Spectral features
        features['dominant_frequency'] = float(positive_freqs[np.argmax(positive_power)])
        features['spectral_centroid'] = float(np.sum(positive_freqs * positive_power) / np.sum(positive_power))
        features['spectral_bandwidth'] = self._calculate_spectral_bandwidth(positive_freqs, positive_power)
        features['spectral_rolloff'] = self._calculate_spectral_rolloff(positive_freqs, positive_power)
        
        # Frequency band energies
        features['low_freq_energy'] = float(np.sum(positive_power[positive_freqs < 1.0]))
        features['mid_freq_energy'] = float(np.sum(positive_power[(positive_freqs >= 1.0) & (positive_freqs < 10.0)]))
        features['high_freq_energy'] = float(np.sum(positive_power[positive_freqs >= 10.0]))
        
        return features
    
