    def _calculate_skewness(self, data: np.ndarray) -> float:
        """Calculate skewness of data"""
        mean = np.mean(data)
        std = np.std(data)
        if std == 0:
            return 0.0
        return np.mean(((data - mean) / std) ** 3)
    
    def _calculate_kurtosis(self, data: np.ndarray) -> float:
        """Calculate kurtosis of data"""
        mean = np.mean(data)
        std = np.std(data)
        if std == 0:
            return 0.0
        return np.mean(((data - mean) / std) ** 4) - 3
    
    def _calculate_zero_crossing_rate(self, waveform: np.ndarray) -> float:
        """Calculate zero crossing rate"""
        zero_crossings = np.where(np.diff(np.signbit(waveform)))[0]
        return len(zero_crossings) / len(waveform) * self.sampling_rate
    
    def _calculate_spectral_bandwidth(self, freqs: np.ndarray, power: np.ndarray) -> float:
        """Calculate spectral bandwidth"""
        centroid = np.sum(freqs * power) / np.sum(power)
        bandwidth = np.sqrt(np.sum(((freqs - centroid) ** 2) * power) / np.sum(power))
        return float(bandwidth)
    
    def _calculate_spectral_rolloff(self, freqs: np.ndarray, power: np.ndarray, rolloff_percent: float = 0.85) -> float:
        """Calculate spectral rolloff frequency"""
        cumulative_power = np.cumsum(power)
        total_power = cumulative_power[-1]
        rolloff_threshold = rolloff_percent * total_power
        
        rolloff_idx = np.where(cumulative_power >= rolloff_threshold)[0]
        if len(rolloff_idx) > 0:
            return float(freqs[rolloff_idx[0]])
        else:
            return float(freqs[-1])
    
    def _calculate_spectral_entropy(self, spectrogram: np.ndarray) -> float:
        """Calculate spectral entropy"""
        # Normalize spectrogram
        normalized = spectrogram / np.sum(spectrogram)
        normalized = normalized[normalized > 0]  # Remove zeros to avoid log(0)
        
        if len(normalized) == 0:
            return 0.0
        
        entropy = -np.sum(normalized * np.log2(normalized))
        return float(entropy)


class SeismicCNNProcessor:
    """
    Main processor for CNN-based seismic event detection and classification.
    
    Handles real-time processing of seismic data streams, event detection,
    classification, and parameter estimation.
    """
    
    def __init__(
        self,
        model_path: Optional[str] = None,
        sampling_rate: float = 100.0,
        window_length: float = 30.0,  # seconds
        overlap_ratio: float = 0.5,
        detection_threshold: float = 0.5,
        device: str = "cpu"
    ):
        self.sampling_rate = sampling_rate
        self.window_length = window_length
        self.window_samples = int(window_length * sampling_rate)
        self.overlap_samples = int(self.window_samples * overlap_ratio)
        self.detection_threshold = detection_threshold
        self.device = torch.device(device)
        
        # Initialize feature extractor
        self.feature_extractor = SeismicFeatureExtractor(sampling_rate)
        
        # Initialize CNN model
        self.model = SeismicCNN(
            input_length=self.window_samples,
            num_channels=3,  # Z, N, E components
            num_classes=len(SeismicEventType)
        ).to(self.device)
        
        # Load pre-trained model if available
        if model_path and Path(model_path).exists():
            self.load_model(model_path)
        else:
            logger.warning("No pre-trained model loaded. Model needs training before use.")
        
        # Event type mapping
        self.event_types = list(SeismicEventType)
        
        # Processing statistics
        self.processing_stats = {
            'total_windows_processed': 0,
            'events_detected': 0,
            'last_processing_time': None
        }
    
    def load_model(self, model_path: str):
        """Load pre-trained CNN model"""
        try:
            checkpoint = torch.load(model_path, map_location=self.device)
            self.model.load_state_dict(checkpoint['model_state_dict'])
            self.model.eval()
            logger.info(f"Loaded pre-trained model from {model_path}")
        except Exception as e:
            logger.error(f"Failed to load model from {model_path}: {e}")
            raise
    
    def save_model(self, model_path: str, metadata: Optional[Dict] = None):
        """Save trained CNN model"""
        checkpoint = {
            'model_state_dict': self.model.state_dict(),
            'model_config': {
                'input_length': self.window_samples,
                'num_channels': 3,
                'num_classes': len(SeismicEventType)
            },
            'processing_config': {
                'sampling_rate': self.sampling_rate,
                'window_length': self.window_length,
                'detection_threshold': self.detection_threshold
            },
            'metadata': metadata or {}
        }
        
        torch.save(checkpoint, model_path)
        logger.info(f"Saved model to {model_path}")
    
    def process_continuous_data(
        self,
        waveform_data: np.ndarray,
        timestamps: np.ndarray,
        sensor_location: GeologicalLocation,
        sensor_id: str
    ) -> List[SeismicEvent]:
        """
        Process continuous seismic data for event detection.
        
        Args:
            waveform_data: Seismic waveform data (channels x samples)
            timestamps: Timestamp for each sample
            sensor_location: Location of the seismometer
            sensor_id: Unique identifier for the sensor
            
        Returns:
            List of detected seismic events
        """
        detected_events = []
        
        # Ensure we have 3-component data
        if waveform_data.shape[0] != 3:
            logger.warning(f"Expected 3-component data, got {waveform_data.shape[0]} components")
            # Pad or truncate to 3 components
            if waveform_data.shape[0] < 3:
                padding = np.zeros((3 - waveform_data.shape[0], waveform_data.shape[1]))
                waveform_data = np.vstack([waveform_data, padding])
            else:
                waveform_data = waveform_data[:3, :]
        
        # Process data in overlapping windows
        step_size = self.window_samples - self.overlap_samples
        
        for start_idx in range(0, waveform_data.shape[1] - self.window_samples + 1, step_size):
            end_idx = start_idx + self.window_samples
            
            # Extract window
            window_data = waveform_data[:, start_idx:end_idx]
            window_timestamps = timestamps[start_idx:end_idx]
            
            # Process window
            event = self._process_window(
                window_data,
                window_timestamps,
                sensor_location,
                sensor_id
            )
            
            if event is not None:
                detected_events.append(event)
                self.processing_stats['events_detected'] += 1
            
            self.processing_stats['total_windows_processed'] += 1
        
        self.processing_stats['last_processing_time'] = datetime.utcnow()
        
        return detected_events
    
    def _process_window(
        self,
        window_data: np.ndarray,
        timestamps: np.ndarray,
        sensor_location: GeologicalLocation,
        sensor_id: str
    ) -> Optional[SeismicEvent]:
        """Process a single window of seismic data"""
        
        # Preprocess data
        processed_data = self._preprocess_waveform(window_data)
        
        # Convert to tensor
        input_tensor = torch.FloatTensor(processed_data).unsqueeze(0).to(self.device)
        
        # Run inference
        with torch.no_grad():
            outputs = self.model(input_tensor)
        
        # Extract predictions
        detection_prob = outputs['detection'].cpu().numpy()[0, 0]
        confidence = outputs['confidence'].cpu().numpy()[0, 0]
        event_type_probs = torch.softmax(outputs['event_type'], dim=1).cpu().numpy()[0]
        magnitude_est = outputs['magnitude'].cpu().numpy()[0, 0]
        
        # Check if event detected
        if detection_prob < self.detection_threshold:
            return None
        
        # Determine event type
        event_type_idx = np.argmax(event_type_probs)
        event_type = self.event_types[event_type_idx]
        event_type_confidence = event_type_probs[event_type_idx]
        
        # Extract additional features
        features = self._extract_comprehensive_features(window_data)
        
        # Estimate event parameters
        event_time = timestamps[np.argmax(np.max(np.abs(window_data), axis=0))]
        peak_amplitude = float(np.max(np.abs(window_data)))
        duration = self._estimate_event_duration(window_data)
        
        # Create seismic event
        event = SeismicEvent(
            event_id=f"{sensor_id}_{int(event_time.timestamp())}",
            timestamp=event_time,
            location=sensor_location,  # Single station location
            event_type=SeismicEventType(event_type),
            magnitude=float(magnitude_est) if magnitude_est > -2 else None,
            confidence=float(min(detection_prob, confidence, event_type_confidence)),
            duration=duration,
            peak_amplitude=peak_amplitude,
            frequency_content=features.frequency_domain_features,
            waveform_features={
                **features.time_domain_features,
                **features.statistical_features
            },
            detection_metadata={
                'sensor_id': sensor_id,
                'detection_probability': float(detection_prob),
                'event_type_probabilities': {
                    self.event_types[i].value: float(prob) 
                    for i, prob in enumerate(event_type_probs)
                },
                'model_confidence': float(confidence),
                'processing_timestamp': datetime.utcnow().isoformat()
            }
        )
        
        return event
    
    def _preprocess_waveform(self, waveform: np.ndarray) -> np.ndarray:
        """Preprocess waveform data for CNN input"""
        # Remove DC component
        waveform = waveform - np.mean(waveform, axis=1, keepdims=True)
        
        # Normalize each component
        for i in range(waveform.shape[0]):
            std = np.std(waveform[i])
            if std > 0:
                waveform[i] = waveform[i] / std
        
        # Apply bandpass filter (simplified)
        # In a real implementation, you would use scipy.signal for proper filtering
        return waveform
    
    def _extract_comprehensive_features(self, waveform: np.ndarray) -> WaveformFeatures:
        """Extract comprehensive features from waveform"""
        features = WaveformFeatures()
        
        # Process each component and combine
        for i, component in enumerate(['Z', 'N', 'E']):
            component_data = waveform[i, :]
            
            # Time domain features
            time_features = self.feature_extractor.extract_time_domain_features(component_data)
            for key, value in time_features.items():
                features.time_domain_features[f"{component}_{key}"] = value
            
            # Frequency domain features
            freq_features = self.feature_extractor.extract_frequency_domain_features(component_data)
            for key, value in freq_features.items():
                features.frequency_domain_features[f"{component}_{key}"] = value
            
            # Wavelet features
            wavelet_features = self.feature_extractor.extract_wavelet_features(component_data)
            for key, value in wavelet_features.items():
                features.wavelet_features[f"{component}_{key}"] = value
        
        # Combined features across all components
        combined_amplitude = np.sqrt(np.sum(waveform**2, axis=0))
        features.statistical_features.update(
            self.feature_extractor.extract_time_domain_features(combined_amplitude)
        )
        
        return features
    
    def _estimate_event_duration(self, waveform: np.ndarray) -> float:
        """Estimate event duration using energy-based method"""
        # Calculate combined energy envelope
        energy_envelope = np.sqrt(np.sum(waveform**2, axis=0))
        
        # Smooth the envelope
        window_size = max(1, len(energy_envelope) // 50)
        smoothed = np.convolve(energy_envelope, np.ones(window_size)/window_size, mode='same')
        
        # Find start and end of significant energy
        threshold = 0.1 * np.max(smoothed)
        above_threshold = smoothed > threshold
        
        if not np.any(above_threshold):
            return 0.0
        
        start_idx = np.where(above_threshold)[0][0]
        end_idx = np.where(above_threshold)[0][-1]
        
        duration = (end_idx - start_idx) / self.sampling_rate
        return float(duration)
    
    def estimate_location(
        self,
        events: List[SeismicEvent],
        sensor_locations: Dict[str, GeologicalLocation]
    ) -> List[SeismicEvent]:
        """
        Estimate event locations using multiple sensor detections.
        
        This is a simplified implementation. A full implementation would
        use proper seismic location algorithms.
        """
        # Group events by time (within 30 seconds)
        time_groups = []
        for event in events:
            placed = False
            for group in time_groups:
                if any(abs((event.timestamp - e.timestamp).total_seconds()) < 30 for e in group):
                    group.append(event)
                    placed = True
                    break
            if not placed:
                time_groups.append([event])
        
        # Process each group
        located_events = []
        for group in time_groups:
            if len(group) >= 3:  # Need at least 3 stations for location
                # Simple centroid location (placeholder)
                lats = [sensor_locations[e.detection_metadata['sensor_id']].latitude for e in group]
                lons = [sensor_locations[e.detection_metadata['sensor_id']].longitude for e in group]
                
                centroid_location = GeologicalLocation(
                    latitude=np.mean(lats),
                    longitude=np.mean(lons),
                    elevation=0.0
                )
                
                # Update all events in group with estimated location
                for event in group:
                    event.location = centroid_location
                    event.detection_metadata['location_method'] = 'centroid'
                    event.detection_metadata['num_stations'] = len(group)
            
            located_events.extend(group)
        
        return located_events
    
    def get_processing_statistics(self) -> Dict[str, Any]:
        """Get processing statistics"""
        return {
            **self.processing_stats,
            'detection_threshold': self.detection_threshold,
            'sampling_rate': self.sampling_rate,
            'window_length': self.window_length,
            'model_device': str(self.device)
        }
    
    def update_detection_threshold(self, new_threshold: float):
        """Update detection threshold"""
        if not 0 <= new_threshold <= 1:
            raise ValueError(f"Threshold must be between 0 and 1, got {new_threshold}")
        
        self.detection_threshold = new_threshold
        logger.info(f"Updated detection threshold to {new_threshold}")


class SeismicEventClassifier:
    """
    Specialized classifier for different types of seismic events.
    
    Provides additional classification capabilities beyond the main CNN,
    including volcanic-specific event types and uncertainty quantification.
    """
    
    def __init__(self):
        self.volcanic_event_types = [
            SeismicEventType.VOLCANIC_EARTHQUAKE,
            SeismicEventType.LONG_PERIOD,
            SeismicEventType.VERY_LONG_PERIOD,
            SeismicEventType.TREMOR,
            SeismicEventType.EXPLOSION
        ]
    
    def classify_volcanic_events(
        self,
        events: List[SeismicEvent]
    ) -> List[SeismicEvent]:
        """
        Refine classification for volcanic events using domain knowledge.
        """
        classified_events = []
        
        for event in events:
            # Apply volcanic-specific classification rules
            refined_event = self._apply_volcanic_classification_rules(event)
            classified_events.append(refined_event)
        
        return classified_events
    
    def _apply_volcanic_classification_rules(self, event: SeismicEvent) -> SeismicEvent:
        """Apply domain-specific rules for volcanic event classification"""
        
        # Get frequency characteristics
        dominant_freq = event.frequency_content.get('Z_dominant_frequency', 0)
        duration = event.duration or 0
        
        # Classification rules based on volcanic seismology
        if dominant_freq < 1.0 and duration > 60:
            # Very long period events
            event.event_type = SeismicEventType.VERY_LONG_PERIOD
            event.detection_metadata['classification_rule'] = 'low_freq_long_duration'
        
        elif 1.0 <= dominant_freq < 5.0 and duration > 10:
            # Long period events
            event.event_type = SeismicEventType.LONG_PERIOD
            event.detection_metadata['classification_rule'] = 'intermediate_freq_duration'
        
        elif duration > 300:  # 5 minutes
            # Tremor
            event.event_type = SeismicEventType.TREMOR
            event.detection_metadata['classification_rule'] = 'very_long_duration'
        
        elif dominant_freq > 10.0 and duration < 5:
            # High frequency, short duration - possible explosion
            event.event_type = SeismicEventType.EXPLOSION
            event.detection_metadata['classification_rule'] = 'high_freq_short_duration'
        
        return event


