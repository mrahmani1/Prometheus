@dataclass
class SeismicEvent:
    """
    Detected seismic event with parameters.
    
    Attributes:
        event_id: Unique identifier for the event
        timestamp: Event origin time
        location: Event location (if determined)
        event_type: Type of seismic event
        magnitude: Event magnitude (if estimated)
        depth: Event depth in kilometers
        confidence: Detection confidence (0-1)
        duration: Event duration in seconds
        peak_amplitude: Peak amplitude in counts or physical units
        frequency_content: Dominant frequency characteristics
        waveform_features: Extracted waveform features
        detection_metadata: Additional detection information
    """
    event_id: str
    timestamp: datetime
    location: Optional[GeologicalLocation]
    event_type: SeismicEventType
    magnitude: Optional[float] = None
    depth: Optional[float] = None
    confidence: float = 0.0
    duration: Optional[float] = None
    peak_amplitude: Optional[float] = None
    frequency_content: Dict[str, float] = field(default_factory=dict)
    waveform_features: Dict[str, float] = field(default_factory=dict)
    detection_metadata: Dict[str, Any] = field(default_factory=dict)
    
    def __post_init__(self):
        """Validate seismic event parameters"""
        if not 0 <= self.confidence <= 1:
            raise ValueError(f"Confidence must be between 0 and 1, got {self.confidence}")
        
        if self.magnitude is not None and self.magnitude < -2:
            logger.warning(f"Unusually small magnitude: {self.magnitude}")
        
        if self.depth is not None and self.depth < 0:
            raise ValueError(f"Depth cannot be negative, got {self.depth}")


