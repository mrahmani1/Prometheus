{
  "hooks": {
    "smart_test_execution": {
      "enabled": true,
      "name": "Smart Test Execution",
      "description": "Intelligently selects and executes tests based on code changes",
      "triggers": ["file_change", "code_commit"],
      "conditions": {
        "min_files_changed": 1,
        "max_files_changed": 50,
        "exclude_patterns": [
          "**/*.md",
          "**/*.txt",
          "**/docs/**",
          "**/*.json",
          "**/*.yml",
          "**/*.yaml"
        ],
        "include_patterns": [
          "**/*.py",
          "**/*.js",
          "**/*.ts"
        ]
      },
      "actions": [
        "smart_test_selection",
        "execute_selected_tests"
      ],
      "priority": "high",
      "timeout": 1800,
      "retry_attempts": 2,
      "parallel_execution": false
    },
    "model_retraining_trigger": {
      "enabled": true,
      "name": "Intelligent Model Retraining",
      "description": "Automatically triggers model retraining based on performance degradation",
      "triggers": ["performance_degradation", "scheduled", "model_update"],
      "conditions": {
        "performance_threshold": 0.05,
        "physics_compliance_threshold": 0.10,
        "prediction_drift_threshold": 0.15,
        "data_staleness_days": 7,
        "model_age_days": 30,
        "schedule": "0 2 * * *",
        "cooldown_hours": 6
      },
      "actions": [
        "analyze_model_performance",
        "trigger_retraining"
      ],
      "priority": "medium",
      "timeout": 7200,
      "retry_attempts": 1,
      "parallel_execution": true
    },
    "intelligent_resource_scaling": {
      "enabled": true,
      "name": "Intelligent Resource Scaling",
      "description": "Automatically scales resources based on workload patterns and performance metrics",
      "triggers": ["resource_threshold", "scheduled", "performance_degradation"],
      "conditions": {
        "cpu_threshold": 80.0,
        "memory_threshold": 85.0,
        "queue_length_threshold": 100,
        "response_time_threshold": 5.0,
        "error_rate_threshold": 0.05,
        "schedule": "*/5 * * * *",
        "cooldown_minutes": 5
      },
      "actions": [
        "analyze_resource_usage",
        "scale_resources"
      ],
      "priority": "high",
      "timeout": 300,
      "retry_attempts": 2,
      "parallel_execution": true
    },
    "code_quality_enforcement": {
      "enabled": true,
      "name": "Automated Code Quality Enforcement",
      "description": "Enforces code quality standards and security requirements",
      "triggers": ["code_commit", "file_change"],
      "conditions": {
        "quality_threshold": 7.0,
        "security_scan": true,
        "max_high_severity_vulns": 0,
        "min_test_coverage": 0.80,
        "include_patterns": [
          "**/*.py",
          "**/*.js",
          "**/*.ts"
        ]
      },
      "actions": [
        "run_quality_checks",
        "enforce_quality_gates"
      ],
      "priority": "high",
      "timeout": 600,
      "retry_attempts": 1,
      "parallel_execution": false
    },
    "continuous_model_validation": {
      "enabled": true,
      "name": "Continuous Model Validation",
      "description": "Continuously validates AI models against scientific benchmarks",
      "triggers": ["model_update", "scheduled", "file_change"],
      "conditions": {
        "model_accuracy_threshold": 0.80,
        "physics_compliance_threshold": 0.70,
        "schedule": "0 */6 * * *",
        "include_patterns": [
          "**/models/**/*.py",
          "**/helios-core/**/*.py",
          "**/volcano-watchtower/**/*.py"
        ]
      },
      "actions": [
        "validate_models_against_benchmarks",
        "update_model_performance_metrics"
      ],
      "priority": "medium",
      "timeout": 3600,
      "retry_attempts": 1,
      "parallel_execution": true
    },
    "intelligent_deployment_orchestration": {
      "enabled": true,
      "name": "Intelligent Deployment Orchestration",
      "description": "Orchestrates deployments with intelligent rollback and health monitoring",
      "triggers": ["code_commit", "manual_trigger"],
      "conditions": {
        "branch": "main",
        "all_tests_pass": true,
        "quality_gate_pass": true,
        "security_scan_pass": true
      },
      "actions": [
        "run_pre_deployment_checks",
        "execute_blue_green_deployment",
        "monitor_deployment_health",
        "trigger_rollback_if_needed"
      ],
      "priority": "high",
      "timeout": 1800,
      "retry_attempts": 1,
      "parallel_execution": false
    },
    "anomaly_detection_and_response": {
      "enabled": true,
      "name": "Anomaly Detection and Response",
      "description": "Detects system anomalies and automatically responds",
      "triggers": ["performance_degradation", "resource_threshold", "scheduled"],
      "conditions": {
        "anomaly_threshold": 2.0,
        "response_time_spike": 3.0,
        "error_rate_spike": 0.10,
        "schedule": "*/10 * * * *"
      },
      "actions": [
        "detect_system_anomalies",
        "analyze_anomaly_root_cause",
        "execute_automated_response",
        "notify_operations_team"
      ],
      "priority": "high",
      "timeout": 900,
      "retry_attempts": 2,
      "parallel_execution": true
    }
  },
  "global_settings": {
    "max_concurrent_hooks": 4,
    "default_timeout": 1800,
    "default_retry_attempts": 2,
    "notification_channels": [
      {
        "type": "slack",
        "webhook_url": "${SLACK_WEBHOOK_URL}",
        "channel": "#prometheus-ai-alerts"
      },
      {
        "type": "email",
        "smtp_server": "${SMTP_SERVER}",
        "recipients": ["devops@prometheus-ai.com", "qa@prometheus-ai.com"]
      }
    ],
    "log_level": "INFO",
    "metrics_collection": {
      "enabled": true,
      "prometheus_endpoint": "http://prometheus:9090",
      "grafana_dashboard": "http://grafana:3000/d/agent-hooks"
    },
    "security": {
      "require_authentication": true,
      "allowed_users": ["system", "devops", "qa-automation"],
      "audit_logging": true
    },
    "performance_optimization": {
      "enable_caching": true,
      "cache_ttl_seconds": 300,
      "enable_parallel_execution": true,
      "resource_limits": {
        "max_memory_mb": 2048,
        "max_cpu_cores": 4
      }
    }
  },
  "component_mappings": {
    "helios-core": {
      "paths": [
        "services/helios-core/**",
        "services/nlp-service/**"
      ],
      "tests": [
        "tests/unit/test_helios_*.py",
        "tests/integration/test_ai_*.py",
        "tests/performance/test_model_*.py"
      ],
      "dependencies": [
        "data-ingestion",
        "volcano-watchtower"
      ],
      "scaling_profile": {
        "min_replicas": 2,
        "max_replicas": 10,
        "cpu_target": 70,
        "memory_target": 80
      }
    },
    "volcano-watchtower": {
      "paths": [
        "services/volcano-watchtower/**"
      ],
      "tests": [
        "tests/unit/test_volcano_*.py",
        "tests/integration/test_monitoring_*.py",
        "tests/performance/test_realtime_*.py"
      ],
      "dependencies": [
        "helios-core",
        "data-ingestion"
      ],
      "scaling_profile": {
        "min_replicas": 3,
        "max_replicas": 15,
        "cpu_target": 75,
        "memory_target": 85
      }
    },
    "data-ingestion": {
      "paths": [
        "services/data-ingestion/**"
      ],
      "tests": [
        "tests/unit/test_ingestion_*.py",
        "tests/integration/test_data_*.py",
        "tests/performance/test_throughput_*.py"
      ],
      "dependencies": [],
      "scaling_profile": {
        "min_replicas": 2,
        "max_replicas": 8,
        "cpu_target": 80,
        "memory_target": 75
      }
    },
    "api-gateway": {
      "paths": [
        "services/api-gateway/**"
      ],
      "tests": [
        "tests/unit/test_api_*.py",
        "tests/integration/test_gateway_*.py",
        "tests/performance/test_load_*.py"
      ],
      "dependencies": [
        "helios-core",
        "volcano-watchtower"
      ],
      "scaling_profile": {
        "min_replicas": 2,
        "max_replicas": 12,
        "cpu_target": 70,
        "memory_target": 70
      }
    },
    "vulcan-ui": {
      "paths": [
        "services/vulcan-ui/**"
      ],
      "tests": [
        "tests/unit/test_ui_*.py",
        "tests/integration/test_frontend_*.py",
        "tests/e2e/test_user_*.py"
      ],
      "dependencies": [
        "api-gateway"
      ],
      "scaling_profile": {
        "min_replicas": 2,
        "max_replicas": 6,
        "cpu_target": 60,
        "memory_target": 60
      }
    },
    "system-monitor": {
      "paths": [
        "services/system-monitor/**"
      ],
      "tests": [
        "tests/unit/test_monitor_*.py",
        "tests/integration/test_system_*.py"
      ],
      "dependencies": [],
      "scaling_profile": {
        "min_replicas": 1,
        "max_replicas": 3,
        "cpu_target": 50,
        "memory_target": 60
      }
    }
  },
  "model_retraining_profiles": {
    "helios-core": {
      "retraining_triggers": {
        "accuracy_drop_threshold": 0.05,
        "physics_compliance_drop": 0.10,
        "prediction_drift_threshold": 0.15,
        "data_staleness_days": 7,
        "model_age_days": 30
      },
      "retraining_resources": {
        "gpu_required": true,
        "min_gpu_memory_gb": 16,
        "estimated_duration_hours": 8,
        "cpu_cores": 8,
        "memory_gb": 32
      },
      "validation_criteria": {
        "min_accuracy": 0.85,
        "min_physics_compliance": 0.80,
        "max_prediction_drift": 0.10
      }
    },
    "volcano-watchtower": {
      "retraining_triggers": {
        "accuracy_drop_threshold": 0.03,
        "false_positive_rate": 0.05,
        "false_negative_rate": 0.02,
        "data_staleness_days": 3,
        "model_age_days": 14
      },
      "retraining_resources": {
        "gpu_required": true,
        "min_gpu_memory_gb": 8,
        "estimated_duration_hours": 4,
        "cpu_cores": 4,
        "memory_gb": 16
      },
      "validation_criteria": {
        "min_accuracy": 0.90,
        "max_false_positive_rate": 0.03,
        "max_false_negative_rate": 0.01
      }
    },
    "seismic-cnn": {
      "retraining_triggers": {
        "accuracy_drop_threshold": 0.02,
        "detection_rate_drop": 0.05,
        "data_staleness_days": 1,
        "model_age_days": 7
      },
      "retraining_resources": {
        "gpu_required": true,
        "min_gpu_memory_gb": 12,
        "estimated_duration_hours": 6,
        "cpu_cores": 6,
        "memory_gb": 24
      },
      "validation_criteria": {
        "min_accuracy": 0.95,
        "min_detection_rate": 0.92,
        "max_false_alarm_rate": 0.02
      }
    }
  },
  "quality_gates": {
    "code_quality": {
      "min_overall_score": 7.0,
      "max_critical_issues": 0,
      "max_high_severity_vulns": 0,
      "min_test_coverage": 0.80,
      "max_code_duplication": 0.10,
      "max_cyclomatic_complexity": 15
    },
    "model_quality": {
      "min_accuracy": 0.80,
      "min_physics_compliance": 0.70,
      "max_prediction_drift": 0.15,
      "min_validation_score": 0.85
    },
    "deployment_quality": {
      "all_tests_pass": true,
      "quality_gate_pass": true,
      "security_scan_pass": true,
      "performance_regression_threshold": 0.10,
      "max_deployment_time_minutes": 30
    }
  }
}