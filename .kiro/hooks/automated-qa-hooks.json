{
  "hooks": [
    {
      "id": "test-execution-hook",
      "name": "Automated Test Execution",
      "description": "Automatically runs comprehensive test suites when code changes are detected",
      "trigger": {
        "type": "file_change",
        "patterns": ["**/*.py", "**/*.js", "**/*.ts"],
        "exclude": ["**/node_modules/**", "**/__pycache__/**", "**/dist/**"]
      },
      "actions": [
        {
          "type": "command",
          "command": "python scripts/run_automated_tests.py",
          "timeout": 1800,
          "retry_count": 2
        }
      ],
      "conditions": {
        "branch_protection": true,
        "require_passing_tests": true
      }
    },
    {
      "id": "model-validation-hook",
      "name": "Continuous Model Validation",
      "description": "Validates AI models against scientific benchmarks on model updates",
      "trigger": {
        "type": "file_change",
        "patterns": ["**/models/**/*.py", "**/helios-core/**/*.py"],
        "exclude": ["**/tests/**"]
      },
      "actions": [
        {
          "type": "command",
          "command": "python scripts/validate_models.py",
          "timeout": 3600,
          "retry_count": 1
        }
      ],
      "conditions": {
        "model_accuracy_threshold": 0.85,
        "physics_constraint_compliance": true
      }
    },
    {
      "id": "code-quality-hook",
      "name": "Code Quality and Security Scanning",
      "description": "Runs automated code quality checks and security scans",
      "trigger": {
        "type": "pre_commit",
        "patterns": ["**/*.py", "**/*.js", "**/*.ts"]
      },
      "actions": [
        {
          "type": "command",
          "command": "python scripts/code_quality_scan.py",
          "timeout": 600,
          "retry_count": 1
        }
      ],
      "conditions": {
        "quality_gate_threshold": 8.0,
        "security_vulnerabilities": "none_high"
      }
    },
    {
      "id": "documentation-validation-hook",
      "name": "Documentation Generation and Validation",
      "description": "Automatically generates and validates documentation",
      "trigger": {
        "type": "file_change",
        "patterns": ["**/*.py", "**/*.js", "**/*.md", "**/api/**"],
        "exclude": ["**/node_modules/**", "**/__pycache__/**"]
      },
      "actions": [
        {
          "type": "command",
          "command": "python scripts/generate_validate_docs.py",
          "timeout": 900,
          "retry_count": 1
        }
      ],
      "conditions": {
        "documentation_coverage": 0.90,
        "api_documentation_complete": true
      }
    }
  ],
  "global_settings": {
    "notification_channels": ["slack", "email"],
    "failure_escalation": true,
    "parallel_execution": true,
    "max_concurrent_hooks": 4
  }
}