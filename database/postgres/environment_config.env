# =============================================================================
# COMPREHENSIVE ENVIRONMENT CONFIGURATION
# Prometheus AI Platform - Database Deployment Configuration
# =============================================================================

# =============================================================================
# PRIMARY DATABASE CONFIGURATION
# =============================================================================

# PostgreSQL Core Configuration
POSTGRES_HOST=postgres-service.prometheus-ai.svc.cluster.local
POSTGRES_PORT=5432
POSTGRES_DB=prometheus_geo
POSTGRES_USER=prometheus_admin
POSTGRES_PASSWORD=GeoPhys2024!PrometheusDB#
POSTGRES_SCHEMA_VERSION=2.0.0

# Connection Pool Configuration
POSTGRES_MAX_CONNECTIONS=200
POSTGRES_POOL_SIZE=20
POSTGRES_POOL_TIMEOUT=30
POSTGRES_POOL_RECYCLE=3600

# =============================================================================
# SPECIALIZED GEOLOGICAL AGE SERVICE CREDENTIALS
# =============================================================================

# Geological Age Database Service
POSTGRES_USER_GEOLOGICAL_AGE=prometheus_age_service
POSTGRES_PASSWORD_GEOLOGICAL_AGE=GeoAge2024!SecurePass#
GEOLOGICAL_AGE_SCHEMA=geological_age
GEOLOGICAL_AGE_SERVICE_PORT=5433

# Age Prediction Model Configuration
AGE_PREDICTION_MODEL_VERSION=v2.1.0
AGE_TRAINING_DATA_PATH=/data/geological_age/training_datasets/
AGE_MODEL_SAVE_PATH=/models/geological_age/
AGE_MODEL_CACHE_SIZE=1000
AGE_PREDICTION_BATCH_SIZE=100

# =============================================================================
# MODEL MANAGER CONFIGURATION
# =============================================================================

# Azure VM Integration
AZURE_VM_ENDPOINT=https://prometheus-ml.azurewebsites.net
AZURE_VM_RESOURCE_GROUP=prometheus-ai-resources
AZURE_VM_SUBSCRIPTION_ID=your-azure-subscription-id
AZURE_STORAGE_ACCOUNT=prometheusmlstorage
AZURE_STORAGE_CONTAINER=geological-models

# Model Registry Configuration
MODEL_REGISTRY_URI=postgresql://prometheus_ml:MLModels2024#@postgres-service.prometheus-ai.svc.cluster.local:5432/prometheus_ml
MODEL_REGISTRY_SCHEMA=model_management
MODEL_VERSIONING_STRATEGY=semantic
MODEL_RETENTION_DAYS=365

# Model Serving Configuration
MODEL_SERVING_PORT=8080
MODEL_SERVING_WORKERS=4
MODEL_SERVING_TIMEOUT=300
MODEL_BATCH_PREDICTION_SIZE=1000

# =============================================================================
# MLOPS PIPELINE CONFIGURATION
# =============================================================================

# MLflow Configuration
MLFLOW_TRACKING_URI=postgresql://prometheus_ml:MLModels2024#@postgres-service.prometheus-ai.svc.cluster.local:5432/mlflow_tracking
MLFLOW_BACKEND_STORE_URI=postgresql://prometheus_ml:MLModels2024#@postgres-service.prometheus-ai.svc.cluster.local:5432/mlflow_tracking
ARTIFACT_STORE_URI=/storage/mlflow_artifacts/
MLFLOW_S3_ENDPOINT_URL=https://s3.amazonaws.com
MLFLOW_DEFAULT_ARTIFACT_ROOT=s3://prometheus-mlflow-artifacts

# Experiment Tracking
MLFLOW_EXPERIMENT_NAME=prometheus_geological_ai
MLFLOW_RUN_NAME_PREFIX=geo_model
MLFLOW_TRACKING_USERNAME=prometheus_mlops
MLFLOW_TRACKING_PASSWORD=MLOps2024!Secure#

# Model Registry Integration
MLFLOW_MODEL_REGISTRY_URI=postgresql://prometheus_ml:MLModels2024#@postgres-service.prometheus-ai.svc.cluster.local:5432/mlflow_registry
MLFLOW_REGISTRY_STORE_URI=postgresql://prometheus_ml:MLModels2024#@postgres-service.prometheus-ai.svc.cluster.local:5432/mlflow_registry

# =============================================================================
# PROMETHEUS MONITORING CONFIGURATION
# =============================================================================

# Prometheus Metrics
PROMETHEUS_METRICS_ENDPOINT=http://prometheus-service.prometheus-ai.svc.cluster.local:9090
PROMETHEUS_PUSHGATEWAY_ENDPOINT=http://pushgateway-service.prometheus-ai.svc.cluster.local:9091
PROMETHEUS_SCRAPE_INTERVAL=15s
PROMETHEUS_EVALUATION_INTERVAL=15s

# Custom Metrics Configuration
GEOLOGICAL_METRICS_ENABLED=true
MODEL_PERFORMANCE_METRICS_ENABLED=true
DATABASE_PERFORMANCE_METRICS_ENABLED=true
EXTERNAL_API_METRICS_ENABLED=true

# =============================================================================
# EXTERNAL GEOLOGICAL AGE DATA SOURCES
# =============================================================================

# EarthChem API Configuration
EARTHCHEM_API_KEY=earthchem_api_key_placeholder
EARTHCHEM_API_ENDPOINT=https://www.earthchem.org/portal/api/
EARTHCHEM_SYNC_INTERVAL_HOURS=24
EARTHCHEM_BATCH_SIZE=1000
EARTHCHEM_RATE_LIMIT_PER_MINUTE=60

# GEOROC API Configuration
GEOROC_API_ENDPOINT=https://georoc.mpch-mainz.gwdg.de/georoc/api/
GEOROC_API_KEY=georoc_api_key_placeholder
GEOROC_SYNC_INTERVAL_HOURS=24
GEOROC_BATCH_SIZE=500
GEOROC_RATE_LIMIT_PER_MINUTE=30

# NAVDAT API Configuration
NAVDAT_API_ENDPOINT=https://navdat.org/api/v1/
NAVDAT_API_KEY=navdat_api_key_placeholder
NAVDAT_SYNC_INTERVAL_HOURS=12
NAVDAT_BATCH_SIZE=200
NAVDAT_RATE_LIMIT_PER_MINUTE=20

# PetDB API Configuration
PETDB_API_ENDPOINT=https://petdb.ldeo.columbia.edu/api/
PETDB_API_KEY=petdb_api_key_placeholder
PETDB_SYNC_INTERVAL_HOURS=24
PETDB_BATCH_SIZE=300
PETDB_RATE_LIMIT_PER_MINUTE=40

# Chronos Temporal Database
CHRONOS_API_KEY=chronos_temporal_api_key_placeholder
CHRONOS_API_ENDPOINT=https://chronos.stratigraphy.org/api/
CHRONOS_SYNC_INTERVAL_HOURS=48

# Macrostrat Geological Database
MACROSTRAT_API_KEY=macrostrat_geological_api_key_placeholder
MACROSTRAT_API_ENDPOINT=https://macrostrat.org/api/
MACROSTRAT_SYNC_INTERVAL_HOURS=24

# =============================================================================
# GRID DATA SOURCES FOR AGE INTERPOLATION
# =============================================================================

# OneGeology WMS Service
ONEGEOLOGY_WMS_ENDPOINT=https://map.onegeology.org/geoserver/wms
ONEGEOLOGY_WMS_VERSION=1.3.0
ONEGEOLOGY_WMS_FORMAT=image/png
ONEGEOLOGY_CACHE_DURATION_HOURS=168

# USGS Geological Survey
USGS_GEOLOGY_API_KEY=usgs_geological_survey_api_key_placeholder
USGS_API_ENDPOINT=https://mrdata.usgs.gov/services/
USGS_SYNC_INTERVAL_HOURS=72
USGS_CACHE_DURATION_HOURS=168

# British Geological Survey
BGS_LEXICON_API_KEY=british_geological_survey_key_placeholder
BGS_API_ENDPOINT=https://www.bgs.ac.uk/services/ngdc/api/
BGS_SYNC_INTERVAL_HOURS=72

# =============================================================================
# HIGH-PERFORMANCE COMPUTING CONFIGURATION
# =============================================================================

# Parallel Processing Configuration
PARALLEL_PROCESSING_CORES=8
PARALLEL_PROCESSING_MAX_WORKERS=16
PARALLEL_PROCESSING_CHUNK_SIZE=1000
PARALLEL_PROCESSING_TIMEOUT_SECONDS=3600

# GPU Acceleration
GPU_ACCELERATION_ENABLED=true
GPU_DEVICE_COUNT=2
GPU_MEMORY_LIMIT_GB=8
CUDA_VISIBLE_DEVICES=0,1
PYTORCH_CUDA_ALLOC_CONF=max_split_size_mb:512

# Distributed Computing
DASK_SCHEDULER_ADDRESS=dask-scheduler.prometheus-ai.svc.cluster.local:8786
DASK_WORKER_COUNT=4
DASK_WORKER_MEMORY_GB=8
DASK_WORKER_CORES=4

# =============================================================================
# REDIS CACHE CONFIGURATION
# =============================================================================

# Redis Connection
REDIS_CACHE_HOST=redis-service.prometheus-ai.svc.cluster.local
REDIS_CACHE_PORT=6379
REDIS_CACHE_PASSWORD=RedisCache2024!
REDIS_CACHE_DB=0
REDIS_CACHE_SSL=false

# Cache Configuration
REDIS_CACHE_TTL_SECONDS=3600
REDIS_CACHE_MAX_MEMORY=2gb
REDIS_CACHE_EVICTION_POLICY=allkeys-lru
REDIS_CACHE_COMPRESSION_ENABLED=true

# Cache Prefixes
GEOLOGICAL_DATA_CACHE_PREFIX=geo_data:
MODEL_CACHE_PREFIX=ml_model:
API_RESPONSE_CACHE_PREFIX=api_resp:
EXTERNAL_DATA_CACHE_PREFIX=ext_data:

# =============================================================================
# DATA QUALITY AND MONITORING
# =============================================================================

# Data Quality Thresholds
DATA_QUALITY_THRESHOLD=0.7
CONFIDENCE_LEVEL_MINIMUM=0.5
AGE_UNCERTAINTY_MAX_MA=100.0
SPATIAL_SEARCH_RADIUS_M=100000

# Data Validation Configuration
ENABLE_DATA_VALIDATION=true
VALIDATION_BATCH_SIZE=1000
VALIDATION_TIMEOUT_SECONDS=300
VALIDATION_RETRY_COUNT=3

# Monitoring Configuration
MONITORING_INTERVAL_SECONDS=60
ALERT_THRESHOLD_ERROR_RATE=0.05
ALERT_THRESHOLD_RESPONSE_TIME_MS=5000
HEALTH_CHECK_TIMEOUT_SECONDS=30

# =============================================================================
# BACKUP AND ARCHIVAL CONFIGURATION
# =============================================================================

# AWS S3 Backup Configuration
BACKUP_S3_BUCKET=prometheus-geological-backups
BACKUP_S3_REGION=us-west-2
BACKUP_S3_ACCESS_KEY_ID=your_aws_access_key
BACKUP_S3_SECRET_ACCESS_KEY=your_aws_secret_key
BACKUP_S3_STORAGE_CLASS=STANDARD_IA

# Azure Blob Storage Configuration
BACKUP_AZURE_CONTAINER=prometheus-age-data-archive
BACKUP_AZURE_ACCOUNT_NAME=prometheusbackupstorage
BACKUP_AZURE_ACCOUNT_KEY=your_azure_storage_key
BACKUP_AZURE_TIER=Cool

# Google Cloud Storage Configuration
BACKUP_GCS_BUCKET=prometheus-ml-model-backups
BACKUP_GCS_PROJECT_ID=prometheus-ai-project
BACKUP_GCS_CREDENTIALS_PATH=/secrets/gcs-credentials.json
BACKUP_GCS_STORAGE_CLASS=NEARLINE

# Backup Schedule Configuration
BACKUP_RETENTION_DAYS=730
BACKUP_FULL_SCHEDULE=0 2 * * 0  # Weekly full backup at 2 AM Sunday
BACKUP_INCREMENTAL_SCHEDULE=0 2 * * 1-6  # Daily incremental backup at 2 AM
BACKUP_COMPRESSION_ENABLED=true
BACKUP_ENCRYPTION_ENABLED=true

# Archive Configuration
ARCHIVE_AFTER_DAYS=90
ARCHIVE_STORAGE_CLASS=GLACIER
ARCHIVE_RETRIEVAL_TIER=Standard
DEEP_ARCHIVE_AFTER_DAYS=365

# =============================================================================
# SECURITY CONFIGURATION
# =============================================================================

# Encryption Configuration
DATABASE_ENCRYPTION_ENABLED=true
ENCRYPTION_KEY_ROTATION_DAYS=90
TLS_ENABLED=true
TLS_CERT_PATH=/secrets/tls/tls.crt
TLS_KEY_PATH=/secrets/tls/tls.key

# Authentication Configuration
JWT_SECRET_KEY=prometheus_jwt_secret_key_2025
JWT_EXPIRATION_HOURS=24
JWT_REFRESH_EXPIRATION_DAYS=7
OAUTH2_ENABLED=false

# API Security
API_RATE_LIMIT_PER_MINUTE=1000
API_RATE_LIMIT_BURST=100
API_CORS_ORIGINS=https://prometheus-ai.com,https://app.prometheus-ai.com
API_CSRF_PROTECTION_ENABLED=true

# =============================================================================
# LOGGING CONFIGURATION
# =============================================================================

# Log Levels
LOG_LEVEL=INFO
DATABASE_LOG_LEVEL=WARNING
EXTERNAL_API_LOG_LEVEL=INFO
MODEL_LOG_LEVEL=DEBUG

# Log Destinations
LOG_TO_CONSOLE=true
LOG_TO_FILE=true
LOG_FILE_PATH=/logs/prometheus-database.log
LOG_FILE_MAX_SIZE_MB=100
LOG_FILE_BACKUP_COUNT=10

# Structured Logging
LOG_FORMAT=json
LOG_TIMESTAMP_FORMAT=ISO8601
LOG_INCLUDE_CALLER=true
LOG_INCLUDE_STACK_TRACE=true

# =============================================================================
# DEVELOPMENT AND TESTING CONFIGURATION
# =============================================================================

# Development Mode
DEVELOPMENT_MODE=false
DEBUG_ENABLED=false
PROFILING_ENABLED=false
MOCK_EXTERNAL_APIS=false

# Testing Configuration
TEST_DATABASE_URL=postgresql://test_user:test_pass@localhost:5432/prometheus_test
TEST_DATA_SEED_ENABLED=false
TEST_CLEANUP_ENABLED=true
INTEGRATION_TESTS_ENABLED=true

# =============================================================================
# FEATURE FLAGS
# =============================================================================

# Feature Toggles
ENABLE_GEOLOGICAL_AGE_PREDICTION=true
ENABLE_EXTERNAL_DATA_SYNC=true
ENABLE_MODEL_AUTO_DEPLOYMENT=true
ENABLE_ADVANCED_CACHING=true
ENABLE_PERFORMANCE_MONITORING=true
ENABLE_AUTOMATED_BACKUPS=true
ENABLE_REAL_TIME_ALERTS=true
ENABLE_MULTI_CLOUD_STORAGE=true

# Experimental Features
ENABLE_QUANTUM_COMPUTING_INTEGRATION=false
ENABLE_FEDERATED_LEARNING=false
ENABLE_EDGE_COMPUTING=false
ENABLE_BLOCKCHAIN_PROVENANCE=false

# =============================================================================
# PERFORMANCE TUNING
# =============================================================================

# Database Performance
DB_CONNECTION_POOL_SIZE=20
DB_CONNECTION_POOL_MAX_OVERFLOW=30
DB_CONNECTION_POOL_TIMEOUT=30
DB_CONNECTION_POOL_RECYCLE=3600
DB_QUERY_TIMEOUT_SECONDS=300

# Application Performance
WORKER_PROCESSES=4
WORKER_THREADS_PER_PROCESS=8
ASYNC_TASK_QUEUE_SIZE=1000
ASYNC_TASK_TIMEOUT_SECONDS=600

# Memory Management
MAX_MEMORY_USAGE_GB=16
MEMORY_CLEANUP_INTERVAL_SECONDS=300
GARBAGE_COLLECTION_THRESHOLD=0.8

# =============================================================================
# ENVIRONMENT VALIDATION
# =============================================================================

# Required Environment Variables Validation
REQUIRED_VARS="POSTGRES_HOST,POSTGRES_USER,POSTGRES_PASSWORD,POSTGRES_DB"
REQUIRED_SECRETS="EARTHCHEM_API_KEY,GEOROC_API_KEY,NAVDAT_API_KEY,PETDB_API_KEY"
REQUIRED_PATHS="AGE_TRAINING_DATA_PATH,AGE_MODEL_SAVE_PATH,ARTIFACT_STORE_URI"

# Configuration Validation
VALIDATE_DATABASE_CONNECTION=true
VALIDATE_EXTERNAL_API_ACCESS=true
VALIDATE_STORAGE_ACCESS=true
VALIDATE_MONITORING_ENDPOINTS=true

# Health Check Configuration
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_INTERVAL_SECONDS=30
HEALTH_CHECK_TIMEOUT_SECONDS=10
HEALTH_CHECK_FAILURE_THRESHOLD=3