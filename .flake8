[flake8]
max-line-length = 100
extend-ignore = E203,W503,F821,F824,E501,W504,F401

exclude = .git,__pycache__,.venv,venv,env,build,dist,.eggs,*.egg-info,.pytest_cache,.mypy_cache,node_modules,backups

max-complexity = 15
per-file-ignores =
    tests/*:F401,F811,E711,E712
    examples/*:F401,F811
    __init__.py:F401,F403

# Count the number of occurrences of each error/warning code
count = True
statistics = True
show-source = True