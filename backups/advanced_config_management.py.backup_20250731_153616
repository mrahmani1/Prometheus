# Configuration source implementations

class FileConfigurationSource:
    """File-based configuration source"""
    
    def __init__(self, config_dir: Path):
        self.config_dir = config_dir
        self.supported_formats = ['.json', '.yaml', '.yml', '.toml', '.ini']
    
    def initialize(self):
        """Initialize file source"""
        self.config_dir.mkdir(parents=True, exist_ok=True)
    
    async def load(self) -> Dict[str, Any]:
        """Load configuration from files"""
        
        config = {}
        
        for config_file in self.config_dir.glob('*'):
            if config_file.suffix in self.supported_formats:
                try:
                    file_config = await self._load_file(config_file)
                    config.update(file_config)
                except Exception as e:
                    logger.warning(f"Failed to load {config_file}: {e}")
        
        return config
    
    async def _load_file(self, file_path: Path) -> Dict[str, Any]:
        """Load configuration from specific file"""
        
        with open(file_path, 'r') as f:
            if file_path.suffix == '.json':
                return json.load(f)
            elif file_path.suffix in ['.yaml', '.yml']:
                return yaml.safe_load(f)
            elif file_path.suffix == '.toml':
                return toml.load(f)
            else:
                return {}
    
    async def create_watcher(self, callback: Callable) -> Any:
        """Create file watcher"""
        
        class ConfigFileHandler(FileSystemEventHandler):
            def __init__(self, callback_func):
                self.callback = callback_func
            
            def on_modified(self, event):
                if not event.is_directory:
                    asyncio.create_task(
                        self.callback(ConfigurationSource.FILE, event.src_path, None, None)
                    )
        
        event_handler = ConfigFileHandler(callback)
        observer = Observer()
        observer.schedule(event_handler, str(self.config_dir), recursive=True)
        observer.start()
        
        return observer

class EnvironmentConfigurationSource:
    """Environment variable configuration source"""
    
    def initialize(self):
        """Initialize environment source"""
        pass
    
    async def load(self) -> Dict[str, Any]:
        """Load configuration from environment variables"""
        
        config = {}
        
        # Load environment variables with specific prefixes
        prefixes = ['PROMETHEUS_', 'HELIOS_', 'VULCAN_', 'GEOLOGICAL_']
        
        for key, value in os.environ.items():
            for prefix in prefixes:
                if key.startswith(prefix):
                    config_key = key[len(prefix):].lower()
                    
                    # Try to parse as JSON first, then as string
                    try:
                        config[config_key] = json.loads(value)
                    except:
                        config[config_key] = value
                    break
        
        return config
    
    async def create_watcher(self, callback: Callable) -> Any:
        """Environment variables don't support watching"""
        return None

