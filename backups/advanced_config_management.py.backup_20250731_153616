    def get_configuration(self, key: str, default: Any = None) -> Any:
        """Get configuration value"""
        
        if 'current' not in self.configurations:
            logger.warning("No configuration loaded")
            return default
        
        return self.configurations['current'].get(key, default)
    
    def set_configuration(self, key: str, value: Any, persist: bool = True) -> bool:
        """Set configuration value"""
        
        try:
            # Validate value if schema exists
            if key in self.schemas:
                schema = self.schemas[key]
                
                # Type validation
                if not isinstance(value, schema.data_type):
                    value = schema.data_type(value)
                
                # Custom validation
                for rule in schema.validation_rules:
                    if not rule(value):
                        logger.error(f"Validation failed for {key}")
                        return False
            
            # Update current configuration
            if 'current' not in self.configurations:
                self.configurations['current'] = {}
            
            old_value = self.configurations['current'].get(key)
            self.configurations['current'][key] = value
            
            # Persist if requested
            if persist:
                asyncio.create_task(self._persist_configuration(key, value))
            
            # Apply dynamic changes
            if key in self.schemas and self.schemas[key].dynamic:
                asyncio.create_task(self._apply_dynamic_configuration_change(key, old_value, value))
            
            logger.info(f"Configuration set: {key} = {value}")
            return True
            
        except Exception as e:
            logger.error(f"Failed to set configuration {key}: {e}")
            return False

