class ConfigurationSource(Enum):
    """Configuration source types"""
    FILE = "file"
    ENVIRONMENT = "environment"
    CONSUL = "consul"
    ETCD = "etcd"
    KUBERNETES = "kubernetes"
    VAULT = "vault"
    AWS_PARAMETER_STORE = "aws_parameter_store"
    REDIS = "redis"
    DATABASE = "database"
    REMOTE_API = "remote_api"

class ConfigurationPriority(Enum):
    """Configuration priority levels"""
    SYSTEM = 1
    ENVIRONMENT = 2
    FILE = 3
    REMOTE = 4
    DEFAULT = 5

@dataclass
class ConfigurationSchema:
    """Configuration schema definition"""
    name: str
    data_type: Type
    default_value: Any
    description: str
    validation_rules: List[Callable] = field(default_factory=list)
    dependencies: List[str] = field(default_factory=list)
    sensitive: bool = False
    dynamic: bool = False
    optimization_target: bool = False
    geological_context: Optional[str] = None
    physics_constraints: Dict[str, Any] = field(default_factory=dict)
    performance_impact: str = "low"  # low, medium, high, critical

@dataclass
class ConfigurationValue:
    """Configuration value with metadata"""
    key: str
    value: Any
    source: ConfigurationSource
    priority: ConfigurationPriority
    timestamp: datetime
    version: str
    checksum: str
    encrypted: bool = False
    validated: bool = False
    optimization_score: Optional[float] = None
    geological_relevance: Optional[float] = None
    performance_metrics: Dict[str, float] = field(default_factory=dict)

