    async def load_configuration(self, 
                               profile_id: Optional[str] = None,
                               sources: Optional[List[ConfigurationSource]] = None) -> Dict[str, Any]:
        """Load configuration from multiple sources with priority handling"""
        
        logger.info(f"Loading configuration with profile: {profile_id}")
        
        if sources is None:
            sources = list(self.sources.keys())
        
        # Load base configuration
        merged_config = {}
        
        # Load from sources in priority order
        for source_type in sorted(sources, key=lambda x: ConfigurationPriority[x.name.upper()].value):
            try:
                source_config = await self.sources[source_type].load()
                merged_config = self._merge_configurations(merged_config, source_config, source_type)
                logger.debug(f"Loaded configuration from {source_type.value}")
            except Exception as e:
                logger.warning(f"Failed to load from {source_type.value}: {e}")
        
        # Apply profile overrides
        if profile_id and profile_id in self.profiles:
            profile = self.profiles[profile_id]
            merged_config = self._merge_configurations(
                merged_config, 
                profile.configuration_overrides,
                ConfigurationSource.FILE
            )
        
        # Validate configuration
        validated_config = await self._validate_configuration(merged_config)
        
        # Optimize configuration if enabled
        if self.optimization_engine:
            optimized_config = await self.optimization_engine.optimize(validated_config)
            validated_config.update(optimized_config)
        
        # Store configuration
        self.configurations['current'] = validated_config
        
        # Start watchers for dynamic updates
        await self._start_configuration_watchers(sources)
        
        logger.info("Configuration loaded successfully")
        
        return validated_config
    
    def _merge_configurations(self, 
                            base_config: Dict[str, Any],
                            new_config: Dict[str, Any],
                            source: ConfigurationSource) -> Dict[str, Any]:
        """Merge configurations with priority handling"""
        
        merged = base_config.copy()
        
        for key, value in new_config.items():
            if key in merged:
                # Handle nested dictionaries
                if isinstance(merged[key], dict) and isinstance(value, dict):
                    merged[key] = self._merge_configurations(merged[key], value, source)
                else:
                    # Override based on source priority
                    current_priority = getattr(merged.get(f"{key}_priority"), 'value', 999)
                    new_priority = ConfigurationPriority[source.name.upper()].value
                    
                    if new_priority <= current_priority:
                        merged[key] = value
                        merged[f"{key}_priority"] = ConfigurationPriority[source.name.upper()]
            else:
                merged[key] = value
                merged[f"{key}_priority"] = ConfigurationPriority[source.name.upper()]
        
        return merged
    
    async def _validate_configuration(self, config: Dict[str, Any]) -> Dict[str, Any]:
        """Validate configuration against schemas"""
        
        validated_config = {}
        
        for key, value in config.items():
            if key.endswith('_priority'):
                continue
                
            if key in self.schemas:
                schema = self.schemas[key]
                
                # Type validation
                if not isinstance(value, schema.data_type):
                    try:
                        value = schema.data_type(value)
                    except (ValueError, TypeError) as e:
                        logger.warning(f"Type conversion failed for {key}: {e}")
                        value = schema.default_value
                
                # Custom validation rules
                for rule in schema.validation_rules:
                    try:
                        if not rule(value):
                            logger.warning(f"Validation failed for {key}, using default")
                            value = schema.default_value
                            break
                    except Exception as e:
                        logger.warning(f"Validation error for {key}: {e}")
                        value = schema.default_value
                        break
                
                # Physics constraints validation
                if schema.physics_constraints:
                    value = await self._validate_physics_constraints(value, schema.physics_constraints)
                
                validated_config[key] = value
            else:
                # Unknown configuration, keep as-is but log warning
                logger.warning(f"Unknown configuration key: {key}")
                validated_config[key] = value
        
        # Add missing configurations with defaults
        for schema_key, schema in self.schemas.items():
            if schema_key not in validated_config:
                validated_config[schema_key] = schema.default_value
        
        return validated_config
    
    async def _validate_physics_constraints(self, 
                                          value: Any,
                                          constraints: Dict[str, Any]) -> Any:
        """Validate physics-based constraints"""
        
        # Implement physics constraint validation
        # This would include checks like CFL condition, stability criteria, etc.
        
        for constraint_name, constraint_expr in constraints.items():
            try:
                # Evaluate physics constraint
                # This is a simplified implementation
                if constraint_name == 'cfl_condition':
                    # Check CFL condition for numerical stability
                    if isinstance(value, dict):
                        temporal_res = value.get('temporal_resolution', 1.0)
                        spatial_res = value.get('spatial_resolution', 1000.0)
                        wave_speed = 3000.0  # Typical seismic wave speed
                        
                        cfl_number = wave_speed * temporal_res / spatial_res
                        if cfl_number > 1.0:
                            logger.warning(f"CFL condition violated: {cfl_number} > 1.0")
                            # Adjust temporal resolution
                            value['temporal_resolution'] = spatial_res / wave_speed * 0.9
                
            except Exception as e:
                logger.warning(f"Physics constraint validation failed for {constraint_name}: {e}")
        
        return value
    
    async def _start_configuration_watchers(self, sources: List[ConfigurationSource]):
        """Start watchers for dynamic configuration updates"""
        
        for source_type in sources:
            if source_type not in self.watchers:
                try:
                    watcher = await self.sources[source_type].create_watcher(
                        callback=self._on_configuration_change
                    )
                    self.watchers[source_type] = watcher
                    logger.info(f"Started configuration watcher for {source_type.value}")
                except Exception as e:
                    logger.warning(f"Failed to start watcher for {source_type.value}: {e}")
    
    async def _on_configuration_change(self, 
                                     source: ConfigurationSource,
                                     key: str,
                                     old_value: Any,
                                     new_value: Any):
        """Handle configuration changes"""
        
        logger.info(f"Configuration change detected: {key} in {source.value}")
        
        # Validate new value
        if key in self.schemas:
            schema = self.schemas[key]
            
            # Validate new value
            for rule in schema.validation_rules:
                if not rule(new_value):
                    logger.warning(f"Invalid new value for {key}, ignoring change")
                    return
        
        # Update configuration
        if 'current' in self.configurations:
            old_config_value = self.configurations['current'].get(key)
            self.configurations['current'][key] = new_value
            
            # Trigger reconfiguration if needed
            if schema.dynamic:
                await self._apply_dynamic_configuration_change(key, old_config_value, new_value)
            
            # Log change
            logger.info(f"Configuration updated: {key} = {new_value}")
            
            # Notify monitoring system
            await self._notify_configuration_change(key, old_config_value, new_value)
    
    async def _apply_dynamic_configuration_change(self, 
                                                key: str,
                                                old_value: Any,
                                                new_value: Any):
        """Apply dynamic configuration changes without restart"""
        
        # Implement dynamic reconfiguration logic
        # This would update running systems with new configuration
        
        if key == 'ai_model_training':
            # Update model training parameters
            await self._update_model_training_config(new_value)
        elif key == 'volcanic_monitoring':
            # Update monitoring thresholds
            await self._update_monitoring_thresholds(new_value)
        elif key == 'physics_simulation':
            # Update simulation parameters
            await self._update_simulation_config(new_value)
        
        logger.info(f"Applied dynamic configuration change for {key}")
    
