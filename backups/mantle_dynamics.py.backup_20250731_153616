class CoreMantleBoundaryModeler:
    """
    Core-mantle boundary thermal and chemical interaction simulation
    """
    
    def __init__(self, pinn_engine: PINNEngine, device: torch.device):
        self.pinn_engine = pinn_engine
        self.device = device
        
        # Initialize CMB model
        self._initialize_cmb_model()
        
        # CMB parameters
        self.cmb_parameters = {
            "cmb_radius": 3480e3,  # m
            "core_temperature": 4000,  # K
            "mantle_temperature": 2500,  # K
            "core_density": 12000,  # kg/m³
            "mantle_density": 5500,  # kg/m³
            "thermal_conductivity": 100,  # W/m·K
            "thermal_diffusivity": 1e-6,  # m²/s
            "d_prime_thickness": 200e3,  # m
            "post_perovskite_transition": 125e9,  # Pa
            "chemical_diffusivity": 1e-12  # m²/s
        }
    
    def _initialize_cmb_model(self):
        """Initialize PINN model for CMB processes"""
        try:
            # Create temporal PINN for CMB dynamics
            self.cmb_model = self.pinn_engine.create_temporal_model(
                model_id="core_mantle_boundary",
                input_dim=8,  # [r, θ, φ, t, T, P, composition, phase]
                output_dim=6,  # [temperature, heat_flux, velocity, composition, phase_stability, seismic_velocity]
                branch_hidden_dims=[512, 1024, 512],
                attention_heads=16
            )
            
            logger.info("Core-mantle boundary temporal PINN model initialized")
            
        except Exception as e:
            logger.error("Failed to initialize CMB model", error=str(e))
            raise
    
    def simulate_cmb_dynamics(
        self,
        initial_conditions: Dict[str, Any],
        time_span: Tuple[datetime, datetime],
        time_step: timedelta = timedelta(days=365*1000000)  # 1 million years
    ) -> List[CoreMantleBoundaryState]:
        """
        Simulate core-mantle boundary dynamics
        
        Args:
            initial_conditions: Initial CMB conditions
            time_span: Time span for simulation
            time_step: Time step for simulation
            
        Returns:
            List of CMB states through time
        """
        try:
            logger.info(f"Simulating CMB dynamics from {time_span[0]} to {time_span[1]}")
            
            cmb_history = []
            current_time = time_span[0]
            
            # Initialize CMB state
            cmb_state = self._initialize_cmb_state(initial_conditions)
            
            while current_time <= time_span[1]:
                # Calculate CMB evolution
                new_cmb_state = self._evolve_cmb_state(cmb_state, current_time, time_step)
                cmb_history.append(new_cmb_state)
                
                cmb_state = new_cmb_state
                current_time += time_step
            
            logger.info(f"CMB dynamics simulation completed with {len(cmb_history)} time steps")
            return cmb_history
            
        except Exception as e:
            logger.error("Failed to simulate CMB dynamics", error=str(e))
            raise
    
    def _initialize_cmb_state(self, initial_conditions: Dict[str, Any]) -> Dict[str, Any]:
        """Initialize CMB state"""
        
        params = self.cmb_parameters
        
        # Create spherical grid at CMB
        n_theta, n_phi = 36, 72  # 5-degree resolution
        theta = np.linspace(0, np.pi, n_theta)
        phi = np.linspace(0, 2*np.pi, n_phi)
        
        THETA, PHI = np.meshgrid(theta, phi, indexing='ij')
        
        # Initialize temperature field
        base_temperature = initial_conditions.get("base_temperature", params["mantle_temperature"])
        temperature_variations = initial_conditions.get("temperature_variations", 0.1)
        
        # Add spherical harmonic variations
        temperature_field = np.zeros_like(THETA)
        for l in range(1, 5):  # Degree
            for m in range(-l, l+1):  # Order
                amplitude = temperature_variations * base_temperature / (l + 1)
                harmonic = sph_harm(m, l, PHI, THETA).real
                temperature_field += amplitude * harmonic
        
        temperature_field += base_temperature
        
        # Initialize heat flux
        heat_flux = params["thermal_conductivity"] * temperature_variations * base_temperature / params["d_prime_thickness"]
        
        # Initialize chemical composition
        chemical_composition = initial_conditions.get("chemical_composition", {
            "Fe": 0.8, "Ni": 0.1, "Si": 0.05, "O": 0.05
        })
        
        # Initialize D" layer properties
        d_prime_thickness = initial_conditions.get("d_prime_thickness", params["d_prime_thickness"])
        
        # Initialize ULVZ locations (simplified)
        ulvz_locations = initial_conditions.get("ulvz_locations", [
            {"location": [0, 0], "thickness": 10e3, "velocity_reduction": 0.3},
            {"location": [np.pi, 0], "thickness": 15e3, "velocity_reduction": 0.4}
        ])
        
        return {
            "coordinates": np.stack([THETA, PHI], axis=-1),
            "temperature_field": temperature_field,
            "heat_flux": heat_flux,
            "chemical_composition": chemical_composition,
            "d_prime_thickness": d_prime_thickness,
            "ulvz_locations": ulvz_locations,
            "thermal_boundary_layer_thickness": 50e3  # m
        }
    
    def _evolve_cmb_state(
        self,
        current_state: Dict[str, Any],
        current_time: datetime,
        time_step: timedelta
    ) -> CoreMantleBoundaryState:
        """Evolve CMB state by one time step"""
        
        params = self.cmb_parameters
        dt_years = time_step.total_seconds() / (365.25 * 24 * 3600)
        
        # Calculate average properties
        avg_temperature = float(np.mean(current_state["temperature_field"]))
        avg_heat_flux = float(current_state["heat_flux"])
        
        # Update temperature due to cooling
        cooling_rate = 50 / 1e9  # K per million years
        new_temperature = avg_temperature - cooling_rate * dt_years / 1e6
        
        # Update heat flux
        temperature_gradient = (params["core_temperature"] - new_temperature) / params["d_prime_thickness"]
        new_heat_flux = params["thermal_conductivity"] * temperature_gradient
        
        # Update D" thickness (thermal boundary layer growth)
        thermal_diffusion_length = np.sqrt(params["thermal_diffusivity"] * time_step.total_seconds())
        new_d_prime_thickness = min(
            current_state["d_prime_thickness"] + thermal_diffusion_length,
            300e3  # Maximum D" thickness
        )
        
        # Calculate seismic velocity anomalies
        temperature_anomaly = new_temperature - params["mantle_temperature"]
        velocity_anomaly = {
            "vs_anomaly": -0.0004 * temperature_anomaly,  # dVs/Vs per K
            "vp_anomaly": -0.0002 * temperature_anomaly   # dVp/Vp per K
        }
        
        # Check post-perovskite stability
        cmb_pressure = params["mantle_density"] * 9.81 * (6371e3 - params["cmb_radius"])
        post_perovskite_stable = cmb_pressure > params["post_perovskite_transition"]
        
        return CoreMantleBoundaryState(
            timestamp=current_time,
            temperature_cmb=new_temperature,
            heat_flux_cmb=new_heat_flux,
            chemical_composition=current_state["chemical_composition"],
            d_prime_thickness=new_d_prime_thickness,
            seismic_velocity_anomaly=velocity_anomaly,
            thermal_boundary_layer_thickness=current_state["thermal_boundary_layer_thickness"],
            ultra_low_velocity_zones=current_state["ulvz_locations"],
            post_perovskite_stability=post_perovskite_stable
        )


class MantlePlumeModeler:
    """
    Mantle plume initiation, ascent, and surface expression modeling
    """
    
    def __init__(self, pinn_engine: PINNEngine, device: torch.device):
        self.pinn_engine = pinn_engine
        self.device = device
        
        # Initialize plume model
        self._initialize_plume_model()
        
        # Plume parameters
        self.plume_parameters = {
            "initiation_temperature_anomaly": 200,  # K
            "head_formation_time": 10e6,  # years
            "ascent_velocity": 0.1,  # m/year
            "head_radius": 1000e3,  # m
            "tail_radius": 100e3,  # m
            "buoyancy_flux": 1e4,  # m⁴/s³
            "thermal_diffusivity": 1e-6,  # m²/s
            "mantle_viscosity": 1e21,  # Pa·s
            "density_contrast": 50,  # kg/m³
            "surface_expression_threshold": 100  # K temperature anomaly
        }
    
    def _initialize_plume_model(self):
        """Initialize PINN model for plume dynamics"""
        try:
            # Create temporal PINN for plume evolution
            self.plume_model = self.pinn_engine.create_temporal_model(
                model_id="mantle_plume",
                input_dim=9,  # [x, y, z, t, T, P, viscosity, density, velocity]
                output_dim=7,  # [temperature, velocity, pressure, density, viscosity, deformation, entrainment]
                branch_hidden_dims=[512, 1024, 512],
                attention_heads=16
            )
            
            logger.info("Mantle plume temporal PINN model initialized")
            
        except Exception as e:
            logger.error("Failed to initialize plume model", error=str(e))
            raise
    
    def simulate_plume_evolution(
        self,
        initiation_location: np.ndarray,
        initial_conditions: Dict[str, Any],
        time_span: Tuple[datetime, datetime],
        time_step: timedelta = timedelta(days=365*10000)  # 10,000 years
    ) -> List[MantlePlumeState]:
        """
        Simulate mantle plume evolution from initiation to surface expression
        
        Args:
            initiation_location: Plume initiation location [x, y, z]
            initial_conditions: Initial plume conditions
            time_span: Time span for simulation
            time_step: Time step for simulation
            
        Returns:
            List of plume states through time
        """
        try:
            logger.info(f"Simulating plume evolution from {time_span[0]} to {time_span[1]}")
            
            plume_history = []
            current_time = time_span[0]
            plume_id = f"plume_{int(current_time.timestamp())}"
            
            # Initialize plume state
            plume_state = self._initialize_plume_state(
                plume_id, initiation_location, initial_conditions
            )
            
            while current_time <= time_span[1]:
                # Calculate plume evolution
                new_plume_state = self._evolve_plume_state(plume_state, current_time, time_step)
                plume_history.append(new_plume_state)
                
                plume_state = new_plume_state
                current_time += time_step
                
                # Stop if plume reaches surface or decays
                if (new_plume_state.stage == PlumeStage.SURFACE_EXPRESSION or 
                    new_plume_state.stage == PlumeStage.DECAY):
                    break
            
            logger.info(f"Plume evolution simulation completed with {len(plume_history)} time steps")
            return plume_history
            
        except Exception as e:
            logger.error("Failed to simulate plume evolution", error=str(e))
            raise
    
    def _initialize_plume_state(
        self,
        plume_id: str,
        initiation_location: np.ndarray,
        initial_conditions: Dict[str, Any]
    ) -> Dict[str, Any]:
        """Initialize plume state"""
        
        params = self.plume_parameters
        
        # Initial plume properties
        temperature_anomaly = initial_conditions.get(
            "temperature_anomaly", params["initiation_temperature_anomaly"]
        )
        
        initial_radius = initial_conditions.get("initial_radius", 50e3)  # m
        
        return {
            "plume_id": plume_id,
            "stage": PlumeStage.INITIATION,
            "head_location": initiation_location.copy(),
            "tail_location": initiation_location.copy(),
            "head_radius": initial_radius,
            "tail_radius": initial_radius * 0.5,
            "temperature_anomaly": temperature_anomaly,
            "ascent_velocity": 0.0,  # Initially stationary
            "buoyancy_flux": params["buoyancy_flux"],
            "volume_flux": 0.0,
            "composition": initial_conditions.get("composition", {"mg_number": 0.92}),
            "age": 0.0  # years
        }
    
    def _evolve_plume_state(
        self,
        current_state: Dict[str, Any],
        current_time: datetime,
        time_step: timedelta
    ) -> MantlePlumeState:
        """Evolve plume state by one time step"""
        
        params = self.plume_parameters
        dt_years = time_step.total_seconds() / (365.25 * 24 * 3600)
        new_age = current_state["age"] + dt_years
        
        # Determine plume stage
        new_stage = self._determine_plume_stage(current_state, new_age)
        
        # Calculate ascent velocity based on buoyancy
        density_contrast = params["density_contrast"]
        g = 9.81
        viscosity = params["mantle_viscosity"]
        
        if new_stage in [PlumeStage.HEAD_FORMATION, PlumeStage.ASCENT]:
            # Stokes velocity for spherical head
            head_radius = current_state["head_radius"]
            ascent_velocity = (2 * density_contrast * g * head_radius**2) / (9 * viscosity)
            ascent_velocity *= 365.25 * 24 * 3600  # Convert to m/year
        else:
            ascent_velocity = current_state["ascent_velocity"]
        
        # Update head location
        new_head_location = current_state["head_location"].copy()
        if new_stage in [PlumeStage.ASCENT, PlumeStage.SURFACE_EXPRESSION]:
            new_head_location[2] += ascent_velocity * dt_years  # Move upward
        
        # Update head radius (grows during head formation)
        if new_stage == PlumeStage.HEAD_FORMATION:
            growth_rate = 10  # m/year
            new_head_radius = current_state["head_radius"] + growth_rate * dt_years
            new_head_radius = min(new_head_radius, params["head_radius"])
        else:
            new_head_radius = current_state["head_radius"]
        
        # Update tail properties
        new_tail_location = current_state["tail_location"].copy()
        new_tail_radius = params["tail_radius"]
        
        # Calculate volume flux
        if new_stage in [PlumeStage.ASCENT, PlumeStage.SURFACE_EXPRESSION, PlumeStage.TAIL_PHASE]:
            volume_flux = np.pi * new_tail_radius**2 * ascent_velocity / (365.25 * 24 * 3600)  # m³/s
        else:
            volume_flux = 0.0
        
        # Update temperature anomaly (decreases with time due to cooling)
        cooling_rate = 10  # K per million years
        new_temperature_anomaly = max(
            current_state["temperature_anomaly"] - cooling_rate * dt_years / 1e6,
            50  # Minimum temperature anomaly
        )
        
        # Determine surface expression
        surface_expression = None
        if (new_stage == PlumeStage.SURFACE_EXPRESSION and 
            new_head_location[2] > -100e3):  # Within 100 km of surface
            
            # Convert to surface coordinates (simplified)
            surface_lat = np.degrees(np.arcsin(new_head_location[2] / np.linalg.norm(new_head_location)))
            surface_lon = np.degrees(np.arctan2(new_head_location[1], new_head_location[0]))
            
            surface_expression = GeologicalLocation(
                latitude=surface_lat,
                longitude=surface_lon,
                elevation=0.0
            )
        
        return MantlePlumeState(
            timestamp=current_time,
            plume_id=current_state["plume_id"],
            stage=new_stage,
            head_location=new_head_location,
            tail_location=new_tail_location,
            head_radius=new_head_radius,
            tail_radius=new_tail_radius,
            temperature_anomaly=new_temperature_anomaly,
            ascent_velocity=ascent_velocity,
            buoyancy_flux=params["buoyancy_flux"],
            surface_expression=surface_expression,
            volume_flux=volume_flux,
            composition=current_state["composition"]
        )
    
    def _determine_plume_stage(self, current_state: Dict[str, Any], age: float) -> PlumeStage:
        """Determine plume stage based on age and properties"""
        
        params = self.plume_parameters
        
        if age < params["head_formation_time"]:
            return PlumeStage.HEAD_FORMATION
        elif current_state["head_location"][2] < -100e3:  # Below 100 km depth
            return PlumeStage.ASCENT
        elif current_state["head_location"][2] >= -100e3:
            return PlumeStage.SURFACE_EXPRESSION
        elif age > 100e6:  # After 100 million years
            if current_state["temperature_anomaly"] < 100:
                return PlumeStage.DECAY
            else:
                return PlumeStage.TAIL_PHASE
        else:
            return current_state["stage"]


class MantleConvectionModeler:
    """
    Mantle convection simulation with temperature and compositional variations
    """
    
    def __init__(self, pinn_engine: PINNEngine, device: torch.device):
        self.pinn_engine = pinn_engine
        self.device = device
        
        # Initialize convection model
        self._initialize_convection_model()
        
        # Convection parameters
        self.convection_parameters = {
            "rayleigh_number": 1e6,
            "prandtl_number": 1e23,
            "thermal_diffusivity": 1e-6,  # m²/s
            "kinematic_viscosity": 1e15,  # m²/s
            "thermal_expansion": 3e-5,  # 1/K
            "reference_temperature": 1600,  # K
            "surface_temperature": 300,  # K
            "cmb_temperature": 3000,  # K
            "mantle_depth": 2900e3,  # m
            "gravity": 9.81  # m/s²
        }
    
    def _initialize_convection_model(self):
        """Initialize PINN model for mantle convection"""
        try:
            # Create temporal PINN for convection
            self.convection_model = self.pinn_engine.create_temporal_model(
                model_id="mantle_convection",
                input_dim=10,  # [r, θ, φ, t, T, P, viscosity, density, composition, phase]
                output_dim=8,  # [velocity, temperature, pressure, viscosity, density, heat_flux, stress, composition]
                branch_hidden_dims=[1024, 2048, 1024],
                attention_heads=20
            )
            
            logger.info("Mantle convection temporal PINN model initialized")
            
        except Exception as e:
            logger.error("Failed to initialize convection model", error=str(e))
            raise
    
    def simulate_mantle_convection(
        self,
        initial_conditions: Dict[str, Any],
        time_span: Tuple[datetime, datetime],
        time_step: timedelta = timedelta(days=365*100000)  # 100,000 years
    ) -> List[MantleConvectionState]:
        """
        Simulate mantle convection with temperature and compositional variations
        
        Args:
            initial_conditions: Initial mantle conditions
            time_span: Time span for simulation
            time_step: Time step for simulation
            
        Returns:
            List of convection states through time
        """
        try:
            logger.info(f"Simulating mantle convection from {time_span[0]} to {time_span[1]}")
            
            convection_history = []
            current_time = time_span[0]
            
            # Initialize convection state
            convection_state = self._initialize_convection_state(initial_conditions)
            
            while current_time <= time_span[1]:
                # Calculate convection evolution
                new_convection_state = self._evolve_convection_state(
                    convection_state, current_time, time_step
                )
                convection_history.append(new_convection_state)
                
                convection_state = new_convection_state
                current_time += time_step
            
            logger.info(f"Mantle convection simulation completed with {len(convection_history)} time steps")
            return convection_history
            
        except Exception as e:
            logger.error("Failed to simulate mantle convection", error=str(e))
            raise
    
    def _initialize_convection_state(self, initial_conditions: Dict[str, Any]) -> Dict[str, Any]:
        """Initialize mantle convection state"""
        
        params = self.convection_parameters
        
        # Create 3D spherical grid
        nr, ntheta, nphi = 50, 36, 72
        r = np.linspace(3480e3, 6371e3, nr)  # CMB to surface
        theta = np.linspace(0, np.pi, ntheta)
        phi = np.linspace(0, 2*np.pi, nphi)
        
        R, THETA, PHI = np.meshgrid(r, theta, phi, indexing='ij')
        
        # Initialize temperature field with adiabatic gradient
        surface_temp = params["surface_temperature"]
        cmb_temp = params["cmb_temperature"]
        
        # Adiabatic temperature profile
        temperature_field = surface_temp + (cmb_temp - surface_temp) * (R - R.max()) / (R.min() - R.max())
        
        # Add thermal perturbations for convection
        perturbation_amplitude = initial_conditions.get("perturbation_amplitude", 100)  # K
        
        for l in range(1, 8):  # Spherical harmonic degrees
            for m in range(-l, l+1):  # Orders
                amplitude = perturbation_amplitude / (l + 1)
