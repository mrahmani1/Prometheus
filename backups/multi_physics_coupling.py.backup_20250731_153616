    """Thermal physics domain solver"""
    
    def __init__(self, thermal_diffusivity: float = 1e-6, heat_capacity: float = 1000.0):
        self.thermal_diffusivity = thermal_diffusivity
        self.heat_capacity = heat_capacity
    
    def solve_step(
        self, 
        temperature: torch.Tensor, 
        dt: float, 
        coupling_terms: List[torch.Tensor]
    ) -> torch.Tensor:
        """
        Solve thermal diffusion equation with coupling terms
        ∂T/∂t = α∇²T + Q_coupling/(ρc)
        """
        # Compute Laplacian (simplified for demonstration)
        laplacian_T = self._compute_laplacian(temperature)
        
        # Sum coupling terms (heat sources from other domains)
        coupling_heat = torch.zeros_like(temperature)
        for term in coupling_terms:
            # Ensure coupling term matches temperature shape
            if term.shape != temperature.shape:
                # Try to reshape or broadcast
                if term.numel() == temperature.numel():
                    term = term.view(temperature.shape)
                elif len(term.shape) > len(temperature.shape):
                    # Take mean over extra dimensions
                    while len(term.shape) > len(temperature.shape):
                        term = term.mean(dim=-1)
                else:
                    # Skip incompatible terms
                    continue
            coupling_heat += term
        
        # Thermal diffusion equation
        dT_dt = self.thermal_diffusivity * laplacian_T + coupling_heat / self.heat_capacity
        
        # Forward Euler step (can be replaced with more sophisticated methods)
        temperature_new = temperature + dt * dT_dt
        
        return temperature_new
    
    def compute_residual(
        self, 
        temperature: torch.Tensor, 
        temperature_prev: torch.Tensor, 
        dt: float
    ) -> torch.Tensor:
