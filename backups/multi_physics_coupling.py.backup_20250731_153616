class MultiPhysicsCouplingEngine:
    """
    Advanced Multi-Physics Coupling Engine
    
    Manages coupling between multiple physics domains with adaptive time stepping,
    stability analysis, and convergence monitoring.
    """
    
    def __init__(
        self,
        domains: Dict[PhysicsDomain, PhysicsDomainSolver],
        coupling_terms: List[CouplingTerm],
        time_step_config: AdaptiveTimeStepConfig,
        convergence_config: ConvergenceConfig,
        mesh_refinement_config: Optional[MeshRefinementConfig] = None
    ):
        self.domains = domains
        self.coupling_terms = coupling_terms
        self.time_step_config = time_step_config
        self.convergence_config = convergence_config
        self.mesh_refinement_config = mesh_refinement_config or MeshRefinementConfig()
        
        # State variables for each domain
        self.domain_states: Dict[PhysicsDomain, torch.Tensor] = {}
        self.domain_states_prev: Dict[PhysicsDomain, torch.Tensor] = {}
        
        # Time stepping variables
        self.current_time = 0.0
        self.current_dt = time_step_config.initial_dt
        self.time_history = []
        self.dt_history = []
        
        # Convergence monitoring
        self.convergence_history = []
        self.stability_history = []
        
        # Mesh refinement
        self.refinement_level = 0
        self.mesh_elements = []
        
        logger.info("Multi-Physics Coupling Engine initialized")
    
    def initialize_states(self, initial_states: Dict[PhysicsDomain, torch.Tensor]):
        """Initialize state variables for all domains"""
        for domain, state in initial_states.items():
            if domain not in self.domains:
                raise ValueError(f"Domain {domain} not registered")
            
            self.domain_states[domain] = state.clone()
            self.domain_states_prev[domain] = state.clone()
        
        logger.info("Domain states initialized")
    
    def compute_coupling_terms(self, domain: PhysicsDomain) -> List[torch.Tensor]:
        """Compute coupling terms affecting a specific domain"""
        coupling_terms = []
        
        for coupling in self.coupling_terms:
            if coupling.target_domain == domain and coupling.active:
                source_state = self.domain_states[coupling.source_domain]
                target_state = self.domain_states[coupling.target_domain]
                
                # Compute coupling term
                coupling_term = coupling.coupling_function(source_state, target_state)
                coupling_term *= coupling.coupling_strength
                
                coupling_terms.append(coupling_term)
        
        return coupling_terms
    
    def solve_coupled_step(self, dt: float) -> ConvergenceResult:
        """
        Solve one coupled time step using iterative approach
        """
        start_time = time.time()
        iteration = 0
        converged = False
        residual_history = []
        
        # Store initial states for this time step
        initial_states = {domain: state.clone() for domain, state in self.domain_states.items()}
        
        while iteration < self.convergence_config.max_iterations and not converged:
            max_residual = 0.0
            
            # Solve each domain with current coupling terms
            for domain, solver in self.domains.items():
                # Store previous iteration state
                self.domain_states_prev[domain] = self.domain_states[domain].clone()
                
                # Compute coupling terms for this domain
                coupling_terms = self.compute_coupling_terms(domain)
                
                # Solve domain step
                self.domain_states[domain] = solver.solve_step(
                    self.domain_states[domain], dt, coupling_terms
                )
                
                # Compute residual for convergence check
                residual = solver.compute_residual(
                    self.domain_states[domain],
                    self.domain_states_prev[domain],
                    dt
                )
                
                max_residual = max(max_residual, residual.item())
            
            residual_history.append(max_residual)
            
            # Check convergence
            if max_residual < self.convergence_config.absolute_tolerance:
                converged = True
                status = ConvergenceStatus.CONVERGED
            elif max_residual > self.convergence_config.divergence_threshold:
                status = ConvergenceStatus.DIVERGED
                break
            
            iteration += 1
        
        if not converged and iteration >= self.convergence_config.max_iterations:
            status = ConvergenceStatus.MAX_ITERATIONS
        
        # Compute convergence rate
        convergence_rate = 0.0
        if len(residual_history) > 1:
            convergence_rate = np.log(residual_history[-1] / residual_history[0]) / len(residual_history)
        
        convergence_result = ConvergenceResult(
            status=status,
            iterations=iteration,
            final_residual=max_residual,
            convergence_rate=convergence_rate,
            time_to_convergence=time.time() - start_time,
            residual_history=residual_history
        )
        
        self.convergence_history.append(convergence_result)
        
        return convergence_result
    
    def analyze_stability(self) -> StabilityAnalysisResult:
        """
        Perform numerical stability analysis of the coupled system
        """
        try:
            # Compute system Jacobian by combining domain Jacobians
            jacobians = []
            for domain, solver in self.domains.items():
                if domain in self.domain_states:
                    jacobian = solver.get_jacobian(self.domain_states[domain])
                    jacobians.append(jacobian)
            
            if not jacobians:
                return StabilityAnalysisResult(
                    is_stable=False,
                    stability_margin=0.0,
                    critical_time_step=0.0,
                    recommendations=["No domain states available for stability analysis"]
                )
            
            # Combine Jacobians (simplified approach)
            system_jacobian = torch.block_diag(*jacobians)
            
            # Compute eigenvalues
            eigenvalues = torch.linalg.eigvals(system_jacobian)
            max_eigenvalue = torch.max(torch.real(eigenvalues))
            
            # Stability analysis
            is_stable = max_eigenvalue.item() < 0
            stability_margin = -max_eigenvalue.item() if is_stable else max_eigenvalue.item()
            
            # Critical time step (CFL condition)
            if max_eigenvalue.item() != 0:
                critical_time_step = 2.0 / abs(max_eigenvalue.item())
            else:
                critical_time_step = float('inf')
            
            # Condition number
            condition_number = torch.linalg.cond(system_jacobian).item()
            
            # Generate recommendations
            recommendations = []
            if not is_stable:
                recommendations.append("System is unstable - reduce time step")
            if condition_number > 1e12:
                recommendations.append("System is ill-conditioned - check physics parameters")
            if critical_time_step < self.current_dt:
                recommendations.append(f"Time step too large - reduce to {critical_time_step:.2e}")
            
            result = StabilityAnalysisResult(
                is_stable=is_stable,
                stability_margin=stability_margin,
                critical_time_step=critical_time_step,
                eigenvalue_spectrum=eigenvalues,
                condition_number=condition_number,
                recommendations=recommendations
            )
            
            self.stability_history.append(result)
            
            return result
            
        except Exception as e:
            logger.error(f"Stability analysis failed: {e}")
            return StabilityAnalysisResult(
                is_stable=False,
                stability_margin=0.0,
                critical_time_step=0.0,
                recommendations=[f"Stability analysis failed: {str(e)}"]
            )
    
    def adapt_time_step(self, convergence_result: ConvergenceResult, stability_result: StabilityAnalysisResult):
        """
        Adapt time step based on convergence and stability analysis
        """
        old_dt = self.current_dt
        
        # Factor based on convergence
        convergence_factor = 1.0
        if convergence_result.status == ConvergenceStatus.CONVERGED:
            if convergence_result.iterations < 5:
                convergence_factor = min(self.time_step_config.max_step_increase, 1.2)
            elif convergence_result.iterations > 20:
                convergence_factor = max(self.time_step_config.max_step_decrease, 0.8)
        elif convergence_result.status == ConvergenceStatus.NOT_CONVERGED:
            convergence_factor = self.time_step_config.max_step_decrease
        elif convergence_result.status == ConvergenceStatus.DIVERGED:
            convergence_factor = 0.5
        
        # Factor based on stability
        stability_factor = 1.0
        if not stability_result.is_stable:
            stability_factor = 0.5
        elif stability_result.critical_time_step < self.current_dt:
            stability_factor = stability_result.critical_time_step / self.current_dt * 0.9
        
        # Apply safety factor
        total_factor = convergence_factor * stability_factor * self.time_step_config.safety_factor
        
        # Update time step
        self.current_dt *= total_factor
        
        # Enforce limits
        self.current_dt = max(self.current_dt, self.time_step_config.min_dt)
        self.current_dt = min(self.current_dt, self.time_step_config.max_dt)
        
        self.dt_history.append(self.current_dt)
        
        if abs(self.current_dt - old_dt) / old_dt > 0.1:
            logger.info(f"Time step adapted: {old_dt:.2e} -> {self.current_dt:.2e}")
    
