class PhysicsDomain(str, Enum):
    """Types of physics domains for multi-physics coupling"""
    THERMAL = "thermal"
    MECHANICAL = "mechanical"
    CHEMICAL = "chemical"
    ELECTROMAGNETIC = "electromagnetic"
    FLUID_DYNAMICS = "fluid_dynamics"
    GEOCHEMICAL = "geochemical"


class CouplingType(str, Enum):
    """Types of coupling between physics domains"""
    ONE_WAY = "one_way"          # A affects B, but B doesn't affect A
    TWO_WAY = "two_way"          # A affects B and B affects A
    FULLY_COUPLED = "fully_coupled"  # All domains affect each other simultaneously


class TimeSteppingMethod(str, Enum):
    """Time stepping methods for multi-physics coupling"""
    EXPLICIT_EULER = "explicit_euler"
    IMPLICIT_EULER = "implicit_euler"
    RUNGE_KUTTA_4 = "runge_kutta_4"
    ADAPTIVE_RK45 = "adaptive_rk45"
    BACKWARD_DIFFERENTIATION = "backward_differentiation"


class ConvergenceStatus(str, Enum):
    """Convergence status for coupled simulations"""
    CONVERGED = "converged"
    NOT_CONVERGED = "not_converged"
    DIVERGED = "diverged"
    MAX_ITERATIONS = "max_iterations"


@dataclass
class CouplingTerm:
