# Factory function for creating complete multi-physics engine
def create_multi_physics_engine(
    geological_process: GeologicalProcess,
    domain_configs: Optional[Dict[PhysicsDomain, Dict[str, Any]]] = None,
    coupling_configs: Optional[List[Dict[str, Any]]] = None
) -> MultiPhysicsCouplingEngine:
    """
    Create a complete multi-physics coupling engine for geological processes
    
    Args:
        geological_process: Type of geological process to model
        domain_configs: Configuration for each physics domain
        coupling_configs: Configuration for coupling terms
        
    Returns:
        Configured multi-physics coupling engine
    """
    # Default domain configurations
    if domain_configs is None:
        domain_configs = {
            PhysicsDomain.THERMAL: {'thermal_diffusivity': 1e-6, 'heat_capacity': 1000.0},
            PhysicsDomain.MECHANICAL: {'youngs_modulus': 70e9, 'poisson_ratio': 0.3, 'density': 2700.0},
            PhysicsDomain.CHEMICAL: {'diffusion_coefficient': 1e-9, 'reaction_rate': 1e-3},
            PhysicsDomain.ELECTROMAGNETIC: {'permittivity': 8.854e-12, 'permeability': 4e-7 * np.pi}
        }
    
    # Create domain solvers
    domains = {}
    for domain, config in domain_configs.items():
        if domain == PhysicsDomain.THERMAL:
            domains[domain] = ThermalSolver(**config)
        elif domain == PhysicsDomain.MECHANICAL:
            domains[domain] = MechanicalSolver(**config)
        elif domain == PhysicsDomain.CHEMICAL:
            domains[domain] = ChemicalSolver(**config)
        elif domain == PhysicsDomain.ELECTROMAGNETIC:
            domains[domain] = ElectromagneticSolver(**config)
    
    # Create coupling terms
    coupling_terms = []
    if PhysicsDomain.THERMAL in domains and PhysicsDomain.MECHANICAL in domains:
        coupling_terms.extend(create_thermal_mechanical_coupling())
    if PhysicsDomain.CHEMICAL in domains and PhysicsDomain.THERMAL in domains:
        coupling_terms.extend(create_chemical_thermal_coupling())
    if PhysicsDomain.ELECTROMAGNETIC in domains and PhysicsDomain.THERMAL in domains:
        coupling_terms.extend(create_electromagnetic_thermal_coupling())
    
    # Default configurations
    time_step_config = AdaptiveTimeStepConfig()
    convergence_config = ConvergenceConfig()
    mesh_refinement_config = MeshRefinementConfig()
    
    # Create engine
    engine = MultiPhysicsCouplingEngine(
        domains=domains,
        coupling_terms=coupling_terms,
        time_step_config=time_step_config,
        convergence_config=convergence_config,
        mesh_refinement_config=mesh_refinement_config
    )
    
    logger.info(f"Created multi-physics engine for {geological_process.value} with {len(domains)} domains")
    
    return engine