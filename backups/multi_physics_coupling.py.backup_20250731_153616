class ChemicalSolver(PhysicsDomainSolver):
    """Chemical physics domain solver"""
    
    def __init__(self, diffusion_coefficient: float = 1e-9, reaction_rate: float = 1e-3):
        self.diffusion_coefficient = diffusion_coefficient
        self.reaction_rate = reaction_rate
    
    def solve_step(
        self, 
        concentration: torch.Tensor, 
        dt: float, 
        coupling_terms: List[torch.Tensor]
    ) -> torch.Tensor:
        """
        Solve advection-diffusion-reaction equation with coupling
        ∂c/∂t = D∇²c - kc + S_coupling
        """
        # Diffusion term
        laplacian_c = self._compute_laplacian(concentration)
        diffusion_term = self.diffusion_coefficient * laplacian_c
        
        # Reaction term (simplified first-order decay)
        reaction_term = -self.reaction_rate * concentration
        
        # Coupling terms (sources/sinks from other domains)
        coupling_source = torch.zeros_like(concentration)
        for term in coupling_terms:
            coupling_source += term
        
        # Total rate of change
        dc_dt = diffusion_term + reaction_term + coupling_source
        
        # Forward Euler step
        concentration_new = concentration + dt * dc_dt
        
        # Ensure non-negative concentrations
        concentration_new = torch.clamp(concentration_new, min=0.0)
        
        return concentration_new
    
    def compute_residual(
        self, 
        concentration: torch.Tensor, 
        concentration_prev: torch.Tensor, 
        dt: float
    ) -> torch.Tensor:
        """Compute chemical residual"""
        dc_dt_numerical = (concentration - concentration_prev) / dt
        
        laplacian_c = self._compute_laplacian(concentration)
        dc_dt_analytical = (self.diffusion_coefficient * laplacian_c - 
                           self.reaction_rate * concentration)
        
        residual = dc_dt_numerical - dc_dt_analytical
        return torch.norm(residual)
    
    def get_jacobian(self, concentration: torch.Tensor) -> torch.Tensor:
        """Get Jacobian for chemical system"""
        n = concentration.numel()
        jacobian = torch.eye(n) * (-self.reaction_rate)
        return jacobian
    
    def _compute_laplacian(self, field: torch.Tensor) -> torch.Tensor:
        """Simplified Laplacian computation"""
        return torch.zeros_like(field)


class ElectromagneticSolver(PhysicsDomainSolver):
    """Electromagnetic physics domain solver"""
    
    def __init__(self, permittivity: float = 8.854e-12, permeability: float = 4e-7 * np.pi):
        self.permittivity = permittivity
        self.permeability = permeability
        self.c = 1.0 / np.sqrt(permittivity * permeability)  # Speed of light
    
    def solve_step(
        self, 
        em_field: torch.Tensor, 
        dt: float, 
        coupling_terms: List[torch.Tensor]
    ) -> torch.Tensor:
        """
