    def simulate(
        self, 
        end_time: float, 
        output_frequency: Optional[float] = None
    ) -> Dict[str, Any]:
        """
        Run coupled multi-physics simulation
        
        Args:
            end_time: Final simulation time
            output_frequency: How often to save output (None for every step)
            
        Returns:
            Dictionary containing simulation results and diagnostics
        """
        logger.info(f"Starting multi-physics simulation to t={end_time}")
        
        # Output storage
        output_times = []
        output_states = {domain: [] for domain in self.domains}
        
        # Simulation loop
        while self.current_time < end_time:
            # Adjust final time step if needed
            if self.current_time + self.current_dt > end_time:
                self.current_dt = end_time - self.current_time
            
            # Solve coupled step
            convergence_result = self.solve_coupled_step(self.current_dt)
            
            # Stability analysis
            stability_result = self.analyze_stability()
            
            # Check for simulation failure
            if convergence_result.status == ConvergenceStatus.DIVERGED:
                logger.error("Simulation diverged - stopping")
                break
            
            # Adapt time step
            self.adapt_time_step(convergence_result, stability_result)
            
            # Check mesh refinement
            if self.mesh_refinement_config and self.current_time > 0:
                self.refine_mesh()
            
            # Update time
            self.current_time += self.current_dt
            self.time_history.append(self.current_time)
            
            # Save output
            if output_frequency is None or len(output_times) == 0 or \
               self.current_time - output_times[-1] >= output_frequency:
                output_times.append(self.current_time)
                for domain, state in self.domain_states.items():
                    output_states[domain].append(state.clone())
            
            # Log progress
            if len(self.time_history) % 100 == 0:
                logger.info(f"Simulation progress: t={self.current_time:.3f}/{end_time:.3f}, "
                           f"dt={self.current_dt:.2e}, "
                           f"convergence={convergence_result.status.value}")
        
        # Compile results
        results = {
            'times': output_times,
            'states': output_states,
            'time_history': self.time_history,
            'dt_history': self.dt_history,
            'convergence_history': self.convergence_history,
            'stability_history': self.stability_history,
            'final_time': self.current_time,
            'total_steps': len(self.time_history),
            'refinement_level': self.refinement_level
        }
        
        logger.info(f"Multi-physics simulation completed: {len(self.time_history)} steps, "
                   f"final time {self.current_time:.3f}")
        
        return results
    
    def get_diagnostics(self) -> Dict[str, Any]:
        """Get comprehensive simulation diagnostics"""
        diagnostics = {
            'current_time': self.current_time,
            'current_dt': self.current_dt,
            'total_steps': len(self.time_history),
            'refinement_level': self.refinement_level,
            'average_convergence_iterations': np.mean([c.iterations for c in self.convergence_history]) if self.convergence_history else 0,
            'stability_violations': sum(1 for s in self.stability_history if not s.is_stable),
            'domain_states_norm': {domain.value: torch.norm(state).item() 
                                 for domain, state in self.domain_states.items()},
            'coupling_terms_active': sum(1 for c in self.coupling_terms if c.active),
            'time_step_adaptations': len([i for i, dt in enumerate(self.dt_history[1:], 1) 
                                        if abs(dt - self.dt_history[i-1]) / self.dt_history[i-1] > 0.1])
        }
        
        return diagnostics


