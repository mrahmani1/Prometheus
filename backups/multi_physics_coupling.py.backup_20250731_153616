class MechanicalSolver(PhysicsDomainSolver):
    """Mechanical physics domain solver"""
    
    def __init__(self, youngs_modulus: float = 70e9, poisson_ratio: float = 0.3, density: float = 2700.0):
        self.youngs_modulus = youngs_modulus
        self.poisson_ratio = poisson_ratio
        self.density = density
        
        # Lamé parameters
        self.mu = youngs_modulus / (2 * (1 + poisson_ratio))
        self.lambda_param = (youngs_modulus * poisson_ratio) / ((1 + poisson_ratio) * (1 - 2 * poisson_ratio))
    
    def solve_step(
        self, 
        displacement: torch.Tensor, 
        dt: float, 
        coupling_terms: List[torch.Tensor]
    ) -> torch.Tensor:
        """
        Solve elastic deformation with coupling terms
        ρ∂²u/∂t² = μ∇²u + (λ + μ)∇(∇·u) + F_coupling
        """
        # Compute elastic forces
        laplacian_u = self._compute_laplacian(displacement)
        divergence_u = self._compute_divergence(displacement)
        div_gradient = self._compute_gradient(divergence_u)
        
        elastic_force = self.mu * laplacian_u + (self.lambda_param + self.mu) * div_gradient
        
        # Sum coupling forces (thermal expansion, electromagnetic forces, etc.)
        coupling_force = torch.zeros_like(displacement)
        for term in coupling_terms:
            # Ensure coupling term matches displacement shape
            if term.shape != displacement.shape:
                # Try to reshape or broadcast
                if term.numel() == displacement.numel():
                    term = term.view(displacement.shape)
                elif len(term.shape) < len(displacement.shape):
                    # Expand to match displacement dimensions
                    while len(term.shape) < len(displacement.shape):
                        term = term.unsqueeze(-1)
                    term = term.expand_as(displacement)
                else:
                    # Skip incompatible terms
                    continue
            coupling_force += term
        
        # Total force
        total_force = elastic_force + coupling_force
        
        # Acceleration (simplified - assumes quasi-static)
        acceleration = total_force / self.density
        
        # Update displacement (simplified integration)
        displacement_new = displacement + dt * acceleration
        
        return displacement_new
    
    def compute_residual(
        self, 
        displacement: torch.Tensor, 
        displacement_prev: torch.Tensor, 
        dt: float
    ) -> torch.Tensor:
        """Compute mechanical residual"""
        acceleration_numerical = (displacement - displacement_prev) / (dt * dt)
        
        # Compute analytical acceleration from elastic forces
        laplacian_u = self._compute_laplacian(displacement)
        divergence_u = self._compute_divergence(displacement)
        div_gradient = self._compute_gradient(divergence_u)
        
        elastic_force = self.mu * laplacian_u + (self.lambda_param + self.mu) * div_gradient
        acceleration_analytical = elastic_force / self.density
        
        residual = acceleration_numerical - acceleration_analytical
        return torch.norm(residual)
    
