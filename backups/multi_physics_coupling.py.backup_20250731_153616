class PhysicsDomainSolver(ABC):
    """Abstract base class for physics domain solvers"""
    
    @abstractmethod
    def solve_step(
        self, 
        state: torch.Tensor, 
        dt: float, 
        coupling_terms: List[torch.Tensor]
    ) -> torch.Tensor:
        """Solve one time step for this physics domain"""
        pass
    
    @abstractmethod
    def compute_residual(
        self, 
        state: torch.Tensor, 
        state_prev: torch.Tensor, 
        dt: float
    ) -> torch.Tensor:
        """Compute residual for convergence checking"""
        pass
    
    @abstractmethod
    def get_jacobian(self, state: torch.Tensor) -> torch.Tensor:
        """Get Jacobian matrix for stability analysis"""
        pass


