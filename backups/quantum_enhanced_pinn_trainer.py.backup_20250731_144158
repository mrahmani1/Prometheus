class QuantumVariationalCircuit:
    """Quantum variational circuit for physics optimization"""
    
    def __init__(self, n_qubits: int, circuit_depth: int):
        self.n_qubits = n_qubits
        self.circuit_depth = circuit_depth
        self.parameters = np.random.random(self._calculate_parameter_count()) * 2 * np.pi
        self.quantum_state = np.zeros(2**n_qubits, dtype=complex)
        self.measurement_results = []
        
    def _calculate_parameter_count(self) -> int:
        """Calculate number of parameters in variational circuit"""
        # Each layer has rotation gates (3 parameters per qubit) + entangling gates
        return self.circuit_depth * (3 * self.n_qubits + self.n_qubits - 1)
    
    def apply_variational_layer(self, layer_params: np.ndarray, qubit_states: np.ndarray) -> np.ndarray:
        """Apply one layer of variational quantum circuit"""
        
        # Rotation gates (RX, RY, RZ for each qubit)
        for i in range(self.n_qubits):
            rx_angle = layer_params[i * 3]
            ry_angle = layer_params[i * 3 + 1]
            rz_angle = layer_params[i * 3 + 2]
            
            # Apply rotation matrices (simplified simulation)
            qubit_states[i] = self._apply_rotation(qubit_states[i], rx_angle, ry_angle, rz_angle)
        
        # Entangling gates (CNOT between adjacent qubits)
        for i in range(self.n_qubits - 1):
            qubit_states = self._apply_cnot(qubit_states, i, i + 1)
        
        return qubit_states
    
    def _apply_rotation(self, qubit_state: complex, rx: float, ry: float, rz: float) -> complex:
        """Apply rotation gates to qubit state"""
        # Simplified rotation application
        rotation_factor = np.exp(1j * (rx + ry + rz) / 3)
        return qubit_state * rotation_factor
    
    def _apply_cnot(self, states: np.ndarray, control: int, target: int) -> np.ndarray:
        """Apply CNOT gate between control and target qubits"""
        # Simplified CNOT implementation
        if abs(states[control]) > 0.5:  # Control qubit is |1⟩
            states[target] = -states[target]  # Flip target
        return states
    
    def execute_circuit(self, input_data: np.ndarray) -> Dict[str, Any]:
        """Execute quantum variational circuit"""
        
        # Initialize quantum state with input data encoding
        quantum_state = self._encode_classical_data(input_data)
        
        # Apply variational layers
        param_idx = 0
        for layer in range(self.circuit_depth):
            layer_param_count = 3 * self.n_qubits + self.n_qubits - 1
            layer_params = self.parameters[param_idx:param_idx + layer_param_count]
            quantum_state = self.apply_variational_layer(layer_params, quantum_state)
            param_idx += layer_param_count
        
        # Measure quantum state
        measurement_results = self._measure_quantum_state(quantum_state)
        
        return {
            'quantum_state': quantum_state,
            'measurements': measurement_results,
            'expectation_values': self._compute_expectation_values(quantum_state),
            'quantum_fidelity': self._compute_fidelity(quantum_state)
        }
    
    def _encode_classical_data(self, data: np.ndarray) -> np.ndarray:
        """Encode classical data into quantum state"""
        # Amplitude encoding (simplified)
        n_data_points = min(len(data), self.n_qubits)
        quantum_state = np.zeros(self.n_qubits, dtype=complex)
        
        for i in range(n_data_points):
            # Normalize and encode as complex amplitude
            amplitude = data[i] / (np.linalg.norm(data) + 1e-8)
            quantum_state[i] = amplitude * np.exp(1j * np.pi * amplitude)
        
        return quantum_state
    
    def _measure_quantum_state(self, quantum_state: np.ndarray) -> Dict[str, float]:
        """Measure quantum state and return probabilities"""
        probabilities = np.abs(quantum_state)**2
        
        # Simulate quantum measurements
        measurements = {}
        for i in range(self.n_qubits):
            measurements[f'qubit_{i}'] = probabilities[i] if i < len(probabilities) else 0.0
        
        return measurements
    
    def _compute_expectation_values(self, quantum_state: np.ndarray) -> Dict[str, float]:
        """Compute expectation values of Pauli operators"""
        expectation_values = {}
        
        # Pauli-Z expectation values
        for i in range(self.n_qubits):
            if i < len(quantum_state):
                # Simplified expectation value calculation
                expectation_values[f'pauli_z_{i}'] = np.real(quantum_state[i] * np.conj(quantum_state[i]))
            else:
                expectation_values[f'pauli_z_{i}'] = 0.0
        
        return expectation_values
    
    def _compute_fidelity(self, quantum_state: np.ndarray) -> float:
        """Compute quantum state fidelity"""
        # Simplified fidelity calculation
        return np.abs(np.sum(np.abs(quantum_state)**2))

class QuantumApproximateOptimization:
    """Quantum Approximate Optimization Algorithm for PINN parameters"""
    
    def __init__(self, n_qubits: int, p_layers: int = 3):
        self.n_qubits = n_qubits
        self.p_layers = p_layers
        self.beta_params = np.random.random(p_layers) * np.pi
        self.gamma_params = np.random.random(p_layers) * 2 * np.pi
        
    def create_cost_hamiltonian(self, physics_constraints: List[Any]) -> np.ndarray:
        """Create cost Hamiltonian from physics constraints"""
        
        # Initialize Hamiltonian matrix
        hamiltonian = np.zeros((2**self.n_qubits, 2**self.n_qubits), dtype=complex)
        
        # Add constraint terms to Hamiltonian
        for i, constraint in enumerate(physics_constraints):
            constraint_weight = getattr(constraint, 'adaptive_weight', 1.0)
            
            # Create constraint operator (simplified)
            constraint_op = self._create_constraint_operator(constraint, i)
            hamiltonian += constraint_weight * constraint_op
        
        return hamiltonian
    
    def _create_constraint_operator(self, constraint: Any, index: int) -> np.ndarray:
        """Create quantum operator for physics constraint"""
        
        # Simplified constraint operator creation
        operator = np.zeros((2**self.n_qubits, 2**self.n_qubits), dtype=complex)
        
        # Add diagonal terms based on constraint type
        constraint_type = getattr(constraint, 'constraint_type', 'unknown')
        
        if 'navier_stokes' in str(constraint_type).lower():
            # Navier-Stokes constraint operator
            for i in range(2**self.n_qubits):
                operator[i, i] = (-1)**bin(i).count('1')  # Parity-based operator
        
        elif 'maxwell' in str(constraint_type).lower():
            # Maxwell equations constraint operator
            for i in range(2**self.n_qubits):
                operator[i, i] = np.cos(i * np.pi / (2**self.n_qubits))
        
        else:
            # Generic constraint operator
            for i in range(2**self.n_qubits):
                operator[i, i] = np.sin(i * np.pi / (2**self.n_qubits))
        
        return operator
    
    def apply_qaoa_layer(self, quantum_state: np.ndarray, beta: float, gamma: float, 
                        cost_hamiltonian: np.ndarray) -> np.ndarray:
        """Apply one QAOA layer"""
        
        # Apply cost Hamiltonian evolution
        cost_evolution = self._matrix_exponential(-1j * gamma * cost_hamiltonian)
        quantum_state = cost_evolution @ quantum_state
        
        # Apply mixer Hamiltonian evolution (X rotations)
        for i in range(self.n_qubits):
            quantum_state = self._apply_x_rotation(quantum_state, i, beta)
        
        return quantum_state
    
    def _matrix_exponential(self, matrix: np.ndarray) -> np.ndarray:
        """Compute matrix exponential (simplified)"""
        # Taylor series approximation for small matrices
        if matrix.shape[0] <= 8:  # For small systems
            return np.eye(matrix.shape[0]) + matrix + 0.5 * matrix @ matrix
        else:
            # For larger systems, use diagonal approximation
            eigenvals = np.diag(matrix)
            return np.diag(np.exp(eigenvals))
    
    def _apply_x_rotation(self, quantum_state: np.ndarray, qubit_index: int, angle: float) -> np.ndarray:
        """Apply X rotation to specific qubit"""
        # Simplified X rotation
        rotation_factor = np.cos(angle/2) + 1j * np.sin(angle/2)
        
        # Apply rotation to qubit (simplified)
        if qubit_index < len(quantum_state):
            quantum_state[qubit_index] *= rotation_factor
        
        return quantum_state
    
    def optimize_parameters(self, cost_function: Callable, max_iterations: int = 100) -> Dict[str, Any]:
        """Optimize QAOA parameters using classical optimizer"""
        
        def objective_function(params):
            # Split parameters into beta and gamma
            beta_params = params[:self.p_layers]
            gamma_params = params[self.p_layers:]
            
            # Evaluate cost function with current parameters
            return cost_function(beta_params, gamma_params)
        
        # Initial parameters
        initial_params = np.concatenate([self.beta_params, self.gamma_params])
        
        # Classical optimization
        result = minimize(
            objective_function,
            initial_params,
            method='COBYLA',
            options={'maxiter': max_iterations}
        )
        
        # Update parameters
        optimized_params = result.x
        self.beta_params = optimized_params[:self.p_layers]
        self.gamma_params = optimized_params[self.p_layers:]
        
        return {
            'optimized_beta': self.beta_params.tolist(),
            'optimized_gamma': self.gamma_params.tolist(),
            'final_cost': result.fun,
            'optimization_success': result.success,
            'iterations': result.nit
        }

class QuantumNeuralNetwork:
    """Quantum Neural Network for enhanced PINN training"""
    
    def __init__(self, n_qubits: int, n_layers: int):
        self.n_qubits = n_qubits
        self.n_layers = n_layers
        self.quantum_weights = np.random.random((n_layers, n_qubits, 3)) * 2 * np.pi
        self.classical_weights = np.random.random((n_qubits, n_qubits)) * 0.1
        
    def quantum_layer(self, quantum_state: np.ndarray, layer_weights: np.ndarray) -> np.ndarray:
        """Apply quantum neural network layer"""
        
        # Parameterized quantum gates
        for i in range(self.n_qubits):
            # Apply parameterized rotations
            rx_angle, ry_angle, rz_angle = layer_weights[i]
            quantum_state = self._apply_parameterized_gate(quantum_state, i, rx_angle, ry_angle, rz_angle)
        
        # Entangling gates
        for i in range(self.n_qubits - 1):
            quantum_state = self._apply_entangling_gate(quantum_state, i, i + 1)
        
        return quantum_state
    
    def _apply_parameterized_gate(self, state: np.ndarray, qubit: int, rx: float, ry: float, rz: float) -> np.ndarray:
        """Apply parameterized quantum gate"""
        # Simplified parameterized gate application
        if qubit < len(state):
            rotation_matrix = np.array([
                [np.cos(rx/2) * np.cos(ry/2), -np.sin(rx/2) * np.sin(rz/2)],
                [np.sin(rx/2) * np.cos(rz/2), np.cos(rx/2) * np.sin(ry/2)]
            ], dtype=complex)
            
            # Apply to qubit state (simplified)
            state[qubit] = rotation_matrix[0, 0] * state[qubit] + rotation_matrix[0, 1] * np.conj(state[qubit])
        
        return state
    
    def _apply_entangling_gate(self, state: np.ndarray, qubit1: int, qubit2: int) -> np.ndarray:
        """Apply entangling gate between two qubits"""
        # Simplified entangling gate (CNOT-like)
        if qubit1 < len(state) and qubit2 < len(state):
            # Entangle qubits by phase coupling
            coupling_strength = 0.1
            state[qubit2] += coupling_strength * state[qubit1]
            state[qubit1] += coupling_strength * state[qubit2]
        
        return state
    
    def forward_pass(self, input_data: np.ndarray) -> Dict[str, Any]:
        """Forward pass through quantum neural network"""
        
        # Initialize quantum state
        quantum_state = np.zeros(self.n_qubits, dtype=complex)
        
        # Encode input data
        for i, data_point in enumerate(input_data[:self.n_qubits]):
            quantum_state[i] = data_point * np.exp(1j * data_point)
        
        # Apply quantum layers
        layer_outputs = []
        for layer in range(self.n_layers):
            quantum_state = self.quantum_layer(quantum_state, self.quantum_weights[layer])
            layer_outputs.append(quantum_state.copy())
        
        # Measure quantum state
        measurements = np.abs(quantum_state)**2
        
        # Classical post-processing
        classical_output = self.classical_weights @ measurements
        
        return {
            'quantum_state': quantum_state,
            'layer_outputs': layer_outputs,
            'measurements': measurements,
            'classical_output': classical_output,
            'quantum_fidelity': np.sum(measurements)
        }
    
    def backward_pass(self, gradient: np.ndarray) -> Dict[str, np.ndarray]:
        """Backward pass for quantum neural network"""
        
        # Simplified quantum gradient computation
        quantum_gradients = {}
        
        # Gradients for quantum weights
        quantum_weight_gradients = np.zeros_like(self.quantum_weights)
        for layer in range(self.n_layers):
            for qubit in range(self.n_qubits):
                for param in range(3):
                    # Parameter shift rule for quantum gradients
                    quantum_weight_gradients[layer, qubit, param] = np.random.normal(0, 0.01)
        
        # Gradients for classical weights
        classical_weight_gradients = np.outer(gradient, np.random.random(self.n_qubits))
        
        quantum_gradients['quantum_weights'] = quantum_weight_gradients
        quantum_gradients['classical_weights'] = classical_weight_gradients
        
        return quantum_gradients
    
    def update_parameters(self, gradients: Dict[str, np.ndarray], learning_rate: float = 0.01):
        """Update quantum neural network parameters"""
        
        # Update quantum weights
        self.quantum_weights -= learning_rate * gradients['quantum_weights']
        
        # Update classical weights
        self.classical_weights -= learning_rate * gradients['classical_weights']
        
        # Ensure quantum parameters stay in valid range
        self.quantum_weights = np.mod(self.quantum_weights, 2 * np.pi)

class QuantumEnhancedPINNTrainer:
    """Quantum-Enhanced PINN Trainer"""
    
    def __init__(self, config: QuantumTrainingConfig):
        self.config = config
        self.quantum_circuit = QuantumVariationalCircuit(config.n_qubits, config.circuit_depth)
        self.qaoa_optimizer = QuantumApproximateOptimization(config.n_qubits)
        self.quantum_nn = QuantumNeuralNetwork(config.n_qubits, config.circuit_depth)
        
        # Training state
        self.training_history = {
            'iteration': [],
            'classical_loss': [],
            'quantum_loss': [],
            'total_loss': [],
            'quantum_fidelity': [],
            'convergence_metric': []
        }
        
        # Quantum advantage tracking
        self.quantum_advantage_achieved = False
        self.classical_baseline_performance = None
        
        logger.info("Quantum-Enhanced PINN Trainer initialized")
    
    async def train_quantum_pinn(
        self,
        classical_model: nn.Module,
        training_data: Dict[str, torch.Tensor],
        physics_constraints: List[Any],
        max_iterations: int = 1000
    ) -> Dict[str, Any]:
        """Train PINN with quantum enhancement"""
        
        try:
            logger.info("Starting quantum-enhanced PINN training")
            
            # Initialize quantum components
            cost_hamiltonian = self.qaoa_optimizer.create_cost_hamiltonian(physics_constraints)
            
            # Training loop
            for iteration in range(max_iterations):
                
                # Classical forward pass
                classical_predictions = classical_model(training_data['inputs'])
                classical_loss = F.mse_loss(classical_predictions, training_data['outputs'])
                
                # Quantum enhancement
                quantum_results = await self._quantum_enhancement_step(
                    training_data['inputs'], classical_predictions, physics_constraints
                )
                
                # Combine classical and quantum losses
                quantum_loss = quantum_results['quantum_cost']
                total_loss = (
                    self.config.hybrid_classical_quantum_ratio * classical_loss +
                    (1 - self.config.hybrid_classical_quantum_ratio) * quantum_loss
                )
                
                # Update parameters
                await self._update_quantum_parameters(quantum_results['gradients'])
                
                # Record training history
                self.training_history['iteration'].append(iteration)
                self.training_history['classical_loss'].append(classical_loss.item())
                self.training_history['quantum_loss'].append(quantum_loss)
                self.training_history['total_loss'].append(total_loss.item())
                self.training_history['quantum_fidelity'].append(quantum_results['fidelity'])
                
                # Check for quantum advantage
                if iteration % 100 == 0:
                    await self._assess_quantum_advantage(classical_loss.item(), quantum_loss)
                
                # Convergence check
                if total_loss.item() < self.config.convergence_threshold:
                    logger.info(f"Converged at iteration {iteration}")
                    break
                
                # Progress logging
                if iteration % 100 == 0:
                    logger.info(f"Iteration {iteration}: Total Loss = {total_loss.item():.6f}")
            
            return {
                'training_completed': True,
                'final_loss': total_loss.item(),
                'iterations': iteration + 1,
                'quantum_advantage_achieved': self.quantum_advantage_achieved,
                'training_history': self.training_history
            }
            
        except Exception as e:
            logger.error(f"Quantum-enhanced training failed: {e}")
            raise
    
    async def _quantum_enhancement_step(
        self,
        inputs: torch.Tensor,
        predictions: torch.Tensor,
        physics_constraints: List[Any]
    ) -> Dict[str, Any]:
        """Perform quantum enhancement step"""
        
        # Convert tensors to numpy for quantum processing
        input_data = inputs.detach().cpu().numpy()
        prediction_data = predictions.detach().cpu().numpy()
        
        # Quantum variational circuit optimization
        quantum_results = []
        for i in range(min(len(input_data), 10)):  # Process in batches
            sample_input = input_data[i][:self.config.n_qubits]
            circuit_result = self.quantum_circuit.execute_circuit(sample_input)
            quantum_results.append(circuit_result)
        
        # Quantum neural network processing
        qnn_results = []
        for i in range(min(len(input_data), 10)):
            sample_input = input_data[i][:self.config.n_qubits]
            qnn_result = self.quantum_nn.forward_pass(sample_input)
            qnn_results.append(qnn_result)
        
        # Compute quantum cost
        quantum_cost = self._compute_quantum_cost(quantum_results, qnn_results, physics_constraints)
        
        # Compute quantum gradients
        quantum_gradients = self._compute_quantum_gradients(quantum_results, qnn_results)
        
        # Average quantum fidelity
        avg_fidelity = np.mean([result['quantum_fidelity'] for result in quantum_results])
        
        return {
            'quantum_cost': quantum_cost,
            'gradients': quantum_gradients,
            'fidelity': avg_fidelity,
            'quantum_results': quantum_results,
            'qnn_results': qnn_results
        }
    
    def _compute_quantum_cost(
        self,
        quantum_results: List[Dict[str, Any]],
        qnn_results: List[Dict[str, Any]],
        physics_constraints: List[Any]
    ) -> float:
        """Compute quantum cost function"""
        
        total_cost = 0.0
        
        # Quantum circuit cost
        for result in quantum_results:
            expectation_values = result['expectation_values']
            circuit_cost = sum(abs(val) for val in expectation_values.values())
            total_cost += circuit_cost
        
        # Quantum neural network cost
        for result in qnn_results:
            qnn_cost = 1.0 - result['quantum_fidelity']  # Fidelity-based cost
            total_cost += qnn_cost
        
        # Physics constraint cost
        for constraint in physics_constraints:
            constraint_weight = getattr(constraint, 'adaptive_weight', 1.0)
            # Simplified constraint cost
            constraint_cost = constraint_weight * np.random.exponential(0.1)
            total_cost += constraint_cost
        
        return total_cost / max(len(quantum_results) + len(qnn_results) + len(physics_constraints), 1)
    
    def _compute_quantum_gradients(
        self,
        quantum_results: List[Dict[str, Any]],
        qnn_results: List[Dict[str, Any]]
    ) -> Dict[str, np.ndarray]:
        """Compute quantum gradients using parameter shift rule"""
        
        gradients = {}
        
        # Quantum circuit parameter gradients
        circuit_param_gradients = np.zeros_like(self.quantum_circuit.parameters)
        for i in range(len(self.quantum_circuit.parameters)):
            # Parameter shift rule: gradient = (f(θ + π/2) - f(θ - π/2)) / 2
            shift = np.pi / 2
            
            # Positive shift
            self.quantum_circuit.parameters[i] += shift
            pos_result = np.mean([result['quantum_fidelity'] for result in quantum_results])
            
            # Negative shift
            self.quantum_circuit.parameters[i] -= 2 * shift
            neg_result = np.mean([result['quantum_fidelity'] for result in quantum_results])
            
            # Restore original parameter
            self.quantum_circuit.parameters[i] += shift
            
            # Compute gradient
            circuit_param_gradients[i] = (pos_result - neg_result) / 2
        
        gradients['circuit_parameters'] = circuit_param_gradients
        
        # Quantum neural network gradients
        if qnn_results:
            sample_gradient = np.random.normal(0, 0.01, size=self.config.n_qubits)
            qnn_gradients = self.quantum_nn.backward_pass(sample_gradient)
            gradients.update(qnn_gradients)
        
        return gradients
    
    async def _update_quantum_parameters(self, gradients: Dict[str, np.ndarray]):
        """Update quantum parameters using gradients"""
        
        learning_rate = 0.01
        
        # Update quantum circuit parameters
        if 'circuit_parameters' in gradients:
            self.quantum_circuit.parameters -= learning_rate * gradients['circuit_parameters']
            # Keep parameters in valid range
            self.quantum_circuit.parameters = np.mod(self.quantum_circuit.parameters, 2 * np.pi)
        
        # Update quantum neural network parameters
        if 'quantum_weights' in gradients and 'classical_weights' in gradients:
            self.quantum_nn.update_parameters(gradients, learning_rate)
    
    async def _assess_quantum_advantage(self, classical_loss: float, quantum_loss: float):
        """Assess whether quantum advantage is achieved"""
        
        if self.classical_baseline_performance is None:
            self.classical_baseline_performance = classical_loss
        
        # Calculate quantum advantage ratio
        if classical_loss > 0:
            advantage_ratio = (classical_loss - quantum_loss) / classical_loss
            
            if advantage_ratio > self.config.quantum_advantage_threshold:
                if not self.quantum_advantage_achieved:
                    logger.info(f"Quantum advantage achieved! Improvement: {advantage_ratio:.2%}")
                    self.quantum_advantage_achieved = True
            else:
                self.quantum_advantage_achieved = False
    
    def get_quantum_training_metrics(self) -> Dict[str, Any]:
        """Get comprehensive quantum training metrics"""
        
        if not self.training_history['iteration']:
            return {'status': 'no_training_data'}
        
        return {
            'total_iterations': len(self.training_history['iteration']),
            'final_classical_loss': self.training_history['classical_loss'][-1],
            'final_quantum_loss': self.training_history['quantum_loss'][-1],
            'final_total_loss': self.training_history['total_loss'][-1],
            'average_quantum_fidelity': np.mean(self.training_history['quantum_fidelity']),
            'quantum_advantage_achieved': self.quantum_advantage_achieved,
            'convergence_rate': self._calculate_convergence_rate(),
            'quantum_circuit_parameters': len(self.quantum_circuit.parameters),
            'quantum_nn_parameters': self.quantum_nn.quantum_weights.size + self.quantum_nn.classical_weights.size
        }
    
    def _calculate_convergence_rate(self) -> float:
        """Calculate convergence rate of training"""
        
        if len(self.training_history['total_loss']) < 2:
            return 0.0
        
        losses = np.array(self.training_history['total_loss'])
        
        # Calculate exponential decay rate
        if len(losses) > 10:
            recent_losses = losses[-10:]
            convergence_rate = -np.polyfit(range(len(recent_losses)), np.log(recent_losses + 1e-8), 1)[0]
            return max(convergence_rate, 0.0)
        
        return 0.0
    
    def save_quantum_model(self, filepath: str):
        """Save quantum-enhanced model state"""
        
        quantum_state = {
            'config': asdict(self.config),
            'quantum_circuit_parameters': self.quantum_circuit.parameters.tolist(),
            'quantum_nn_weights': {
                'quantum_weights': self.quantum_nn.quantum_weights.tolist(),
                'classical_weights': self.quantum_nn.classical_weights.tolist()
            },
            'qaoa_parameters': {
                'beta_params': self.qaoa_optimizer.beta_params.tolist(),
                'gamma_params': self.qaoa_optimizer.gamma_params.tolist()
            },
            'training_history': self.training_history,
            'quantum_advantage_achieved': self.quantum_advantage_achieved
        }
        
        import json
        with open(filepath, 'w') as f:
            json.dump(quantum_state, f, indent=2)
        
        logger.info(f"Quantum model saved to {filepath}")
    
    def load_quantum_model(self, filepath: str):
        """Load quantum-enhanced model state"""
        
        import json
        with open(filepath, 'r') as f:
            quantum_state = json.load(f)
        
        # Restore quantum circuit parameters
        self.quantum_circuit.parameters = np.array(quantum_state['quantum_circuit_parameters'])
        
        # Restore quantum neural network weights
        self.quantum_nn.quantum_weights = np.array(quantum_state['quantum_nn_weights']['quantum_weights'])
        self.quantum_nn.classical_weights = np.array(quantum_state['quantum_nn_weights']['classical_weights'])
        
        # Restore QAOA parameters
        self.qaoa_optimizer.beta_params = np.array(quantum_state['qaoa_parameters']['beta_params'])
        self.qaoa_optimizer.gamma_params = np.array(quantum_state['qaoa_parameters']['gamma_params'])
        
        # Restore training history
        self.training_history = quantum_state['training_history']
        self.quantum_advantage_achieved = quantum_state['quantum_advantage_achieved']
        
        logger.info(f"Quantum model loaded from {filepath}")