                    'original_code_snippet': r.original_code[:100] + '...' if len(r.original_code) > 100 else r.original_code
                }
                for r in failed_replacements
            ],
            'backup_directory': self.backup_dir,
            'timestamp': datetime.now().isoformat()
        }
        
        return report

