    async def _mintpy_time_series(self, interferograms: List[Dict[str, Any]], 
                                params: InSARParameters) -> Dict[str, Any]:
        """Time series analysis using MintPy"""
        # This would use the actual MintPy library
        # For now, return simulated time series
        
        dates = []
        phases = []
        
        for ifg_data in interferograms:
            master_date = await self._extract_acquisition_date(ifg_data["master"])
            slave_date = await self._extract_acquisition_date(ifg_data["slave"])
            
            dates.extend([master_date, slave_date])
            phases.append(ifg_data.get("corrected_phase", ifg_data["unwrapped_phase"]))
        
        # Remove duplicates and sort
        unique_dates = sorted(list(set(dates)))
        
        # Create time series
        time_series = {
            "dates": [d.isoformat() for d in unique_dates],
            "displacement": np.random.cumsum(np.random.normal(0, 0.001, len(unique_dates))),
            "velocity": np.random.normal(0, 0.01, len(unique_dates)),
            "uncertainty": np.random.uniform(0.001, 0.005, len(unique_dates))
        }
        
        return time_series
    
    async def _simple_time_series(self, interferograms: List[Dict[str, Any]], 
                                params: InSARParameters) -> Dict[str, Any]:
        """Simple time series analysis"""
        # Extract temporal information
        dates = []
        displacements = []
        
        for ifg_data in interferograms:
            master_date = await self._extract_acquisition_date(ifg_data["master"])
            slave_date = await self._extract_acquisition_date(ifg_data["slave"])
            phase = ifg_data.get("corrected_phase", ifg_data["unwrapped_phase"])
            
            # Convert phase to displacement (simplified)
            wavelength = 0.056  # Sentinel-1 C-band wavelength in meters
            displacement = phase * wavelength / (4 * np.pi)
            
            dates.extend([master_date, slave_date])
            displacements.extend([0, np.mean(displacement)])  # Simplified
        
        # Sort by date
        sorted_data = sorted(zip(dates, displacements))
        dates, displacements = zip(*sorted_data)
        
        return {
            "dates": [d.isoformat() for d in dates],
            "displacement": list(displacements),
            "velocity": np.gradient(displacements),
            "uncertainty": [0.002] * len(dates)  # 2mm uncertainty
        }
    
    async def _detect_volcanic_deformation(self, time_series: Dict[str, Any], 
                                         target_volcano: str) -> List[VolcanicDeformationSignal]:
        """Detect volcanic deformation signals"""
        signals = []
        
        displacements = np.array(time_series["displacement"])
        dates = [datetime.fromisoformat(d) for d in time_series["dates"]]
        
        # Detect significant deformation
        if len(displacements) > 5:
            # Calculate velocity
            time_days = np.array([(d - dates[0]).days for d in dates])
            velocity = np.polyfit(time_days, displacements, 1)[0]  # mm/day
            
            # Convert to mm/year
            velocity_per_year = velocity * 365.25
            
            # Detect if significant
            if abs(velocity_per_year) > 5:  # 5 mm/year threshold
                direction = "uplift" if velocity_per_year > 0 else "subsidence"
                
                # Estimate source parameters
                source_depth = await self._estimate_source_depth(displacements, target_volcano)
                volume_change = await self._estimate_volume_change(velocity_per_year, source_depth)
                
                signal = VolcanicDeformationSignal(
                    location=self._get_volcano_location(target_volcano),
                    magnitude=abs(velocity_per_year),
                    direction=direction,
                    spatial_extent=self._estimate_spatial_extent(target_volcano),
                    temporal_pattern="linear",
                    confidence=0.8,
                    source_depth=source_depth,
                    source_volume_change=volume_change,
                    magma_intrusion_probability=self._calculate_intrusion_probability(
                        velocity_per_year, source_depth
                    )
                )
                
                signals.append(signal)
        
        return signals
    
