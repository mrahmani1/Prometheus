    async def _estimate_volume_change(self, velocity: float, depth: float) -> float:
        """Estimate volume change from deformation"""
        # Simplified Mogi model
        # ΔV = (π * r² * u) / (3 * (1 - ν) * depth)
        # where r is deformation radius, u is displacement, ν is Poisson's ratio
        
        poisson_ratio = 0.25
        deformation_radius = 5000  # 5 km
        displacement = velocity / 365.25 / 1000  # Convert mm/year to m/day
        
        volume_change = (np.pi * deformation_radius**2 * displacement) / (3 * (1 - poisson_ratio) * depth * 1000)
        
        return volume_change  # m³/day
    
    def _calculate_intrusion_probability(self, velocity: float, depth: float) -> float:
        """Calculate probability of magmatic intrusion"""
        # Empirical model based on deformation characteristics
        
        # Higher velocity and shallower depth increase probability
        velocity_factor = min(1.0, abs(velocity) / 50.0)  # Normalize to 50 mm/year
        depth_factor = max(0.1, 1.0 - depth / 20.0)  # Deeper sources less likely
        
        probability = velocity_factor * depth_factor
        
        return min(1.0, probability)
    
    async def _model_deformation_sources(self, signals: List[VolcanicDeformationSignal], 
                                       target_volcano: str) -> List[Dict[str, Any]]:
        """Model deformation sources using various techniques"""
        source_models = []
        
        for signal in signals:
            # Mogi point source model
            mogi_model = await self._mogi_source_model(signal)
            source_models.append(mogi_model)
            
            # Sill intrusion model
            sill_model = await self._sill_intrusion_model(signal)
            source_models.append(sill_model)
            
            # Dike intrusion model
            dike_model = await self._dike_intrusion_model(signal)
            source_models.append(dike_model)
        
        return source_models
    
    async def _mogi_source_model(self, signal: VolcanicDeformationSignal) -> Dict[str, Any]:
        """Mogi point source model"""
        return {
            "model_type": "mogi_point_source",
            "location": signal.location,
            "depth": signal.source_depth,
            "volume_change": signal.source_volume_change,
            "pressure_change": signal.source_volume_change * 1e9,  # Simplified
            "fit_quality": 0.85,
            "uncertainty": {
                "depth": signal.source_depth * 0.2,
                "volume_change": signal.source_volume_change * 0.3
            }
        }
    
    async def _sill_intrusion_model(self, signal: VolcanicDeformationSignal) -> Dict[str, Any]:
        """Sill intrusion model"""
        return {
            "model_type": "sill_intrusion",
            "location": signal.location,
            "depth": signal.source_depth,
            "length": signal.spatial_extent * 1000,  # Convert km to m
            "width": signal.spatial_extent * 500,
            "opening": signal.source_volume_change / (signal.spatial_extent * 1000 * signal.spatial_extent * 500),
            "strike": 0,  # N-S orientation
            "dip": 0,     # Horizontal
            "fit_quality": 0.78
        }
    
    async def _dike_intrusion_model(self, signal: VolcanicDeformationSignal) -> Dict[str, Any]:
        """Dike intrusion model"""
        return {
            "model_type": "dike_intrusion",
            "location": signal.location,
            "top_depth": signal.source_depth - 1,
            "bottom_depth": signal.source_depth + 2,
            "length": signal.spatial_extent * 1000,
            "opening": signal.source_volume_change / (signal.spatial_extent * 1000 * 3000),
            "strike": 45,  # NE-SW orientation
            "dip": 90,     # Vertical
            "fit_quality": 0.72
        }
    
    async def _analyze_magmatic_intrusion(self, signals: List[VolcanicDeformationSignal],
                                        source_models: List[Dict[str, Any]],
                                        target_volcano: str) -> Dict[str, Any]:
        """Analyze magmatic intrusion characteristics"""
        if not signals:
            return {"intrusion_detected": False}
        
        # Aggregate signal characteristics
        total_deformation = sum(signal.magnitude for signal in signals)
        avg_depth = np.mean([signal.source_depth for signal in signals if signal.source_depth])
        max_intrusion_prob = max(signal.magma_intrusion_probability for signal in signals)
        
        # Analyze source models
        best_model = max(source_models, key=lambda x: x.get("fit_quality", 0))
        
        # Intrusion characteristics
        intrusion_analysis = {
            "intrusion_detected": max_intrusion_prob > 0.5,
            "intrusion_probability": max_intrusion_prob,
            "total_deformation_rate": total_deformation,  # mm/year
            "average_source_depth": avg_depth,
            "best_source_model": best_model,
            "intrusion_type": self._classify_intrusion_type(best_model, signals),
            "magma_volume_estimate": sum(signal.source_volume_change or 0 for signal in signals),
            "eruption_potential": self._assess_eruption_potential(signals, source_models),
            "monitoring_recommendations": self._generate_monitoring_recommendations(
                signals, target_volcano
            )
        }
        
        return intrusion_analysis
    
    def _classify_intrusion_type(self, best_model: Dict[str, Any], 
                               signals: List[VolcanicDeformationSignal]) -> str:
        """Classify type of magmatic intrusion"""
        model_type = best_model.get("model_type", "unknown")
        
        if model_type == "sill_intrusion":
            return "sill_intrusion"
        elif model_type == "dike_intrusion":
            return "dike_intrusion"
        elif model_type == "mogi_point_source":
            # Determine if it's chamber inflation or intrusion
            avg_depth = np.mean([s.source_depth for s in signals if s.source_depth])
            if avg_depth < 5:
                return "shallow_chamber_inflation"
            else:
                return "deep_chamber_inflation"
        else:
            return "unknown"
    
    def _assess_eruption_potential(self, signals: List[VolcanicDeformationSignal],
                                 source_models: List[Dict[str, Any]]) -> Dict[str, Any]:
        """Assess eruption potential based on deformation"""
        if not signals:
            return {"potential": "low", "probability": 0.1}
        
        # Factors that increase eruption potential
        max_deformation = max(signal.magnitude for signal in signals)
        min_depth = min(signal.source_depth for signal in signals if signal.source_depth)
        max_intrusion_prob = max(signal.magma_intrusion_probability for signal in signals)
        
        # Simple scoring system
        score = 0
        
        if max_deformation > 50:  # >50 mm/year
            score += 3
        elif max_deformation > 20:  # >20 mm/year
            score += 2
        elif max_deformation > 10:  # >10 mm/year
            score += 1
        
        if min_depth < 3:  # <3 km depth
            score += 3
        elif min_depth < 6:  # <6 km depth
            score += 2
        elif min_depth < 10:  # <10 km depth
            score += 1
        
        if max_intrusion_prob > 0.8:
            score += 2
        elif max_intrusion_prob > 0.5:
            score += 1
        
        # Convert score to potential level
        if score >= 6:
            potential = "very_high"
            probability = 0.8
        elif score >= 4:
            potential = "high"
            probability = 0.6
        elif score >= 2:
            potential = "moderate"
            probability = 0.4
        else:
            potential = "low"
            probability = 0.2
        
        return {
            "potential": potential,
            "probability": probability,
            "score": score,
            "factors": {
                "max_deformation_rate": max_deformation,
                "minimum_source_depth": min_depth,
                "intrusion_probability": max_intrusion_prob
            }
        }
    
    def _generate_monitoring_recommendations(self, signals: List[VolcanicDeformationSignal],
                                           target_volcano: str) -> List[str]:
        """Generate monitoring recommendations"""
        recommendations = []
        
        if not signals:
            recommendations.append("Continue routine InSAR monitoring")
            return recommendations
        
        max_deformation = max(signal.magnitude for signal in signals)
        max_intrusion_prob = max(signal.magma_intrusion_probability for signal in signals)
        
        if max_deformation > 50:
            recommendations.append("Increase InSAR monitoring frequency to daily")
            recommendations.append("Deploy additional GPS stations")
            recommendations.append("Enhance seismic monitoring network")
        elif max_deformation > 20:
            recommendations.append("Increase InSAR monitoring frequency to weekly")
            recommendations.append("Monitor gas emissions")
        
        if max_intrusion_prob > 0.7:
            recommendations.append("Activate emergency monitoring protocols")
            recommendations.append("Coordinate with volcano observatories")
            recommendations.append("Prepare hazard assessments")
        elif max_intrusion_prob > 0.5:
            recommendations.append("Increase monitoring vigilance")
            recommendations.append("Prepare contingency plans")
        
        recommendations.append(f"Continue long-term monitoring of {target_volcano}")
        
        return recommendations
    
