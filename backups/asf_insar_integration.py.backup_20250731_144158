@dataclass
class InSARParameters:
    """InSAR processing parameters"""
    satellite: str  # Sentinel-1, ALOS-2, etc.
    processing_level: str  # L1, L2, etc.
    polarization: str  # VV, VH, HH, HV
    orbit_direction: str  # ascending, descending
    temporal_baseline_max: int  # days
    perpendicular_baseline_max: float  # meters
    coherence_threshold: float
    unwrapping_method: str
    atmospheric_correction: bool
    topographic_correction: bool
    reference_point: Optional[Tuple[float, float]]

@dataclass
class VolcanicDeformationSignal:
    """Volcanic deformation signal characteristics"""
    location: Tuple[float, float]  # lat, lon
    magnitude: float  # mm/year or mm
    direction: str  # uplift, subsidence, lateral
    spatial_extent: float  # km
    temporal_pattern: str  # linear, exponential, episodic
    confidence: float
    source_depth: Optional[float]  # km
    source_volume_change: Optional[float]  # m³
    magma_intrusion_probability: float

