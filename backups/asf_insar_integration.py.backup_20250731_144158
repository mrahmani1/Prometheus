    async def search_asf_data(self, query: ASFQuery) -> List[Dict[str, Any]]:
        """Search ASF for InSAR data"""
        search_params = {
            "platform": ",".join(query.platform),
            "start": query.start_date.strftime("%Y-%m-%dT%H:%M:%S"),
            "end": query.end_date.strftime("%Y-%m-%dT%H:%M:%S"),
            "bbox": f"{query.bbox[0]},{query.bbox[1]},{query.bbox[2]},{query.bbox[3]}",
            "processingLevel": ",".join(query.processing_level),
            "maxResults": query.max_results,
            "output": "json"
        }
        
        if query.beam_mode:
            search_params["beamMode"] = ",".join(query.beam_mode)
        
        if query.flight_direction:
            search_params["flightDirection"] = query.flight_direction
        
        try:
            async with aiohttp.ClientSession() as session:
                async with session.get(self.asf_search_url, params=search_params) as response:
                    if response.status == 200:
                        data = await response.json()
                        return data.get("results", [])
                    else:
                        logger.error(f"ASF search failed with status {response.status}")
                        return []
        
        except Exception as e:
            logger.error(f"Error searching ASF data: {e}")
            return []
    
    async def download_asf_data(self, granule_urls: List[str], download_dir: str) -> List[str]:
        """Download ASF data granules"""
        downloaded_files = []
        
        if not self.asf_username or not self.asf_password:
            logger.error("ASF credentials not configured")
            return downloaded_files
        
        auth = aiohttp.BasicAuth(self.asf_username, self.asf_password)
        
        async with aiohttp.ClientSession(auth=auth) as session:
            for url in granule_urls:
                try:
                    filename = os.path.basename(url)
                    filepath = os.path.join(download_dir, filename)
                    
                    if os.path.exists(filepath):
                        logger.info(f"File already exists: {filename}")
                        downloaded_files.append(filepath)
                        continue
                    
                    async with session.get(url) as response:
                        if response.status == 200:
                            os.makedirs(download_dir, exist_ok=True)
                            with open(filepath, 'wb') as f:
                                async for chunk in response.content.iter_chunked(8192):
                                    f.write(chunk)
                            
                            downloaded_files.append(filepath)
                            logger.info(f"Downloaded: {filename}")
                        else:
                            logger.error(f"Failed to download {filename}: {response.status}")
                
                except Exception as e:
                    logger.error(f"Error downloading {url}: {e}")
        
        return downloaded_files
    
    async def process_insar_time_series(self, data_files: List[str], 
                                      target_volcano: str,
                                      params: Optional[InSARParameters] = None) -> Dict[str, Any]:
        """Process InSAR time series for volcanic monitoring"""
        if params is None:
            params = self.default_params
        
        processing_id = f"insar_{target_volcano}_{datetime.now().strftime('%Y%m%d_%H%M%S')}"
        
        try:
            # Step 1: Coregistration and interferogram formation
            interferograms = await self._create_interferograms(data_files, params)
            
            # Step 2: Coherence estimation and filtering
            filtered_interferograms = await self._filter_by_coherence(
                interferograms, params.coherence_threshold
            )
            
            # Step 3: Phase unwrapping
            unwrapped_phases = await self._unwrap_phases(
                filtered_interferograms, params.unwrapping_method
            )
            
            # Step 4: Atmospheric correction
            if params.atmospheric_correction:
                corrected_phases = await self._atmospheric_correction(unwrapped_phases)
            else:
                corrected_phases = unwrapped_phases
            
            # Step 5: Time series analysis
            time_series = await self._time_series_analysis(corrected_phases, params)
            
            # Step 6: Volcanic deformation detection
            deformation_signals = await self._detect_volcanic_deformation(
                time_series, target_volcano
            )
            
            # Step 7: Source modeling
            source_models = await self._model_deformation_sources(
                deformation_signals, target_volcano
            )
            
            # Step 8: Magmatic intrusion analysis
            intrusion_analysis = await self._analyze_magmatic_intrusion(
                deformation_signals, source_models, target_volcano
            )
            
            processing_result = {
                "processing_id": processing_id,
                "target_volcano": target_volcano,
                "processing_timestamp": datetime.now().isoformat(),
                "input_files_count": len(data_files),
                "interferograms_created": len(interferograms),
                "coherent_interferograms": len(filtered_interferograms),
                "time_series_points": len(time_series),
                "deformation_signals": deformation_signals,
                "source_models": source_models,
                "intrusion_analysis": intrusion_analysis,
                "processing_parameters": asdict(params)
            }
            
            # Cache results
            self.processing_cache[processing_id] = processing_result
            
            return processing_result
        
        except Exception as e:
            logger.error(f"InSAR processing failed for {target_volcano}: {e}")
            return {
                "processing_id": processing_id,
                "error": str(e),
                "status": "failed"
            }
    
    async def _create_interferograms(self, data_files: List[str], 
                                   params: InSARParameters) -> List[Dict[str, Any]]:
        """Create interferograms from SAR data"""
        interferograms = []
        
        # Sort files by acquisition date
        sorted_files = await self._sort_files_by_date(data_files)
        
        # Create interferometric pairs
        for i, master_file in enumerate(sorted_files):
            for j, slave_file in enumerate(sorted_files[i+1:], i+1):
                # Check temporal baseline
                temporal_baseline = await self._calculate_temporal_baseline(
                    master_file, slave_file
                )
                
                if temporal_baseline <= params.temporal_baseline_max:
                    # Check perpendicular baseline
                    perp_baseline = await self._calculate_perpendicular_baseline(
                        master_file, slave_file
                    )
                    
                    if perp_baseline <= params.perpendicular_baseline_max:
                        interferogram = await self._create_single_interferogram(
                            master_file, slave_file, params
                        )
                        
                        if interferogram:
                            interferograms.append({
                                "master": master_file,
                                "slave": slave_file,
                                "temporal_baseline": temporal_baseline,
                                "perpendicular_baseline": perp_baseline,
                                "interferogram": interferogram
                            })
        
        logger.info(f"Created {len(interferograms)} interferograms")
        return interferograms
    
    async def _sort_files_by_date(self, data_files: List[str]) -> List[str]:
        """Sort SAR files by acquisition date"""
        # Extract dates from filenames (Sentinel-1 format)
        file_dates = []
        for file in data_files:
            try:
                # Sentinel-1 filename format: S1A_IW_SLC__1SDV_20210101T123456_...
                basename = os.path.basename(file)
                if basename.startswith('S1'):
                    date_str = basename.split('_')[4][:8]
                    date = datetime.strptime(date_str, '%Y%m%d')
                    file_dates.append((date, file))
            except:
                # Fallback to file modification time
                mtime = os.path.getmtime(file)
                date = datetime.fromtimestamp(mtime)
                file_dates.append((date, file))
        
        # Sort by date
        file_dates.sort(key=lambda x: x[0])
        return [file for date, file in file_dates]
    
    async def _calculate_temporal_baseline(self, master_file: str, slave_file: str) -> int:
        """Calculate temporal baseline between two SAR acquisitions"""
        # Extract dates from filenames
        master_date = await self._extract_acquisition_date(master_file)
        slave_date = await self._extract_acquisition_date(slave_file)
        
        return abs((slave_date - master_date).days)
    
