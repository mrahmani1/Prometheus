def create_synthetic_volcanic_scene(scene_id: str, timestamp: datetime) -> InSARScene:
    """
    Create a synthetic InSAR scene with volcanic deformation.
    
    Args:
        scene_id: Unique identifier for the scene
        timestamp: Acquisition timestamp
        
    Returns:
        InSAR scene with synthetic volcanic deformation
    """
    # Create InSAR scene metadata
    scene = InSARScene(
        scene_id=scene_id,
        timestamp=timestamp,
        satellite="Sentinel-1A",
        orbit_direction="ascending",
        look_angle=23.0,
        heading_angle=192.0,
        wavelength=0.056,  # C-band wavelength in meters
        spatial_resolution=20.0,  # 20m resolution
        coverage_area=(45.0, 46.0, -122.0, -121.0)  # Mount Hood area
    )
    
    # Create synthetic data
    height, width = 512, 512
    y, x = np.mgrid[0:height, 0:width]
    
    # Volcanic uplift pattern (Mogi source)
    center_y, center_x = height // 2, width // 2
    
    # Primary deformation source
    distance = np.sqrt((x - center_x)**2 + (y - center_y)**2)
    
    # Mogi model for point pressure source
    depth = 50  # pixels (representing ~1km depth)
    volume_change = 1e6  # m³
    
    
