class TimeSeriesProcessor:
    """Advanced time series processing for geological data"""
    
    def process(self, data: Any, config: Dict[str, Any]) -> Tuple[Any, Dict[str, Any]]:
        """Process time series data"""
        
        if not isinstance(data, (list, np.ndarray)):
            return data, {'error': 'Invalid data type for time series processing'}
        
        data_array = np.array(data)
        results = {}
        
        # Detrending
        if config.get('detrend', False):
            from scipy import signal
            data_array = signal.detrend(data_array, type=config.get('detrend_type', 'linear'))
            results['detrended'] = True
        
        # Filtering
        if 'filter' in config:
            filter_config = config['filter']
            data_array = self._apply_filter(data_array, filter_config)
            results['filtered'] = filter_config
        
        # Resampling
        if 'resample' in config:
            resample_config = config['resample']
            data_array = self._resample_data(data_array, resample_config)
            results['resampled'] = resample_config
        
        # Anomaly detection
        if config.get('detect_anomalies', False):
            anomalies = self._detect_anomalies(data_array, config.get('anomaly_config', {}))
            results['anomalies'] = anomalies
        
        return data_array.tolist(), results
    
    def _apply_filter(self, data: np.ndarray, filter_config: Dict[str, Any]) -> np.ndarray:
        """Apply digital filter to data"""
        from scipy import signal
        
        filter_type = filter_config.get('type', 'bandpass')
        sampling_rate = filter_config.get('sampling_rate', 100.0)
        
        if filter_type == 'bandpass':
            low_freq = filter_config.get('low_freq', 1.0)
            high_freq = filter_config.get('high_freq', 25.0)
            nyquist = sampling_rate / 2
            
            b, a = signal.butter(
                filter_config.get('order', 4),
                [low_freq/nyquist, high_freq/nyquist],
                btype='band'
            )
            return signal.filtfilt(b, a, data)
        
        elif filter_type == 'lowpass':
            cutoff = filter_config.get('cutoff', 25.0)
            nyquist = sampling_rate / 2
            
            b, a = signal.butter(
                filter_config.get('order', 4),
                cutoff/nyquist,
                btype='low'
            )
            return signal.filtfilt(b, a, data)
        
        return data
    
    def _resample_data(self, data: np.ndarray, resample_config: Dict[str, Any]) -> np.ndarray:
        """Resample data to different sampling rate"""
        from scipy import signal
        
        original_rate = resample_config.get('original_rate', 100.0)
        target_rate = resample_config.get('target_rate', 50.0)
        
        if original_rate != target_rate:
            num_samples = int(len(data) * target_rate / original_rate)
            return signal.resample(data, num_samples)
        
        return data
    
    def _detect_anomalies(self, data: np.ndarray, anomaly_config: Dict[str, Any]) -> Dict[str, Any]:
        """Detect anomalies in time series data"""
        
        method = anomaly_config.get('method', 'statistical')
        
        if method == 'statistical':
            # Statistical outlier detection
            mean_val = np.mean(data)
            std_val = np.std(data)
            threshold = anomaly_config.get('threshold', 3.0)
            
            anomaly_indices = np.where(np.abs(data - mean_val) > threshold * std_val)[0]
            
            return {
                'method': 'statistical',
                'anomaly_count': len(anomaly_indices),
                'anomaly_indices': anomaly_indices.tolist(),
                'threshold_used': threshold
            }
        
        elif method == 'isolation_forest':
            # Machine learning based anomaly detection
            from sklearn.ensemble import IsolationForest
            
            contamination = anomaly_config.get('contamination', 0.1)
            clf = IsolationForest(contamination=contamination, random_state=42)
            
            data_reshaped = data.reshape(-1, 1)
            anomaly_labels = clf.fit_predict(data_reshaped)
            anomaly_indices = np.where(anomaly_labels == -1)[0]
            
            return {
                'method': 'isolation_forest',
                'anomaly_count': len(anomaly_indices),
                'anomaly_indices': anomaly_indices.tolist(),
                'contamination': contamination
            }
        
        return {'method': 'none', 'anomaly_count': 0}

    vertical_displacement = (volume_change / (4 * np.pi)) * depth / (distance**2 + depth**2)**(3/2)
    
    # Scale to realistic values (cm)
    vertical_displacement *= 0.05  # 5cm maximum uplift
    
    # Add secondary deformation pattern
    secondary_center_y = center_y + 100
    secondary_center_x = center_x - 80
    secondary_distance = np.sqrt((x - secondary_center_x)**2 + (y - secondary_center_y)**2)
    secondary_deformation = 0.02 * np.exp(-(secondary_distance**2) / (2 * 40**2))
    
    total_deformation = vertical_displacement + secondary_deformation
    
    # Convert to line-of-sight displacement
    los_vector = scene.get_line_of_sight_vector()
    los_displacement = total_deformation * los_vector[2]  # Assume mostly vertical
    
    # Convert displacement to phase
    unwrapped_phase = 4 * np.pi * los_displacement / scene.wavelength
    
    # Add atmospheric effects
    atmospheric_phase = create_atmospheric_phase_screen(height, width)
    unwrapped_phase += atmospheric_phase
    
    # Add noise
    np.random.seed(42)
    noise = np.random.normal(0, 0.1, (height, width))
    unwrapped_phase += noise
    
    # Create coherence map
    coherence = create_coherence_map(height, width, distance, center_x, center_y)
    
    # Assign data to scene
    scene.unwrapped_phase = unwrapped_phase
    scene.coherence = coherence
    
    # Add metadata
    scene.metadata = {
        'deformation_type': 'volcanic_uplift',
        'max_displacement': float(np.max(total_deformation)),
        'synthetic': True,
        'noise_level': 0.1
    }
    
    return scene


def create_atmospheric_phase_screen(height: int, width: int) -> np.ndarray:
    """
    Create synthetic atmospheric phase screen with turbulent characteristics.
    
    Args:
        height: Image height
        width: Image width
        
    Returns:
        Atmospheric phase screen
    """
    # Create turbulent atmospheric phase using fractal noise
    np.random.seed(123)  # For reproducibility
    
    # Generate multiple scales of noise
    atmospheric_phase = np.zeros((height, width))
    
    for scale in [1, 2, 4, 8, 16]:
        # Generate noise at different scales
        noise_height = height // scale
        noise_width = width // scale
        
        noise = np.random.randn(noise_height, noise_width)
        
        # Upsample to full resolution
        from scipy.ndimage import zoom
        upsampled_noise = zoom(noise, scale, order=1)
        
        # Ensure correct size
        if upsampled_noise.shape[0] > height:
            upsampled_noise = upsampled_noise[:height, :]
        if upsampled_noise.shape[1] > width:
            upsampled_noise = upsampled_noise[:, :width]
        
        # Pad if necessary
        if upsampled_noise.shape[0] < height or upsampled_noise.shape[1] < width:
            padded_noise = np.zeros((height, width))
            padded_noise[:upsampled_noise.shape[0], :upsampled_noise.shape[1]] = upsampled_noise
            upsampled_noise = padded_noise
        
        # Add to atmospheric phase with decreasing amplitude
        atmospheric_phase += upsampled_noise * (0.5 / scale)
    
    # Apply spatial correlation (weather patterns)
    from scipy.ndimage import gaussian_filter
    atmospheric_phase = gaussian_filter(atmospheric_phase, sigma=20)
    
    # Scale to realistic atmospheric delay (radians)
    atmospheric_phase *= 0.3
    
    return atmospheric_phase


def create_coherence_map(height: int, width: int, distance: np.ndarray, 
                        center_x: int, center_y: int) -> np.ndarray:
    """
    Create realistic coherence map.
    
    Args:
        height: Image height
        width: Image width
        distance: Distance from center
        center_x: Center x coordinate
        center_y: Center y coordinate
        
    Returns:
        Coherence map
    """
    # Base coherence
    coherence = 0.8 * np.ones((height, width))
    
    # Reduce coherence with distance (decorrelation)
    coherence *= np.exp(-distance / 200)
    
    # Add random coherence variations
    np.random.seed(456)
    coherence += np.random.normal(0, 0.1, (height, width))
    
    # Clip to valid range
    coherence = np.clip(coherence, 0.0, 1.0)
    
    # Add low coherence areas (water, vegetation)
    # Simulate water body
    water_mask = ((distance > 150) & (distance < 180) & 
                  (np.abs(np.arctan2(np.mgrid[0:height, 0:width][0] - center_y,
                                   np.mgrid[0:height, 0:width][1] - center_x)) < np.pi/4))
    coherence[water_mask] *= 0.2
    
    return coherence


