def analyze_temporal_evolution(results: List[dict]):
    """
    Analyze temporal evolution of deformation.
    
    Args:
        results: List of processing results
    """
    logger.info("Analyzing temporal evolution of deformation")
    
    timestamps = []
    max_displacements = []
    uncertainties = []
    
    for result in results:
        if result['status'] == 'success':
            timestamps.append(result['processing_timestamp'])
            
            # Find maximum displacement
            measurements = result['displacement_measurements']
            if measurements:
                displacements = [np.linalg.norm(m.displacement_vector) for m in measurements]
                max_displacements.append(max(displacements))
            else:
                max_displacements.append(0.0)
            
            uncertainties.append(result['uncertainty_estimates']['total_uncertainty'])
    
    if len(timestamps) > 1:
        logger.info(f"Temporal analysis results:")
        logger.info(f"  - Time span: {len(timestamps)} acquisitions")
        logger.info(f"  - Maximum displacement: {max(max_displacements):.4f} m")
        logger.info(f"  - Average uncertainty: {np.mean(uncertainties):.4f} m")
        
        # Calculate deformation rate
        if len(max_displacements) > 1:
            time_diff = (timestamps[-1] - timestamps[0]).days
            deformation_rate = (max_displacements[-1] - max_displacements[0]) / time_diff * 365.25
            logger.info(f"  - Annual deformation rate: {deformation_rate:.4f} m/year")


def visualize_insar_results(scene: InSARScene, result: dict):
    """
    Visualize InSAR processing results.
    
    Args:
        scene: Original InSAR scene
        result: Processing results
    """
    if result['status'] != 'success':
        logger.warning("Cannot visualize failed processing result")
        return
    
    # Create figure with subplots
    fig, axes = plt.subplots(2, 3, figsize=(15, 10))
    fig.suptitle(f'InSAR Analysis Results - {scene.scene_id}', fontsize=16)
    
    # Original unwrapped phase
    im1 = axes[0, 0].imshow(scene.unwrapped_phase, cmap='jet', aspect='equal')
    axes[0, 0].set_title('Original Unwrapped Phase')
    axes[0, 0].set_xlabel('Range (pixels)')
    axes[0, 0].set_ylabel('Azimuth (pixels)')
    plt.colorbar(im1, ax=axes[0, 0], label='Phase (radians)')
    
    # Coherence map
    im2 = axes[0, 1].imshow(scene.coherence, cmap='gray', vmin=0, vmax=1, aspect='equal')
    axes[0, 1].set_title('Coherence Map')
    axes[0, 1].set_xlabel('Range (pixels)')
    axes[0, 1].set_ylabel('Azimuth (pixels)')
    plt.colorbar(im2, ax=axes[0, 1], label='Coherence')
    
    # Line-of-sight displacement
    displacement = scene.phase_to_displacement(scene.unwrapped_phase)
    im3 = axes[0, 2].imshow(displacement, cmap='RdBu_r', aspect='equal')
    axes[0, 2].set_title('LOS Displacement')
    axes[0, 2].set_xlabel('Range (pixels)')
    axes[0, 2].set_ylabel('Azimuth (pixels)')
    plt.colorbar(im3, ax=axes[0, 2], label='Displacement (m)')
    
    # Displacement measurements locations
    measurements = result['displacement_measurements']
    if measurements:
        # Convert geographic coordinates to pixel coordinates (simplified)
        coverage = scene.coverage_area
        height, width = scene.unwrapped_phase.shape
        
        pixel_coords = []
        displacements = []
        
        for measurement in measurements[::10]:  # Sample every 10th measurement
            lat_frac = (measurement.location.latitude - coverage[0]) / (coverage[1] - coverage[0])
            lon_frac = (measurement.location.longitude - coverage[2]) / (coverage[3] - coverage[2])
            
            pixel_y = int(lat_frac * height)
            pixel_x = int(lon_frac * width)
            
            if 0 <= pixel_y < height and 0 <= pixel_x < width:
                pixel_coords.append((pixel_x, pixel_y))
                displacements.append(np.linalg.norm(measurement.displacement_vector))
        
        if pixel_coords:
            x_coords, y_coords = zip(*pixel_coords)
            scatter = axes[1, 0].scatter(x_coords, y_coords, c=displacements, 
                                       cmap='RdBu_r', s=20, alpha=0.7)
            axes[1, 0].set_title('Displacement Measurements')
            axes[1, 0].set_xlabel('Range (pixels)')
            axes[1, 0].set_ylabel('Azimuth (pixels)')
            axes[1, 0].set_xlim(0, width)
            axes[1, 0].set_ylim(height, 0)
            plt.colorbar(scatter, ax=axes[1, 0], label='|Displacement| (m)')
    else:
        axes[1, 0].text(0.5, 0.5, 'No measurements available', 
                       ha='center', va='center', transform=axes[1, 0].transAxes)
        axes[1, 0].set_title('Displacement Measurements')
    
    # Uncertainty map (simplified)
    uncertainty = result['uncertainty_estimates']
    uncertainty_text = f"""Uncertainty Estimates:
    
Mean Displacement: {uncertainty['mean_displacement_uncertainty']:.4f} m
Atmospheric: {uncertainty['atmospheric_uncertainty']:.4f} m
Orbital: {uncertainty['orbital_uncertainty']:.4f} m
Total: {uncertainty['total_uncertainty']:.4f} m

Coherence-based: {uncertainty.get('coherence_based', 'No')}"""
    
    axes[1, 1].text(0.05, 0.95, uncertainty_text, transform=axes[1, 1].transAxes,
                   verticalalignment='top', fontfamily='monospace', fontsize=10)
    axes[1, 1].set_title('Uncertainty Estimates')
    axes[1, 1].axis('off')
    
    # Processing summary
    processing_info = f"""Processing Summary:
    
Scene ID: {scene.scene_id}
Satellite: {scene.satellite}
Timestamp: {scene.timestamp.strftime('%Y-%m-%d %H:%M')}
Wavelength: {scene.wavelength:.3f} m
Look Angle: {scene.look_angle:.1f}°
Resolution: {scene.spatial_resolution:.1f} m

Status: {result['status']}
Noise Reduction: {result['noise_reduction_applied']}
Atmospheric Correction: {'Yes' if result['atmospheric_correction'] else 'No'}

Measurements: {len(measurements)}
Patterns: {len(result['deformation_patterns'])}"""
    
    axes[1, 2].text(0.05, 0.95, processing_info, transform=axes[1, 2].transAxes,
                   verticalalignment='top', fontfamily='monospace', fontsize=9)
    axes[1, 2].set_title('Processing Summary')
    axes[1, 2].axis('off')
    
    plt.tight_layout()
    
    # Save figure
    output_filename = f'insar_analysis_{scene.scene_id}.png'
    plt.savefig(output_filename, dpi=150, bbox_inches='tight')
    logger.info(f"Visualization saved as: {output_filename}")
    
    # Show plot
    plt.show()


def demonstrate_model_training():
    """Demonstrate training of InSAR analysis models"""
    
    logger.info("Demonstrating model training workflow")
    
    # Create training data
    logger.info("Creating synthetic training data...")
    
    training_scenes = []
    validation_scenes = []
    
    # Generate training scenes
    base_time = datetime(2022, 1, 1)
    for i in range(20):  # 20 training scenes
        timestamp = base_time + timedelta(days=12*i)
        scene_id = f"train_{i:03d}"
        scene = create_synthetic_volcanic_scene(scene_id, timestamp)
        training_scenes.append(scene)
    
    # Generate validation scenes
    for i in range(5):  # 5 validation scenes
        timestamp = base_time + timedelta(days=12*(20+i))
        scene_id = f"val_{i:03d}"
        scene = create_synthetic_volcanic_scene(scene_id, timestamp)
        validation_scenes.append(scene)
    
    logger.info(f"Created {len(training_scenes)} training and {len(validation_scenes)} validation scenes")
    
    # Initialize analyzer
    analyzer = InSARDeformationAnalyzer(device='cpu')
    
    # Train atmospheric correction model
    logger.info("Training atmospheric correction model...")
    try:
        atm_history = analyzer.train_atmospheric_model(
            training_scenes, validation_scenes,
            epochs=5,  # Reduced for demo
            batch_size=4,
            learning_rate=1e-4
        )
        logger.info("Atmospheric model training completed")
        logger.info(f"Final training loss: {atm_history['train_loss'][-1]:.6f}")
        logger.info(f"Final validation loss: {atm_history['val_loss'][-1]:.6f}")
    except Exception as e:
        logger.error(f"Atmospheric model training failed: {e}")
    
    # Create training data for deformation model (with ground truth patterns)
    logger.info("Preparing deformation pattern training data...")
    
    deformation_training_data = []
    deformation_validation_data = []
    
    # Add ground truth patterns to training scenes
    for scene in training_scenes:
        # Create ground truth deformation patterns based on synthetic data
        patterns = []
