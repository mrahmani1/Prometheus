                pattern_id=f"{scene.scene_id}_uplift",
                pattern_type="volcanic_uplift",
                center_location=center_location,
                spatial_extent=(1000.0, 1000.0),
                magnitude=scene.metadata.get('max_displacement', 0.05),
                confidence=0.9
            )
            patterns.append(pattern)
        
        deformation_training_data.append((scene, patterns))
    
    # Same for validation
    for scene in validation_scenes:
        patterns = []
        if scene.metadata.get('deformation_type') == 'volcanic_uplift':
            center_location = GeologicalLocation(
                latitude=45.5, longitude=-121.5, elevation=1000.0
            )
            pattern = DeformationPattern(
                pattern_id=f"{scene.scene_id}_uplift",
                pattern_type="volcanic_uplift",
                center_location=center_location,
                spatial_extent=(1000.0, 1000.0),
                magnitude=scene.metadata.get('max_displacement', 0.05),
                confidence=0.9
            )
            patterns.append(pattern)
        
        deformation_validation_data.append((scene, patterns))
    
    # Train deformation pattern model
    logger.info("Training deformation pattern model...")
    try:
        def_history = analyzer.train_deformation_model(
            deformation_training_data, deformation_validation_data,
            epochs=5,  # Reduced for demo
            batch_size=4,
            learning_rate=1e-4
        )
        logger.info("Deformation model training completed")
        logger.info(f"Final training loss: {def_history['train_loss'][-1]:.6f}")
        logger.info(f"Final validation loss: {def_history['val_loss'][-1]:.6f}")
        logger.info(f"Final training accuracy: {def_history['train_acc'][-1]:.2f}%")
        logger.info(f"Final validation accuracy: {def_history['val_acc'][-1]:.2f}%")
    except Exception as e:
