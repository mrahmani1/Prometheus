                    {"range": [0.7, 1.0], "label": "Very High", "color": "red"}
                ]
            }
        
        return {
            "type": "map",
            "data": map_data,
            "caption": f"Combined hazard risk assessment for {assessment.timestamp.strftime('%Y-%m-%d %H:%M UTC')}"
        }
    
    async def _generate_uncertainty_map(
        self,
        assessment: MultiHazardAssessment,
        style: str = "scientific"
    ) -> Dict[str, Any]:
        """Generate uncertainty map visualization"""
        
        map_data = {
            "type": "uncertainty_map",
            "title": "Assessment Uncertainty",
            "bounds": {
                "min_lat": assessment.geographic_bounds.min_lat,
                "max_lat": assessment.geographic_bounds.max_lat,
                "min_lon": assessment.geographic_bounds.min_lon,
                "max_lon": assessment.geographic_bounds.max_lon
            },
            "uncertainty_data": assessment.uncertainty_map.tolist(),
            "color_scheme": "blues",
            "legend": {
                "title": "Uncertainty",
                "min_value": 0.0,
                "max_value": 1.0,
                "units": "confidence"
            }
        }
        
        return {
            "type": "map",
            "data": map_data,
            "caption": "Model uncertainty showing areas where additional data would improve predictions"
        }
    
    async def _generate_probability_map(
        self,
        assessment: MultiHazardAssessment,
        style: str = "scientific"
    ) -> Dict[str, Any]:
        """Generate probability map visualization"""
        
        # Create probability map from individual hazards
        primary_hazard = max(
            assessment.individual_hazards.items(),
            key=lambda x: x[1].probability
        )
        
        map_data = {
            "type": "probability_map",
            "title": f"{primary_hazard[0].value.replace('_', ' ').title()} Probability",
            "bounds": {
                "min_lat": assessment.geographic_bounds.min_lat,
                "max_lat": assessment.geographic_bounds.max_lat,
                "min_lon": assessment.geographic_bounds.min_lon,
                "max_lon": assessment.geographic_bounds.max_lon
            },
            "probability_data": (assessment.combined_risk_map * primary_hazard[1].probability).tolist(),
            "color_scheme": "reds",
            "legend": {
                "title": "Probability",
                "min_value": 0.0,
                "max_value": 1.0,
                "units": "probability"
            }
        }
        
        return {
            "type": "map",
            "data": map_data,
            "caption": f"Probability map for {primary_hazard[0].value.replace('_', ' ').title().lower()}"
        }
    
    async def _generate_hazard_comparison(
        self,
        assessment: MultiHazardAssessment,
        style: str = "scientific"
    ) -> Dict[str, Any]:
        """Generate hazard comparison chart"""
        
        hazard_data = []
        for hazard_type, hazard_prob in assessment.individual_hazards.items():
            hazard_data.append({
                "hazard": hazard_type.value.replace('_', ' ').title(),
                "probability": hazard_prob.probability,
                "uncertainty": hazard_prob.uncertainty,
                "confidence_low": hazard_prob.confidence_interval[0],
                "confidence_high": hazard_prob.confidence_interval[1]
            })
        
        # Sort by probability
        hazard_data.sort(key=lambda x: x["probability"], reverse=True)
        
        chart_data = {
            "type": "bar_chart",
            "title": "Individual Hazard Probabilities",
            "data": hazard_data,
            "x_axis": "hazard",
            "y_axis": "probability",
            "show_error_bars": style == "scientific",
            "show_uncertainty": style == "scientific"
        }
        
        return {
            "type": "chart",
            "data": chart_data,
            "caption": "Comparison of individual hazard probabilities with uncertainty bounds"
        }
    
    async def _generate_timeline_chart(
        self,
        assessment: MultiHazardAssessment,
        style: str = "public"
    ) -> Dict[str, Any]:
        """Generate timeline chart showing risk evolution"""
        
        # Generate simplified timeline (in practice would use historical data)
        timeline_data = []
        base_time = assessment.timestamp - timedelta(days=7)
        
        for i in range(8):  # Last 7 days plus current
            time_point = base_time + timedelta(days=i)
            # Simulate risk evolution (in practice would use actual historical data)
            risk_level = np.random.uniform(0.1, 0.6) if i < 7 else np.max(assessment.combined_risk_map)
            
            timeline_data.append({
                "date": time_point.strftime('%Y-%m-%d'),
                "risk_level": risk_level,
                "status": "Historical" if i < 7 else "Current"
            })
        
        chart_data = {
            "type": "line_chart",
            "title": "Risk Level Over Time",
            "data": timeline_data,
            "x_axis": "date",
            "y_axis": "risk_level",
            "y_axis_label": "Risk Level" if style == "public" else "Combined Risk Probability"
        }
        
        return {
            "type": "chart",
            "data": chart_data,
            "caption": "Evolution of risk levels over the past week"
        }
    
    async def _generate_population_impact_chart(
        self,
        assessment: MultiHazardAssessment,
        style: str = "operational"
    ) -> Dict[str, Any]:
        """Generate population impact visualization"""
        
        # Calculate population in different risk zones
        risk_zones = [
            {"zone": "Low Risk", "threshold": 0.2, "color": "green"},
            {"zone": "Moderate Risk", "threshold": 0.4, "color": "yellow"},
            {"zone": "High Risk", "threshold": 0.7, "color": "orange"},
            {"zone": "Very High Risk", "threshold": 1.0, "color": "red"}
        ]
        
        population_data = []
        total_cells = assessment.combined_risk_map.size
        avg_pop_per_cell = assessment.total_population_at_risk / max(total_cells, 1)
        
        prev_threshold = 0.0
        for zone in risk_zones:
            cells_in_zone = np.sum(
                (assessment.combined_risk_map > prev_threshold) & 
                (assessment.combined_risk_map <= zone["threshold"])
            )
            population_in_zone = int(cells_in_zone * avg_pop_per_cell)
            
            population_data.append({
                "risk_zone": zone["zone"],
                "population": population_in_zone,
                "color": zone["color"]
            })
            
            prev_threshold = zone["threshold"]
        
        chart_data = {
            "type": "pie_chart",
            "title": "Population Distribution by Risk Zone",
            "data": population_data,
            "value_field": "population",
            "label_field": "risk_zone",
            "color_field": "color"
        }
        
        return {
            "type": "chart",
            "data": chart_data,
            "caption": f"Distribution of {assessment.total_population_at_risk:,} people across risk zones"
        }
    
    def _calculate_urgency_level(
        self,
        assessment: MultiHazardAssessment,
        alert: Optional[HazardAlert]
    ) -> int:
        """Calculate urgency level for communication (1-5)"""
        
        if alert:
            return alert.escalation_level
        
        max_risk = np.max(assessment.combined_risk_map)
        
        if max_risk < 0.2:
            return 1  # Low urgency
        elif max_risk < 0.4:
            return 2  # Moderate urgency
        elif max_risk < 0.6:
            return 3  # High urgency
        elif max_risk < 0.8:
            return 4  # Very high urgency
        else:
            return 5  # Extreme urgency
    
    
class AdvancedDataProcessor:
    """Advanced data processing pipeline for geological datasets"""
    
    def __init__(self):
        self.processors = {
            'time_series': TimeSeriesProcessor(),
            'spatial': SpatialDataProcessor(),
            'spectral': SpectralAnalysisProcessor(),
            'statistical': StatisticalProcessor(),
            'ml_preprocessing': MLPreprocessor()
        }
    
    def process_geological_dataset(self, dataset: Dict[str, Any], 
                                 processing_config: Dict[str, Any]) -> Dict[str, Any]:
        """Process geological dataset with configurable pipeline"""
        
        results = {
            'dataset_id': dataset.get('id', str(uuid.uuid4())),
            'processing_timestamp': datetime.now().isoformat(),
            'original_size': len(dataset.get('data', [])),
            'processing_steps': []
        }
        
        data = dataset['data']
        
        # Apply processing steps based on configuration
        for step_name, step_config in processing_config.items():
            if step_name in self.processors:
                try:
                    processor = self.processors[step_name]
                    processed_data, step_results = processor.process(data, step_config)
                    
                    data = processed_data
                    results['processing_steps'].append({
                        'step': step_name,
                        'status': 'success',
                        'results': step_results,
                        'output_size': len(data) if isinstance(data, list) else 'N/A'
                    })
                    
                except Exception as e:
                    results['processing_steps'].append({
                        'step': step_name,
                        'status': 'failed',
                        'error': str(e)
                    })
        
        results['processed_data'] = data
        results['final_size'] = len(data) if isinstance(data, list) else 'N/A'
        
        return results

class TimeSeriesProcessor:
    """Advanced time series processing for geological data"""
    
    def process(self, data: Any, config: Dict[str, Any]) -> Tuple[Any, Dict[str, Any]]:
        """Process time series data"""
        
        if not isinstance(data, (list, np.ndarray)):
            return data, {'error': 'Invalid data type for time series processing'}
        
        data_array = np.array(data)
        results = {}
        
        # Detrending
        if config.get('detrend', False):
            from scipy import signal
            data_array = signal.detrend(data_array, type=config.get('detrend_type', 'linear'))
            results['detrended'] = True
        
        # Filtering
        if 'filter' in config:
            filter_config = config['filter']
            data_array = self._apply_filter(data_array, filter_config)
            results['filtered'] = filter_config
        
        # Resampling
        if 'resample' in config:
            resample_config = config['resample']
            data_array = self._resample_data(data_array, resample_config)
            results['resampled'] = resample_config
        
        # Anomaly detection
        if config.get('detect_anomalies', False):
            anomalies = self._detect_anomalies(data_array, config.get('anomaly_config', {}))
            results['anomalies'] = anomalies
        
        return data_array.tolist(), results
    
    def _apply_filter(self, data: np.ndarray, filter_config: Dict[str, Any]) -> np.ndarray:
        """Apply digital filter to data"""
        from scipy import signal
        
        filter_type = filter_config.get('type', 'bandpass')
        sampling_rate = filter_config.get('sampling_rate', 100.0)
        
        if filter_type == 'bandpass':
            low_freq = filter_config.get('low_freq', 1.0)
            high_freq = filter_config.get('high_freq', 25.0)
            nyquist = sampling_rate / 2
            
            b, a = signal.butter(
                filter_config.get('order', 4),
                [low_freq/nyquist, high_freq/nyquist],
                btype='band'
            )
            return signal.filtfilt(b, a, data)
        
        elif filter_type == 'lowpass':
            cutoff = filter_config.get('cutoff', 25.0)
            nyquist = sampling_rate / 2
            
            b, a = signal.butter(
                filter_config.get('order', 4),
                cutoff/nyquist,
                btype='low'
            )
            return signal.filtfilt(b, a, data)
        
        return data
    
    def _resample_data(self, data: np.ndarray, resample_config: Dict[str, Any]) -> np.ndarray:
        """Resample data to different sampling rate"""
        from scipy import signal
        
        original_rate = resample_config.get('original_rate', 100.0)
        target_rate = resample_config.get('target_rate', 50.0)
        
        if original_rate != target_rate:
            num_samples = int(len(data) * target_rate / original_rate)
            return signal.resample(data, num_samples)
        
        return data
    
    def _detect_anomalies(self, data: np.ndarray, anomaly_config: Dict[str, Any]) -> Dict[str, Any]:
        """Detect anomalies in time series data"""
        
        method = anomaly_config.get('method', 'statistical')
        
        if method == 'statistical':
            # Statistical outlier detection
            mean_val = np.mean(data)
            std_val = np.std(data)
            threshold = anomaly_config.get('threshold', 3.0)
            
            anomaly_indices = np.where(np.abs(data - mean_val) > threshold * std_val)[0]
            
            return {
                'method': 'statistical',
                'anomaly_count': len(anomaly_indices),
                'anomaly_indices': anomaly_indices.tolist(),
                'threshold_used': threshold
            }
        
        elif method == 'isolation_forest':
            # Machine learning based anomaly detection
            from sklearn.ensemble import IsolationForest
            
            contamination = anomaly_config.get('contamination', 0.1)
            clf = IsolationForest(contamination=contamination, random_state=42)
            
            data_reshaped = data.reshape(-1, 1)
            anomaly_labels = clf.fit_predict(data_reshaped)
            anomaly_indices = np.where(anomaly_labels == -1)[0]
            
            return {
                'method': 'isolation_forest',
                'anomaly_count': len(anomaly_indices),
                'anomaly_indices': anomaly_indices.tolist(),
                'contamination': contamination
            }
        
        return {'method': 'none', 'anomaly_count': 0}

