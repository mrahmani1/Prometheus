"""
Hazard Communication and Visualization System

This module provides hazard communication and visualization capabilities
tailored for different audiences including scientists, emergency managers,
and the general public.
"""

import json
import logging
from datetime import datetime, timedelta
from typing import Dict, List, Optional, Any, Tuple
from dataclasses import dataclass, asdict
from enum import Enum
import numpy as np
import base64
from io import BytesIO

from .hazard_mapping import (
    MultiHazardAssessment, HazardType, RiskLevel, GeographicBounds
)
from .realtime_hazard_updates import HazardAlert

logger = logging.getLogger(__name__)


class AudienceType(Enum):
    """Target audience types for hazard communication"""
    SCIENTIFIC = "scientific"
    EMERGENCY_MANAGEMENT = "emergency_management"
    GENERAL_PUBLIC = "general_public"
    MEDIA = "media"
    GOVERNMENT = "government"
    INDUSTRY = "industry"


class CommunicationFormat(Enum):
    """Communication format types"""
    TECHNICAL_REPORT = "technical_report"
    EXECUTIVE_SUMMARY = "executive_summary"
    PUBLIC_ADVISORY = "public_advisory"
    EMERGENCY_ALERT = "emergency_alert"
    INFOGRAPHIC = "infographic"
    INTERACTIVE_MAP = "interactive_map"
    SOCIAL_MEDIA = "social_media"


@dataclass
class CommunicationProduct:
    """Hazard communication product"""
    product_id: str
    timestamp: datetime
    audience_type: AudienceType
    format_type: CommunicationFormat
    title: str
    content: str
    visual_elements: List[Dict[str, Any]]
    urgency_level: int  # 1-5, 5 = most urgent
    language: str = "en"
    distribution_channels: List[str] = None


@dataclass
class VisualizationConfig:
    """Configuration for hazard visualizations"""
    map_type: str  # "risk_map", "probability_map", "uncertainty_map"
    color_scheme: str  # "traffic_light", "heat", "blue_red", "scientific"
    show_uncertainty: bool = True
    show_population_density: bool = True
    show_infrastructure: bool = True
    show_evacuation_routes: bool = False
    resolution: str = "high"  # "low", "medium", "high"
    projection: str = "mercator"


class HazardCommunicationEngine:
    """Engine for generating hazard communications for different audiences"""
    
    def __init__(self):
        self.communication_templates = {}
        self.visualization_generators = {}
        self.language_translations = {}
        self._initialize_templates()
        self._initialize_visualizations()
    
    def _initialize_templates(self):
        """Initialize communication templates for different audiences"""
        self.communication_templates = {
            AudienceType.SCIENTIFIC: {
                CommunicationFormat.TECHNICAL_REPORT: self._generate_scientific_report,
                CommunicationFormat.INTERACTIVE_MAP: self._generate_scientific_map
            },
            AudienceType.EMERGENCY_MANAGEMENT: {
                CommunicationFormat.EXECUTIVE_SUMMARY: self._generate_emergency_summary,
                CommunicationFormat.EMERGENCY_ALERT: self._generate_emergency_alert,
                CommunicationFormat.INTERACTIVE_MAP: self._generate_emergency_map
            },
            AudienceType.GENERAL_PUBLIC: {
                CommunicationFormat.PUBLIC_ADVISORY: self._generate_public_advisory,
                CommunicationFormat.INFOGRAPHIC: self._generate_public_infographic,
                CommunicationFormat.SOCIAL_MEDIA: self._generate_social_media_post
            },
            AudienceType.MEDIA: {
                CommunicationFormat.EXECUTIVE_SUMMARY: self._generate_media_summary,
                CommunicationFormat.INFOGRAPHIC: self._generate_media_infographic
            },
            AudienceType.GOVERNMENT: {
                CommunicationFormat.EXECUTIVE_SUMMARY: self._generate_government_summary,
                CommunicationFormat.TECHNICAL_REPORT: self._generate_government_report
            },
            AudienceType.INDUSTRY: {
                CommunicationFormat.TECHNICAL_REPORT: self._generate_industry_report,
                CommunicationFormat.EXECUTIVE_SUMMARY: self._generate_industry_summary
            }
        }
    
    def _initialize_visualizations(self):
        """Initialize visualization generators"""
        self.visualization_generators = {
            "risk_map": self._generate_risk_map,
            "probability_map": self._generate_probability_map,
            "uncertainty_map": self._generate_uncertainty_map,
            "timeline_chart": self._generate_timeline_chart,
            "hazard_comparison": self._generate_hazard_comparison,
            "population_impact": self._generate_population_impact_chart
        }
    
    async def generate_communication_product(
        self,
        assessment: MultiHazardAssessment,
        audience_type: AudienceType,
        format_type: CommunicationFormat,
        alert: Optional[HazardAlert] = None,
        custom_config: Optional[Dict[str, Any]] = None
    ) -> CommunicationProduct:
        """Generate communication product for specific audience and format"""
        
        logger.info(f"Generating {format_type.value} for {audience_type.value}")
        
        # Get appropriate template generator
        template_generator = self.communication_templates.get(
            audience_type, {}
        ).get(format_type)
        
        if not template_generator:
            raise ValueError(f"No template for {audience_type.value} - {format_type.value}")
        
        # Generate content
        content_data = await template_generator(assessment, alert, custom_config)
        
        # Generate visual elements
        visual_elements = await self._generate_visual_elements(
            assessment, audience_type, format_type, custom_config
        )
        
        # Determine urgency level
        urgency_level = self._calculate_urgency_level(assessment, alert)
        
        # Create communication product
        product = CommunicationProduct(
            product_id=f"{audience_type.value}_{format_type.value}_{datetime.now().strftime('%Y%m%d_%H%M%S')}",
            timestamp=datetime.now(),
            audience_type=audience_type,
            format_type=format_type,
            title=content_data['title'],
            content=content_data['content'],
            visual_elements=visual_elements,
            urgency_level=urgency_level,
            distribution_channels=content_data.get('distribution_channels', [])
        )
        
        logger.info(f"Communication product generated: {product.product_id}")
        return product
    
    async def _generate_scientific_report(
        self,
        assessment: MultiHazardAssessment,
        alert: Optional[HazardAlert],
        config: Optional[Dict[str, Any]]
    ) -> Dict[str, Any]:
        """Generate technical scientific report"""
        
        # Calculate key statistics
        max_risk = np.max(assessment.combined_risk_map)
        mean_risk = np.mean(assessment.combined_risk_map)
        risk_area = np.sum(assessment.combined_risk_map > 0.3)  # Area above moderate risk
        
        # Identify dominant hazards
        dominant_hazards = sorted(
            assessment.individual_hazards.items(),
            key=lambda x: x[1].probability,
            reverse=True
        )[:3]
        
        content = f"""
# Multi-Hazard Risk Assessment Report

**Assessment ID:** {assessment.assessment_id}
**Timestamp:** {assessment.timestamp.strftime('%Y-%m-%d %H:%M:%S UTC')}
**Geographic Bounds:** {assessment.geographic_bounds.min_lat:.4f}°N to {assessment.geographic_bounds.max_lat:.4f}°N, {assessment.geographic_bounds.min_lon:.4f}°E to {assessment.geographic_bounds.max_lon:.4f}°E

## Executive Summary

This multi-hazard assessment identifies significant geological risks within the specified region. The analysis incorporates real-time monitoring data and physics-informed neural network models to provide probabilistic hazard estimates with uncertainty quantification.

**Key Findings:**
- Maximum combined risk level: {max_risk:.3f}
- Mean regional risk: {mean_risk:.3f}
- Area exceeding moderate risk threshold: {risk_area} grid cells
- Population at risk: {assessment.total_population_at_risk:,} individuals
- Estimated economic impact: ${assessment.economic_impact_estimate:,.0f}

## Individual Hazard Analysis

"""
        
        for hazard_type, hazard_prob in dominant_hazards:
            content += f"""
### {hazard_type.value.replace('_', ' ').title()}
- **Probability:** {hazard_prob.probability:.3f} ({hazard_prob.probability*100:.1f}%)
- **Confidence Interval:** [{hazard_prob.confidence_interval[0]:.3f}, {hazard_prob.confidence_interval[1]:.3f}]
- **Uncertainty:** {hazard_prob.uncertainty:.3f}
- **Time Window:** {hazard_prob.time_window.days} days
- **Contributing Factors:** {', '.join(hazard_prob.contributing_factors)}
"""
        
        content += f"""
## Cascading Effects Analysis

The following cascading relationships were identified:
"""
        
        for primary, secondaries in assessment.cascading_effects.items():
            if secondaries:
                secondary_list = ', '.join([h.value.replace('_', ' ').title() for h in secondaries])
                content += f"- **{primary.value.replace('_', ' ').title()}** → {secondary_list}\n"
        
        content += f"""
## Uncertainty Analysis

The uncertainty map reveals spatial variations in model confidence. Mean uncertainty across the region is {np.mean(assessment.uncertainty_map):.3f}, with maximum uncertainty of {np.max(assessment.uncertainty_map):.3f}. High uncertainty areas require additional monitoring and data collection.

## Recommendations

1. **Enhanced Monitoring:** Deploy additional sensors in high-risk, high-uncertainty areas
2. **Model Validation:** Compare predictions with independent datasets
3. **Stakeholder Communication:** Disseminate findings to relevant authorities
4. **Contingency Planning:** Update emergency response plans based on risk assessment
5. **Regular Updates:** Reassess risk as new monitoring data becomes available

## Technical Details

- **Model Framework:** Physics-Informed Neural Networks (PINNs) with ensemble uncertainty quantification
- **Spatial Resolution:** {assessment.geographic_bounds.resolution}° grid spacing
- **Temporal Resolution:** Real-time updates with {assessment.timestamp.strftime('%H:%M')} UTC assessment time
- **Data Sources:** Multi-sensor fusion including seismic, geodetic, geochemical, and satellite observations
"""
        
        return {
            'title': f'Multi-Hazard Risk Assessment Report - {assessment.timestamp.strftime("%Y-%m-%d")}',
            'content': content,
            'distribution_channels': ['scientific_journals', 'research_networks', 'observatory_systems']
        }
    
    async def _generate_emergency_summary(
        self,
        assessment: MultiHazardAssessment,
        alert: Optional[HazardAlert],
        config: Optional[Dict[str, Any]]
    ) -> Dict[str, Any]:
        """Generate executive summary for emergency management"""
        
        # Determine alert status
        alert_status = "NORMAL"
        if alert:
            if alert.risk_level in [RiskLevel.HIGH, RiskLevel.VERY_HIGH, RiskLevel.EXTREME]:
                alert_status = "ELEVATED"
            if alert.risk_level == RiskLevel.EXTREME:
                alert_status = "CRITICAL"
        
        # Identify primary threats
        primary_threats = sorted(
            assessment.individual_hazards.items(),
            key=lambda x: x[1].probability,
            reverse=True
        )[:2]
        
        content = f"""
# EMERGENCY MANAGEMENT BRIEFING

**ALERT STATUS: {alert_status}**
**Assessment Time:** {assessment.timestamp.strftime('%Y-%m-%d %H:%M UTC')}
**Next Update:** {(assessment.timestamp + timedelta(hours=6)).strftime('%Y-%m-%d %H:%M UTC')}

## SITUATION OVERVIEW

Current geological hazard assessment indicates {alert_status.lower()} risk conditions in the monitored region.

**IMMEDIATE CONCERNS:**
"""
        
        for hazard_type, hazard_prob in primary_threats:
            risk_percentage = hazard_prob.probability * 100
            content += f"- **{hazard_type.value.replace('_', ' ').title()}:** {risk_percentage:.0f}% probability\n"
        
        content += f"""
**POPULATION IMPACT:**
- At-risk population: {assessment.total_population_at_risk:,} individuals
- Economic exposure: ${assessment.economic_impact_estimate/1000000:.1f}M

## RECOMMENDED ACTIONS

"""
        
        if alert and alert.recommended_actions:
            for i, action in enumerate(alert.recommended_actions, 1):
                content += f"{i}. {action}\n"
        else:
            content += """1. Continue routine monitoring
2. Review emergency response plans
3. Maintain communication with monitoring agencies
4. Prepare for potential escalation
"""
        
        if alert and alert.escalation_level >= 3:
            content += f"""
## ESCALATION PROTOCOLS

**Current Escalation Level:** {alert.escalation_level}/5
**Alert Expires:** {alert.expires_at.strftime('%Y-%m-%d %H:%M UTC')}

Consider activating:
- Emergency Operations Center (EOC)
- Public warning systems
- Evacuation planning procedures
- Resource pre-positioning
"""
        
        content += f"""
## MONITORING STATUS

Real-time monitoring systems are operational and providing continuous updates. Key indicators being tracked:
- Seismic activity levels
- Ground deformation patterns
- Gas emission rates
- Thermal anomalies

## CONTACT INFORMATION

- **24/7 Monitoring Center:** [Contact Details]
- **Scientific Coordinator:** [Contact Details]
- **Emergency Management Liaison:** [Contact Details]

*This briefing is automatically generated from real-time monitoring data and AI-powered risk assessment models.*
"""
        
        return {
            'title': f'Emergency Management Briefing - {alert_status} - {assessment.timestamp.strftime("%Y-%m-%d %H:%M")}',
            'content': content,
            'distribution_channels': ['emergency_management', 'government_agencies', 'first_responders']
        }
    
    async def _generate_public_advisory(
        self,
        assessment: MultiHazardAssessment,
        alert: Optional[HazardAlert],
        config: Optional[Dict[str, Any]]
    ) -> Dict[str, Any]:
        """Generate public advisory in plain language"""
        
        # Determine risk level for public communication
        max_risk = np.max(assessment.combined_risk_map)
        if max_risk < 0.2:
            risk_description = "LOW"
            risk_color = "green"
        elif max_risk < 0.4:
            risk_description = "MODERATE"
            risk_color = "yellow"
        elif max_risk < 0.7:
            risk_description = "HIGH"
            risk_color = "orange"
        else:
            risk_description = "VERY HIGH"
            risk_color = "red"
        
        # Identify main hazard in simple terms
        primary_hazard = max(
            assessment.individual_hazards.items(),
            key=lambda x: x[1].probability
        )[0]
        
        hazard_descriptions = {
            HazardType.VOLCANIC_ERUPTION: "volcanic activity",
            HazardType.SEISMIC_EARTHQUAKE: "earthquake activity",
            HazardType.LANDSLIDE: "landslide conditions",
            HazardType.TSUNAMI: "tsunami conditions",
            HazardType.PYROCLASTIC_FLOW: "volcanic hazards",
            HazardType.LAHAR: "volcanic mudflow hazards",
            HazardType.ASH_FALL: "volcanic ash hazards",
            HazardType.LAVA_FLOW: "lava flow hazards"
        }
        
        main_hazard_desc = hazard_descriptions.get(primary_hazard, "geological activity")
        
        content = f"""
# PUBLIC SAFETY ADVISORY

**Current Risk Level: {risk_description}**
**Last Updated:** {assessment.timestamp.strftime('%B %d, %Y at %I:%M %p')}

## What's Happening

Scientists are monitoring {main_hazard_desc} in your area. Based on current data and computer models, the risk level is **{risk_description}**.

## What This Means for You

"""
        
        if risk_description == "LOW":
            content += """
- Normal daily activities can continue
- Stay informed about changing conditions
- Review your emergency preparedness plans
"""
        elif risk_description == "MODERATE":
            content += """
- Be aware of changing conditions
- Review your emergency supplies and plans
- Stay tuned to official information sources
- Avoid high-risk areas if possible
"""
        elif risk_description == "HIGH":
            content += """
- Take precautionary measures seriously
- Prepare to take protective action if advised
- Keep emergency supplies ready
- Follow guidance from local authorities
- Avoid unnecessary travel to affected areas
"""
        else:  # VERY HIGH
            content += """
- Be prepared to take immediate protective action
- Follow all official evacuation orders
- Stay away from dangerous areas
- Keep emergency supplies with you
- Monitor emergency broadcasts continuously
"""
        
        if alert and alert.recommended_actions:
            content += "\n## What You Should Do\n\n"
            for action in alert.recommended_actions:
                # Simplify technical language for public
                simplified_action = self._simplify_for_public(action)
                content += f"- {simplified_action}\n"
        
        content += f"""
## Stay Informed

- **Official Updates:** Check local emergency management websites
- **Emergency Alerts:** Sign up for community alert systems
- **Social Media:** Follow official accounts for updates
- **Radio/TV:** Monitor local news and emergency broadcasts

## Emergency Contacts

- **Emergency Services:** 911
- **Local Emergency Management:** [Local Contact]
- **Information Hotline:** [Hotline Number]

## Frequently Asked Questions

**Q: How often is this information updated?**
A: Risk assessments are updated continuously as new data becomes available, typically every few hours.

**Q: How accurate are these predictions?**
A: Our assessments use the latest scientific methods and real-time data. However, natural hazards can be unpredictable, so it's important to stay prepared.

**Q: What should I include in my emergency kit?**
A: Water (1 gallon per person per day), non-perishable food, flashlight, battery-powered radio, first aid kit, medications, and important documents.

*This advisory is generated from scientific monitoring data and computer models. Always follow guidance from local emergency management officials.*
"""
        
        return {
            'title': f'Public Safety Advisory - {risk_description} Risk - {assessment.timestamp.strftime("%B %d, %Y")}',
            'content': content,
            'distribution_channels': ['public_websites', 'social_media', 'local_media', 'emergency_alert_systems']
        }
    
    def _simplify_for_public(self, technical_action: str) -> str:
        """Simplify technical language for public consumption"""
        simplifications = {
            "Monitor volcanic activity closely": "Stay informed about volcano conditions",
            "Prepare evacuation plans": "Know your evacuation routes and meeting places",
            "Check emergency supplies": "Make sure you have emergency supplies ready",
            "Secure heavy objects": "Secure items that could fall during shaking",
            "Review earthquake safety procedures": "Practice earthquake safety (Drop, Cover, Hold On)",
            "Check building structural integrity": "Have buildings inspected if you notice damage",
            "Avoid steep slopes": "Stay away from hillsides and steep areas",
            "Monitor drainage systems": "Watch for water buildup that could cause problems",
            "Move to higher ground": "Go to higher elevation areas",
            "Stay away from coastlines": "Avoid beaches and coastal areas",
            "Consider evacuation": "Be ready to leave if officials tell you to",
            "Contact emergency services": "Call 911 if you need help",
            "Immediate evacuation recommended": "Leave the area now as directed by officials"
        }
        
        for technical, simple in simplifications.items():
            if technical.lower() in technical_action.lower():
                return simple
        
        return technical_action
    
    async def _generate_emergency_alert(
        self,
        assessment: MultiHazardAssessment,
        alert: Optional[HazardAlert],
        config: Optional[Dict[str, Any]]
    ) -> Dict[str, Any]:
        """Generate emergency alert message"""
        
        if not alert:
            return {
                'title': 'No Active Alert',
                'content': 'No emergency alert conditions detected.',
                'distribution_channels': []
            }
        
        urgency_text = {
            1: "ADVISORY",
            2: "WATCH", 
            3: "WARNING",
            4: "URGENT",
            5: "EMERGENCY"
        }.get(alert.escalation_level, "ALERT")
        
        hazard_name = alert.hazard_type.value.replace('_', ' ').title()
        
        content = f"""
**{urgency_text}: {hazard_name}**

**Issued:** {alert.timestamp.strftime('%Y-%m-%d %H:%M UTC')}
**Expires:** {alert.expires_at.strftime('%Y-%m-%d %H:%M UTC')}
**Risk Level:** {alert.risk_level.name}

**AFFECTED AREA:**
Latitude: {alert.affected_area.min_lat:.3f}° to {alert.affected_area.max_lat:.3f}°
Longitude: {alert.affected_area.min_lon:.3f}° to {alert.affected_area.max_lon:.3f}°

**POPULATION AT RISK:** {alert.population_at_risk:,}

**IMMEDIATE ACTIONS REQUIRED:**
"""
        
        for i, action in enumerate(alert.recommended_actions, 1):
            content += f"{i}. {action}\n"
        
        content += f"""
**CONFIDENCE LEVEL:** {alert.confidence*100:.0f}%

This is an automated alert generated from real-time monitoring systems. Follow all official instructions from local emergency management.

Alert ID: {alert.alert_id}
"""
        
        return {
            'title': f'{urgency_text}: {hazard_name} - {alert.timestamp.strftime("%Y-%m-%d %H:%M")}',
            'content': content,
            'distribution_channels': ['emergency_alert_system', 'first_responders', 'media', 'government']
        }
    
