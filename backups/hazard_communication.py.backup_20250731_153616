            assessment.individual_hazards.items(),
            key=lambda x: x[1].probability
        )[0]
        
        hazard_emojis = {
            HazardType.VOLCANIC_ERUPTION: "🌋",
            HazardType.SEISMIC_EARTHQUAKE: "🏠",
            HazardType.LANDSLIDE: "⛰️",
            HazardType.TSUNAMI: "🌊"
        }
        
        hazard_emoji = hazard_emojis.get(primary_hazard, "⚠️")
        
        content = f"""
{emoji} HAZARD UPDATE {hazard_emoji}

Current risk level: {status}
Monitoring: {primary_hazard.value.replace('_', ' ').title()}
Population monitored: {assessment.total_population_at_risk:,}

Stay informed and prepared! 
📱 Get alerts: [link]
📋 Emergency kit checklist: [link]

#GeologicalHazards #PublicSafety #EmergencyPreparedness

Last updated: {assessment.timestamp.strftime('%m/%d %I:%M%p')}
"""
        
        return {
            'title': f'Hazard Update - {status} - {assessment.timestamp.strftime("%m/%d")}',
            'content': content,
            'distribution_channels': ['twitter', 'facebook', 'instagram', 'emergency_apps']
        }
    
    async def _generate_visual_elements(
        self,
        assessment: MultiHazardAssessment,
        audience_type: AudienceType,
        format_type: CommunicationFormat,
        config: Optional[Dict[str, Any]]
    ) -> List[Dict[str, Any]]:
        """Generate visual elements for communication products"""
        
        visual_elements = []
        
        # Determine appropriate visualizations based on audience and format
        if audience_type == AudienceType.SCIENTIFIC:
            visual_elements.extend([
                await self._generate_risk_map(assessment, "scientific"),
                await self._generate_uncertainty_map(assessment, "scientific"),
                await self._generate_hazard_comparison(assessment, "scientific")
            ])
        
        elif audience_type == AudienceType.EMERGENCY_MANAGEMENT:
            visual_elements.extend([
                await self._generate_risk_map(assessment, "operational"),
                await self._generate_population_impact_chart(assessment, "operational")
            ])
        
        elif audience_type == AudienceType.GENERAL_PUBLIC:
            visual_elements.extend([
                await self._generate_risk_map(assessment, "public"),
                await self._generate_timeline_chart(assessment, "public")
            ])
        
        return visual_elements
    
