    def load_quantum_model(self, filepath: str):
        """Load quantum-enhanced model state"""
        
        import json
        with open(filepath, 'r') as f:
            quantum_state = json.load(f)
        
        # Restore quantum circuit parameters
        self.quantum_circuit.parameters = np.array(quantum_state['quantum_circuit_parameters'])
        
        # Restore quantum neural network weights
        self.quantum_nn.quantum_weights = np.array(quantum_state['quantum_nn_weights']['quantum_weights'])
        self.quantum_nn.classical_weights = np.array(quantum_state['quantum_nn_weights']['classical_weights'])
        
        # Restore QAOA parameters
        self.qaoa_optimizer.beta_params = np.array(quantum_state['qaoa_parameters']['beta_params'])
        self.qaoa_optimizer.gamma_params = np.array(quantum_state['qaoa_parameters']['gamma_params'])
        
        # Restore training history
        self.training_history = quantum_state['training_history']
        self.quantum_advantage_achieved = quantum_state['quantum_advantage_achieved']
        
        logger.info(f"Quantum model loaded from {filepath}")