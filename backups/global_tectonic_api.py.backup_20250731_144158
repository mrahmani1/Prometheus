@router.post("/export/{simulation_id}")
async def export_simulation_data(
    simulation_id: str = Path(..., description="Simulation ID"),
    export_format: str = Body(..., description="Export format: animation, data, images"),
    export_options: Dict[str, Any] = Body({}, description="Export options")
):
    """Export simulation data in various formats"""
    
    if simulation_id not in active_simulations:
        raise HTTPException(status_code=404, detail="Simulation not found")
    
    sim_data = active_simulations[simulation_id]
    
    if sim_data['status'] != 'completed':
        raise HTTPException(status_code=400, detail="Simulation not completed")
    
    if export_format == "animation":
        # Would generate animation file
        return {"message": "Animation export started", "export_id": f"export_{simulation_id}_animation"}
    elif export_format == "data":
        # Would export raw data
        return {"message": "Data export started", "export_id": f"export_{simulation_id}_data"}
    elif export_format == "images":
        # Would export image sequence
        return {"message": "Image export started", "export_id": f"export_{simulation_id}_images"}
    else:
        raise HTTPException(status_code=400, detail="Unsupported export format")

@router.delete("/simulate/{simulation_id}")
async def cancel_simulation(simulation_id: str = Path(..., description="Simulation ID")):
    """Cancel a running simulation"""
    
    if simulation_id not in active_simulations:
        raise HTTPException(status_code=404, detail="Simulation not found")
    
    sim_data = active_simulations[simulation_id]
    
    if sim_data['status'] in ['completed', 'failed']:
        raise HTTPException(status_code=400, detail="Cannot cancel completed simulation")
    
    # Cancel simulation (would implement actual cancellation logic)
    active_simulations[simulation_id]['status'] = 'cancelled'
    active_simulations[simulation_id]['updated_at'] = datetime.now()
    
    return {"message": "Simulation cancelled successfully"}

