    """Get information about active volcanic systems"""
    
    volcanic_systems = []
    
    # Get volcanic systems from hotspot database
    for hotspot_id, hotspot_data in tectonic_engine.hotspot_database['major_hotspots'].items():
        system = VolcanicSystemInfo(
            system_id=hotspot_id,
            name=hotspot_id.replace('_', ' ').title(),
            system_type='hotspot',
            location=list(hotspot_data['location']),
            activity_level=0.8,  # Would be calculated from current data
            temperature_anomaly=hotspot_data['temperature_anomaly'],
            magma_production_rate=hotspot_data['magma_production'],
            hazard_assessment={'eruption_probability': 0.1, 'impact_radius': 100}
        )
        volcanic_systems.append(system)
    
    return volcanic_systems

