# Pydantic models for API requests/responses
class SimulationParameters(BaseModel):
    """Parameters for tectonic simulation"""
    start_time: float = Field(-200, description="Start time in Ma (negative for past)")
    end_time: float = Field(0, description="End time in Ma")
    time_step: float = Field(1.0, description="Time step in Ma")
    resolution: str = Field("medium", description="Simulation resolution: low, medium, high, ultra")
    include_mantle_convection: bool = Field(True, description="Include mantle convection modeling")
    include_plume_dynamics: bool = Field(True, description="Include mantle plume dynamics")
    include_volcanic_systems: bool = Field(True, description="Include volcanic system evolution")
    
    @validator('start_time')
    def validate_start_time(cls, v):
        if v > 0:
            raise ValueError('Start time must be negative (past) or zero (present)')
        if v < -4000:
            raise ValueError('Start time cannot be older than 4000 Ma')
        return v
    
    @validator('end_time')
    def validate_end_time(cls, v):
        if v > 0:
            raise ValueError('End time must be negative (past) or zero (present)')
        return v

class UserConstraints(BaseModel):
    """User-specified constraints for simulation"""
    fixed_plates: Optional[List[str]] = Field(None, description="Plates to keep fixed")
    custom_hotspots: Optional[List[Dict[str, Any]]] = Field(None, description="Custom hotspot locations")
    boundary_conditions: Optional[Dict[str, Any]] = Field(None, description="Custom boundary conditions")
    initial_temperature_field: Optional[List[List[List[float]]]] = Field(None, description="Custom initial temperature")
    plate_velocities: Optional[Dict[str, List[float]]] = Field(None, description="Custom plate velocities")

class RegionFocus(BaseModel):
    """Region focus parameters"""
    region_name: str = Field("global", description="Region name or 'custom'")
    custom_bounds: Optional[Dict[str, float]] = Field(None, description="Custom lat/lon bounds")
    zoom_level: float = Field(1.0, description="Zoom level (1.0 = global)")
    center_point: Optional[List[float]] = Field(None, description="Center point [lat, lon]")

class VisualizationSettings(BaseModel):
    """Visualization settings"""
    show_plates: bool = True
    show_boundaries: bool = True
    show_volcanoes: bool = True
    show_plumes: bool = True
    show_velocity_vectors: bool = False
    show_age_colors: bool = True
    show_topography: bool = True
    show_heat_flow: bool = False
    color_scheme: str = Field("default", description="Color scheme: default, scientific, artistic")
    animation_quality: str = Field("high", description="Animation quality: low, medium, high, ultra")

class SimulationRequest(BaseModel):
    """Complete simulation request"""
    parameters: SimulationParameters
    constraints: Optional[UserConstraints] = None
    region_focus: Optional[RegionFocus] = None
    visualization: Optional[VisualizationSettings] = None
    export_options: Optional[Dict[str, Any]] = None

class SimulationStatus(BaseModel):
    """Simulation status response"""
    simulation_id: str
    status: str  # queued, running, completed, failed
    progress: float  # 0.0 to 1.0
    current_stage: str
    estimated_completion: Optional[datetime]
    error_message: Optional[str]
    created_at: datetime
    updated_at: datetime

class PlateInfo(BaseModel):
    """Tectonic plate information"""
    plate_id: str
    name: str
    plate_type: str
    area: float
    current_location: List[List[float]]  # boundary coordinates
    motion_vector: List[float]
    age_range: List[float]
    geological_features: List[str]

class VolcanicSystemInfo(BaseModel):
    """Volcanic system information"""
    system_id: str
    name: str
    system_type: str
    location: List[float]  # lat, lon, depth
    activity_level: float
    temperature_anomaly: float
    magma_production_rate: float
    hazard_assessment: Dict[str, float]

# Global simulation tracking
active_simulations: Dict[str, Dict[str, Any]] = {}

@router.post("/simulate", response_model=Dict[str, str])
async def start_simulation(
    request: SimulationRequest,
    background_tasks: BackgroundTasks
) -> Dict[str, str]:
    """
    Start a new global tectonic simulation
    """
    
    # Generate unique simulation ID
    simulation_id = f"sim_{datetime.now().strftime('%Y%m%d_%H%M%S')}_{np.random.randint(1000, 9999)}"
    
    # Initialize simulation status
    active_simulations[simulation_id] = {
        'status': 'queued',
        'progress': 0.0,
        'current_stage': 'initialization',
        'created_at': datetime.now(),
        'updated_at': datetime.now(),
        'parameters': request.parameters.dict(),
        'constraints': request.constraints.dict() if request.constraints else None,
        'region_focus': request.region_focus.dict() if request.region_focus else None,
        'visualization': request.visualization.dict() if request.visualization else None
    }
    
    # Start simulation in background
    background_tasks.add_task(
        run_simulation_background,
        simulation_id,
        request
    )
    
    logger.info(f"Started simulation {simulation_id}")
    
    return {
        "simulation_id": simulation_id,
        "status": "queued",
        "message": "Simulation started successfully"
    }

async def run_simulation_background(simulation_id: str, request: SimulationRequest):
    """Run simulation in background task"""
    
    try:
        # Update status
        active_simulations[simulation_id]['status'] = 'running'
        active_simulations[simulation_id]['current_stage'] = 'plate_reconstruction'
        active_simulations[simulation_id]['updated_at'] = datetime.now()
        
        # Run plate evolution simulation
        plate_results = await tectonic_engine.simulate_plate_evolution(
            start_time=request.parameters.start_time,
            end_time=request.parameters.end_time,
            time_step=request.parameters.time_step,
            user_constraints=request.constraints.dict() if request.constraints else None
        )
        
        active_simulations[simulation_id]['progress'] = 0.5
        active_simulations[simulation_id]['current_stage'] = 'mantle_convection'
        
        # Run mantle convection simulation if requested
        mantle_results = None
        if request.parameters.include_mantle_convection:
            simulation_time = abs(request.parameters.end_time - request.parameters.start_time)
            mantle_results = await mantle_engine.simulate_mantle_convection(
                simulation_time=simulation_time,
                resolution=(64, 64, 32) if request.parameters.resolution == "medium" else (32, 32, 16)
            )
        
        active_simulations[simulation_id]['progress'] = 0.8
        active_simulations[simulation_id]['current_stage'] = 'post_processing'
        
        # Combine results
        combined_results = {
            'simulation_id': simulation_id,
            'parameters': request.parameters.dict(),
            'plate_evolution': plate_results,
            'mantle_convection': mantle_results,
            'processing_metadata': {
                'completion_time': datetime.now().isoformat(),
                'total_time_points': len(plate_results['evolution_data']['time_points']),
                'data_size_mb': 0  # Would calculate actual size
            }
        }
        
        # Store results
        active_simulations[simulation_id]['results'] = combined_results
        active_simulations[simulation_id]['status'] = 'completed'
        active_simulations[simulation_id]['progress'] = 1.0
        active_simulations[simulation_id]['current_stage'] = 'completed'
        active_simulations[simulation_id]['updated_at'] = datetime.now()
        
        logger.info(f"Completed simulation {simulation_id}")
        
    except Exception as e:
        logger.error(f"Simulation {simulation_id} failed: {str(e)}")
        active_simulations[simulation_id]['status'] = 'failed'
        active_simulations[simulation_id]['error_message'] = str(e)
        active_simulations[simulation_id]['updated_at'] = datetime.now()

@router.get("/simulate/{simulation_id}/status", response_model=SimulationStatus)
async def get_simulation_status(simulation_id: str = Path(..., description="Simulation ID")):
    """Get simulation status"""
    
    if simulation_id not in active_simulations:
        raise HTTPException(status_code=404, detail="Simulation not found")
    
    sim_data = active_simulations[simulation_id]
    
    return SimulationStatus(
        simulation_id=simulation_id,
        status=sim_data['status'],
        progress=sim_data['progress'],
        current_stage=sim_data['current_stage'],
        estimated_completion=None,  # Would calculate based on progress
        error_message=sim_data.get('error_message'),
        created_at=sim_data['created_at'],
        updated_at=sim_data['updated_at']
    )

@router.get("/simulate/{simulation_id}/results")
async def get_simulation_results(
    simulation_id: str = Path(..., description="Simulation ID"),
    format: str = Query("json", description="Result format: json, hdf5, netcdf")
):
    """Get simulation results"""
    
    if simulation_id not in active_simulations:
        raise HTTPException(status_code=404, detail="Simulation not found")
    
    sim_data = active_simulations[simulation_id]
    
    if sim_data['status'] != 'completed':
        raise HTTPException(status_code=400, detail="Simulation not completed")
    
    if 'results' not in sim_data:
        raise HTTPException(status_code=500, detail="Results not available")
    
    results = sim_data['results']
    
    if format == "json":
        return results
    elif format == "hdf5":
        # Would export to HDF5 format
        raise HTTPException(status_code=501, detail="HDF5 export not implemented")
    elif format == "netcdf":
        # Would export to NetCDF format
        raise HTTPException(status_code=501, detail="NetCDF export not implemented")
    else:
        raise HTTPException(status_code=400, detail="Unsupported format")

@router.get("/simulate/{simulation_id}/visualization")
async def get_visualization_data(
    simulation_id: str = Path(..., description="Simulation ID"),
    time_point: Optional[float] = Query(None, description="Specific time point in Ma"),
    region: Optional[str] = Query("global", description="Region focus"),
    data_type: str = Query("all", description="Data type: plates, volcanoes, plumes, all")
):
    """Get visualization data for specific time point"""
    
    if simulation_id not in active_simulations:
        raise HTTPException(status_code=404, detail="Simulation not found")
    
    sim_data = active_simulations[simulation_id]
    
    if sim_data['status'] != 'completed':
        raise HTTPException(status_code=400, detail="Simulation not completed")
    
    results = sim_data['results']
    
    # Extract visualization data for specific time point
    if time_point is None:
        time_point = 0.0  # Present day
    
    # Find closest time point in results
    time_points = results['plate_evolution']['evolution_data']['time_points']
    closest_idx = np.argmin(np.abs(np.array(time_points) - time_point))
    actual_time = time_points[closest_idx]
    
    visualization_data = {
        'time_point': actual_time,
        'region': region,
        'data_type': data_type
    }
    
    if data_type in ['plates', 'all']:
        plate_positions = results['plate_evolution']['evolution_data']['plate_positions'][closest_idx]
        visualization_data['plates'] = plate_positions
    
    if data_type in ['volcanoes', 'all']:
        volcanic_activity = results['plate_evolution']['evolution_data']['volcanic_activity'][closest_idx]
        visualization_data['volcanoes'] = volcanic_activity
    
    if data_type in ['plumes', 'all'] and results['mantle_convection']:
        # Extract plume data from mantle convection results
        plume_tracks = results['mantle_convection']['plume_tracks']
        current_plumes = {}
        for plume_id, track in plume_tracks.items():
            # Find plume state at current time
            for track_point in track:
                if abs(track_point['time'] - actual_time) < 0.5:  # Within 0.5 Ma
                    current_plumes[plume_id] = track_point
                    break
        visualization_data['plumes'] = current_plumes
    
    return visualization_data

@router.get("/plates", response_model=List[PlateInfo])
async def get_current_plates():
    """Get information about current tectonic plates"""
    
    # Get current plate configuration
    current_plates = await tectonic_engine._reconstruct_plates_at_time(0.0)
    
    plate_info = []
    for plate_id, plate in current_plates.items():
        info = PlateInfo(
            plate_id=plate.plate_id,
            name=plate.name,
            plate_type=plate.plate_type,
            area=plate.area,
            current_location=plate.boundary_vertices.tolist(),
            motion_vector=plate.motion_vector.tolist(),
            age_range=list(plate.age_range),
            geological_features=[]  # Would be populated with actual features
        )
        plate_info.append(info)
    
    return plate_info

