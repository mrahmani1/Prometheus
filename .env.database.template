# Database Configuration Environment Variables Template
# Copy this file to .env and update with your actual values

# Environment Configuration
ENVIRONMENT=development
DB_CONFIG_DIR=./config/database

# Database Encryption (for credential security)
DB_ENCRYPTION_PASSWORD=prometheus-default-key
DB_ENCRYPTION_SALT=prometheus-salt

# PostgreSQL Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USERNAME=prometheus
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DATABASE=prometheus_dev

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# InfluxDB Configuration
INFLUXDB_HOST=localhost
INFLUXDB_PORT=8086
INFLUXDB_TOKEN=change_me_in_production
INFLUXDB_ORG=prometheus_dev
INFLUXDB_BUCKET=geological_data_dev

# Neo4j Configuration
NEO4J_HOST=localhost
NEO4J_PORT=7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=change_me_in_production
NEO4J_DATABASE=neo4j

# TimescaleDB Configuration
TIMESCALEDB_HOST=localhost
TIMESCALEDB_PORT=5432
TIMESCALEDB_USERNAME=prometheus
TIMESCALEDB_PASSWORD=change_me_in_production
TIMESCALEDB_DATABASE=prometheus_timeseries_dev

# MongoDB Configuration
MONGODB_HOST=localhost
MONGODB_PORT=27017
MONGODB_USERNAME=prometheus
MONGODB_PASSWORD=change_me_in_production
MONGODB_DATABASE=prometheus_documents_dev

# Elasticsearch Configuration
ELASTICSEARCH_HOST=localhost
ELASTICSEARCH_PORT=9200
ELASTICSEARCH_USERNAME=elastic
ELASTICSEARCH_PASSWORD=change_me_in_production

# Kafka Configuration
KAFKA_HOST=localhost
KAFKA_PORT=9092
KAFKA_USERNAME=
KAFKA_PASSWORD=

# SSL Configuration (Production)
SSL_ENABLED=false
SSL_VERIFY=true

# PostgreSQL SSL
POSTGRES_SSL_CA_PATH=/etc/ssl/certs/postgres-ca.crt
POSTGRES_SSL_CERT_PATH=/etc/ssl/certs/postgres-client.crt
POSTGRES_SSL_KEY_PATH=/etc/ssl/private/postgres-client.key

# Redis SSL
REDIS_SSL_CA_PATH=/etc/ssl/certs/redis-ca.crt
REDIS_SSL_CERT_PATH=/etc/ssl/certs/redis-client.crt
REDIS_SSL_KEY_PATH=/etc/ssl/private/redis-client.key

# InfluxDB SSL
INFLUXDB_SSL_CA_PATH=/etc/ssl/certs/influxdb-ca.crt
INFLUXDB_SSL_CERT_PATH=/etc/ssl/certs/influxdb-client.crt
INFLUXDB_SSL_KEY_PATH=/etc/ssl/private/influxdb-client.key

# Neo4j SSL
NEO4J_SSL_CA_PATH=/etc/ssl/certs/neo4j-ca.crt
NEO4J_SSL_CERT_PATH=/etc/ssl/certs/neo4j-client.crt
NEO4J_SSL_KEY_PATH=/etc/ssl/private/neo4j-client.key

# Service Discovery (Consul)
CONSUL_ENABLED=false
CONSUL_HOST=localhost
CONSUL_PORT=8500
CONSUL_TOKEN=

# Vault Integration
VAULT_ENABLED=false
VAULT_URL=https://vault.example.com
VAULT_TOKEN=
VAULT_PATH=database

# Connection Pool Configuration
POOL_MIN_CONNECTIONS=5
POOL_MAX_CONNECTIONS=20
POOL_MAX_OVERFLOW=30

# Timeout Configuration
CONNECTION_TIMEOUT=30
READ_TIMEOUT=60
WRITE_TIMEOUT=60

# Kubernetes Configuration (when running in K8s)
KUBERNETES_NAMESPACE=prometheus-ai