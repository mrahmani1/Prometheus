{
  "openapi": "3.0.3",
  "info": {
    "title": "Helios Core Service",
    "description": "Physics-Informed Neural Network engine for geological analysis and simulation",
    "version": "1.0.0",
    "contact": {
      "name": "Prometheus AI Platform Team",
      "email": "support@prometheus-ai.com",
      "url": "https://prometheus-ai.com/support"
    },
    "license": {
      "name": "MIT",
      "url": "https://opensource.org/licenses/MIT"
    }
  },
  "servers": [
    {
      "url": "http://localhost:8001",
      "description": "Development server"
    },
    {
      "url": "http://staging.prometheus-ai.com:8001",
      "description": "Staging server"
    },
    {
      "url": "http://api.prometheus-ai.com:8001",
      "description": "Production server"
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "summary": "Health Check",
        "description": "Check service health and status",
        "tags": [
          "Health"
        ],
        "operationId": "get__health",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Service is healthy",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string"
                    },
                    "timestamp": {
                      "type": "string"
                    },
                    "version": {
                      "type": "string"
                    },
                    "modules_loaded": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "x-examples": [
          {
            "name": "Health Check Example",
            "description": "Basic health check",
            "request": {},
            "response": {
              "status": "healthy",
              "timestamp": "2025-01-09T10:00:00Z",
              "version": "1.0.0",
              "modules_loaded": [
                "GeologicalPINNEngine",
                "MultiPhysicsCouplingEngine"
              ]
            }
          }
        ]
      }
    },
    "/analyze/geological": {
      "post": {
        "summary": "Geological Data Analysis",
        "description": "Perform advanced geological data analysis using Physics-Informed Neural Networks",
        "tags": [
          "Analysis",
          "Geological"
        ],
        "operationId": "post__analyze_geological",
        "parameters": [
          {
            "name": "X-Correlation-ID",
            "in": "header",
            "description": "Request correlation ID for tracking",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Analysis completed successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AnalysisResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request parameters",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GeologicalAnalysisRequest"
              }
            }
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "x-examples": [
          {
            "name": "Seismic Analysis Example",
            "description": "Analyze seismic data for volcanic region",
            "request": {
              "data_type": "seismic",
              "spatial_extent": {
                "min_lat": 45.0,
                "max_lat": 46.0,
                "min_lon": -122.0,
                "max_lon": -121.0
              },
              "temporal_range": {
                "start_time": "2025-01-01T00:00:00Z",
                "end_time": "2025-01-09T00:00:00Z"
              },
              "parameters": {
                "frequency_range": [
                  1.0,
                  10.0
                ],
                "magnitude_threshold": 2.0
              }
            },
            "response": {
              "status": "success",
              "results": {
                "event_count": 15,
                "magnitude_distribution": [
                  2.1,
                  2.3,
                  2.8,
                  3.1
                ],
                "depth_analysis": {
                  "mean_depth": 8.5,
                  "std_depth": 2.1
                }
              },
              "metadata": {
                "processing_time": 2.34,
                "model_version": "pinn-v1.2.0",
                "confidence": 0.87
              }
            }
          }
        ]
      }
    },
    "/simulate/physics": {
      "post": {
        "summary": "Physics Simulation",
        "description": "Run physics-informed simulations with geological constraints",
        "tags": [
          "Simulation",
          "Physics"
        ],
        "operationId": "post__simulate_physics",
        "parameters": [
          {
            "name": "X-Correlation-ID",
            "in": "header",
            "description": "Request correlation ID for tracking",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Simulation completed successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AnalysisResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid simulation parameters",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SimulationRequest"
              }
            }
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "x-examples": [
          {
            "name": "Thermal Simulation Example",
            "description": "Simulate thermal evolution of magma chamber",
            "request": {
              "simulation_type": "thermal",
              "initial_conditions": {
                "temperature": 1200.0,
                "pressure": 200000000.0,
                "composition": "basaltic"
              },
              "boundary_conditions": {
                "surface_temperature": 15.0,
                "heat_flux": 0.1
              },
              "time_span": 86400.0,
              "parameters": {
                "mesh_resolution": 100,
                "time_step": 60.0
              }
            },
            "response": {
              "status": "success",
              "results": {
                "final_temperature": 1150.0,
                "cooling_rate": 0.0005,
                "crystallization_fraction": 0.15
              },
              "metadata": {
                "simulation_time": 45.2,
                "convergence": true,
                "iterations": 1440
              }
            }
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "GeologicalAnalysisRequest": {
        "type": "object",
        "required": [
          "data_type",
          "spatial_extent"
        ],
        "properties": {
          "data_type": {
            "type": "string",
            "enum": [
              "seismic",
              "deformation",
              "geochemical",
              "thermal",
              "magnetic"
            ],
            "description": "Type of geological data to analyze"
          },
          "spatial_extent": {
            "type": "object",
            "properties": {
              "min_lat": {
                "type": "number",
                "minimum": -90,
                "maximum": 90
              },
              "max_lat": {
                "type": "number",
                "minimum": -90,
                "maximum": 90
              },
              "min_lon": {
                "type": "number",
                "minimum": -180,
                "maximum": 180
              },
              "max_lon": {
                "type": "number",
                "minimum": -180,
                "maximum": 180
              }
            },
            "required": [
              "min_lat",
              "max_lat",
              "min_lon",
              "max_lon"
            ]
          },
          "temporal_range": {
            "type": "object",
            "properties": {
              "start_time": {
                "type": "string",
                "format": "date-time"
              },
              "end_time": {
                "type": "string",
                "format": "date-time"
              }
            }
          },
          "parameters": {
            "type": "object",
            "additionalProperties": true,
            "description": "Analysis-specific parameters"
          }
        }
      },
      "AnalysisResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "success",
              "error",
              "processing"
            ]
          },
          "results": {
            "type": "object",
            "additionalProperties": true,
            "description": "Analysis results"
          },
          "metadata": {
            "type": "object",
            "properties": {
              "processing_time": {
                "type": "number"
              },
              "model_version": {
                "type": "string"
              },
              "confidence": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            }
          },
          "correlation_id": {
            "type": "string"
          }
        }
      },
      "SimulationRequest": {
        "type": "object",
        "required": [
          "simulation_type",
          "initial_conditions",
          "boundary_conditions",
          "time_span"
        ],
        "properties": {
          "simulation_type": {
            "type": "string",
            "enum": [
              "thermal",
              "mechanical",
              "electromagnetic",
              "coupled"
            ],
            "description": "Type of physics simulation"
          },
          "initial_conditions": {
            "type": "object",
            "additionalProperties": true,
            "description": "Initial conditions for simulation"
          },
          "boundary_conditions": {
            "type": "object",
            "additionalProperties": true,
            "description": "Boundary conditions for simulation"
          },
          "time_span": {
            "type": "number",
            "minimum": 0,
            "description": "Simulation time span in seconds"
          },
          "parameters": {
            "type": "object",
            "additionalProperties": true,
            "description": "Simulation parameters"
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          },
          "status_code": {
            "type": "integer"
          },
          "correlation_id": {
            "type": "string"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "JWT token for authentication"
      },
      "ApiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "X-API-Key",
        "description": "API key for service-to-service communication"
      }
    },
    "parameters": {
      "CorrelationId": {
        "name": "X-Correlation-ID",
        "in": "header",
        "description": "Request correlation ID for tracking",
        "schema": {
          "type": "string"
        },
        "example": "req-12345-abcde"
      }
    },
    "responses": {
      "UnauthorizedError": {
        "description": "Authentication information is missing or invalid",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "ForbiddenError": {
        "description": "Insufficient permissions",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      }
    }
  },
  "security": [
    {
      "BearerAuth": []
    }
  ],
  "tags": [
    {
      "name": "Health",
      "description": "Health check endpoints"
    },
    {
      "name": "Analysis",
      "description": "Data analysis endpoints"
    },
    {
      "name": "Simulation",
      "description": "Physics simulation endpoints"
    },
    {
      "name": "Monitoring",
      "description": "Real-time monitoring endpoints"
    },
    {
      "name": "Forecasting",
      "description": "Prediction and forecasting endpoints"
    }
  ]
}