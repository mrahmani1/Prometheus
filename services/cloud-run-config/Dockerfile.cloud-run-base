# Cloud Run Optimized Base Image for Python Services
# Optimized for fast cold starts and minimal resource usage

FROM python:3.11-slim as base

# Set environment variables for Cloud Run optimization
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PORT=8080

# Install minimal system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    libc6-dev \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

# Create non-root user for security
RUN useradd --create-home --shell /bin/bash --uid 1000 cloudrun

WORKDIR /app

# Copy and install Python dependencies first (for better caching)
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy application code
COPY . .

# Set ownership and permissions
RUN chown -R cloudrun:cloudrun /app
USER cloudrun

# Expose port
EXPOSE 8080

# Health check optimized for Cloud Run
HEALTHCHECK --interval=10s --timeout=5s --start-period=10s --retries=2 \
    CMD python -c "import requests; requests.get('http://localhost:8080/health', timeout=3)" || exit 1

# Default command (override in specific service Dockerfiles)
CMD ["python", "main.py"]