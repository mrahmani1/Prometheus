# Cloud Run Optimized Dockerfile for API Gateway
# Optimized for high concurrency and fast cold starts

FROM node:18-alpine as builder

WORKDIR /build

# Copy package files
COPY package*.json ./

# Install dependencies with optimizations
RUN npm ci --only=production --no-audit --no-fund && \
    npm cache clean --force

# Production stage
FROM node:18-alpine as production

# Cloud Run environment variables
ENV NODE_ENV=production \
    PORT=8080 \
    NODE_OPTIONS="--max-old-space-size=512" \
    UV_THREADPOOL_SIZE=4

# Install minimal runtime dependencies
RUN apk add --no-cache \
    dumb-init \
    curl \
    ca-certificates \
    && rm -rf /var/cache/apk/*

# Create non-root user
RUN addgroup -g 1000 -S gateway && \
    adduser -S gateway -u 1000 -G gateway

WORKDIR /app

# Copy dependencies from builder
COPY --from=builder --chown=gateway:gateway /build/node_modules ./node_modules

# Copy application code
COPY --chown=gateway:gateway . .

# Create necessary directories
RUN mkdir -p logs temp && \
    chown -R gateway:gateway logs temp

# Switch to non-root user
USER gateway

# Health check optimized for high-concurrency gateway
HEALTHCHECK --interval=10s --timeout=3s --start-period=5s --retries=2 \
    CMD curl -f http://localhost:8080/health || exit 1

EXPOSE 8080

# Use dumb-init for proper signal handling
ENTRYPOINT ["dumb-init", "--"]

# Start with optimizations for Cloud Run
CMD ["node", "--max-old-space-size=512", "main.js"]