# Cloud Run Optimized Dockerfile for Helios Core Service
# Optimized for AI/ML workloads with fast startup and efficient resource usage

FROM python:3.11-slim as builder

# Build dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    g++ \
    libpq-dev \
    pkg-config \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build

# Copy requirements and install dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir --user -r requirements.txt

# Production stage
FROM python:3.11-slim as production

# Cloud Run environment variables
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PORT=8080 \
    WORKERS=1 \
    TIMEOUT=300 \
    MAX_REQUESTS=1000 \
    MAX_REQUESTS_JITTER=100

# Install minimal runtime dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq5 \
    curl \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

# Create non-root user
RUN useradd --create-home --shell /bin/bash --uid 1000 helios

WORKDIR /app

# Copy Python packages from builder
COPY --from=builder /root/.local /home/helios/.local
ENV PATH=/home/helios/.local/bin:$PATH

# Copy application code
COPY --chown=helios:helios . .

# Create necessary directories
RUN mkdir -p /app/model_storage /app/logs /app/temp && \
    chown -R helios:helios /app

# Switch to non-root user
USER helios

# Optimize for Cloud Run startup
RUN python -c "import torch; import numpy; import scipy" || true

# Health check optimized for AI workloads
HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=2 \
    CMD curl -f http://localhost:8080/health || exit 1

EXPOSE 8080

# Use gunicorn for production with Cloud Run optimizations
CMD exec gunicorn \
    --bind 0.0.0.0:$PORT \
    --workers $WORKERS \
    --timeout $TIMEOUT \
    --max-requests $MAX_REQUESTS \
    --max-requests-jitter $MAX_REQUESTS_JITTER \
    --worker-class uvicorn.workers.UvicornWorker \
    --worker-tmp-dir /dev/shm \
    --preload \
    --access-logfile - \
    --error-logfile - \
    main:app