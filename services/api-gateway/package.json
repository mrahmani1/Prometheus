{
  "name": "prometheus-ai-api-gateway",
  "version": "1.0.0",
  "description": "External API Gateway for Prometheus AI Geodynamic Platform",
  "main": "main.js",
  "scripts": {
    "start": "node main.js",
    "dev": "nodemon main.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "security:audit": "npm audit",
    "security:check": "snyk test",
    "docs:generate": "swagger-jsdoc -d swaggerDef.js -o swagger.json api/**/*.js auth/**/*.js",
    "keys:generate": "node scripts/generate-keys.js",
    "keys:rotate": "node scripts/rotate-keys.js"
  },
  "keywords": [
    "api",
    "gateway",
    "geological",
    "geodynamic",
    "prometheus",
    "oauth2",
    "graphql",
    "rest"
  ],
  "author": "Prometheus AI Team",
  "license": "MIT",
  "dependencies": {
    "apollo-server-express": "^3.12.0",
    "bcrypt": "^5.1.0",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "express-rate-limit": "^6.7.0",
    "express-validator": "^6.15.0",
    "graphql": "^16.6.0",
    "helmet": "^6.1.5",
    "jsonwebtoken": "^9.0.0",
    "morgan": "^1.10.0",
    "rate-limit-redis": "^3.0.1",
    "redis": "^4.6.5",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^4.6.2",
    "winston": "^3.8.2"
  },
  "devDependencies": {
    "eslint": "^8.40.0",
    "eslint-config-standard": "^17.0.0",
    "eslint-plugin-import": "^2.27.5",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-promise": "^6.1.1",
    "jest": "^29.5.0",
    "nodemon": "^2.0.22",
    "snyk": "^1.1161.0",
    "supertest": "^6.3.3"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/prometheus-ai/geodynamic-platform.git"
  },
  "bugs": {
    "url": "https://github.com/prometheus-ai/geodynamic-platform/issues"
  },
  "homepage": "https://prometheus-ai.com"
}